---
import "../styles/global.css";
import "flag-icons/css/flag-icons.min.css"; // npm install flag-icons 필요

const { url } = Astro;
const currentPath = url.pathname;
const { currentCategory } = Astro.props;

// 메뉴의 "일정" 링크가 항상 오늘(KST) 날짜로 가도록 빌드 시점에 계산
// (사이트가 하루 2번 재빌드되니 대부분 실제 오늘 날짜와 일치합니다)
const nowKST = new Date(Date.now() + 9 * 60 * 60 * 1000);
const todaySchedulePath = `/schedule/${nowKST.toISOString().slice(0, 10)}`;
---

