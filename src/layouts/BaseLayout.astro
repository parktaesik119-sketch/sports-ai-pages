---
import "../styles/global.css";

const { url } = Astro;
const currentPath = url.pathname;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <!-- 🔥 기본 -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- 🔥 반응형 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 🔥 제목 -->
    <title>{Astro.props.title}</title>

    <!-- 🔥 SEO -->
    <meta name="description" content={Astro.props.description ?? "스포츠 분석 및 추천픽 제공"} />
    <meta name="keywords" content="스포츠 분석, 축구 분석, 야구 분석, 농구 픽, 토토 추천" />

    <!-- 🔥 canonical (중요!!) -->
    <link rel="canonical" href={Astro.url} />

    <!-- 🔥 Open Graph -->
    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:description" content={Astro.props.description ?? "스포츠 분석 사이트"} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url} />

    <!-- 🔥 썸네일 (없으면 기본 이미지 넣어도 됨) -->
    <meta property="og:image" content="/og-default.jpg" />

    <!-- 🔥 트위터 -->
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <header class="header">
      <div class="header-container">

        <!-- 🔥 로고 -->
        <a href="/" class="logo">
          <span class="logo-main">픽천국</span>
          <span class="logo-sub">PICK HEAVEN</span>
        </a>

        <!-- 🔥 메뉴 -->
        <nav class="nav">
          <!-- 공지 -->
          <a href="/notice" class={currentPath.startsWith('/notice') ? "active" : ""}>공지사항</a>

         <!-- 카테고리 -->
          <a href="/posts/soccer" class={currentPath.includes("soccer") ? "active" : ""}>축구</a>
          <a href="/posts/baseball" class={currentPath.includes("baseball") ? "active" : ""}>야구</a>
          <a href="/posts/basketball" class={currentPath.includes("basketball") ? "active" : ""}>농구</a>
          <a href="/posts/volleyball" class={currentPath.includes("volleyball") ? "active" : ""}>배구</a>
          <a href="/posts/hockey" class={currentPath.includes("hockey") ? "active" : ""}>하키</a>
          <a href="/posts/lol" class={currentPath.includes("lol") ? "active" : ""}>LoL</a>
        </nav>

      </div>
    </header>

    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style>
.header {
  background: #ffffff;
  border-bottom: 1px solid #eaecef;
}

.header-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 14px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 🔥 로고 */
.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  line-height: 1;
  position: relative;
}

/* 🔥 메인 로고 */
.logo-main {
  font-family: 'A2z', sans-serif;
  font-size: 28px;
  font-weight: 800;
  color: #3b82f6;
  letter-spacing: 1px;
  position: relative;
}

/* 🔥 왼쪽 날개 */
.logo-main::before {
  content: "🪽";
  position: absolute;
  left: -32px;
  top: 2px;
  font-size: 25px;  
  transform: scaleX(-1);
  opacity: 0.9;
  animation: wing-right 1.2s infinite ease-in-out;
}

/* 🔥 오른쪽 날개 */
.logo-main::after {
  content: "🪽";
  position: absolute;
  right: -32px;
  top: 2px;
  font-size: 25px;
  opacity: 0.9;
  animation: wing-left 1.2s infinite ease-in-out;
}

@keyframes wing-left {
  0%, 100% {
    transform: translateY(0) rotate(-5deg);
  }
  50% {
    transform: translateY(-3px) rotate(-15deg);
  }
}

@keyframes wing-right {
  0%, 100% {
    transform: scaleX(-1) translateY(0) rotate(-5deg);
  }
  50% {
    transform: scaleX(-1) translateY(-3px) rotate(-15deg);
  }
}

/* 🔥 서브 텍스트 */
.logo-sub {
  font-size: 11px;
  color: #888;
  margin-top: 3px;
  letter-spacing: 2px;
}

/* 🔥 hover */
.logo:hover .logo-main {
  transform: scale(1.05);
  transition: 0.2s;
}

/* 🔥 메뉴 */
.nav {
  display: flex;
  gap: 20px;
}

.nav a {
  text-decoration: none;
  font-size: 15px;
  color: #333;
  font-weight: 500;
  position: relative;
}

.nav a:hover {
  color: #3b82f6;
}

.nav a.active {
  color: #3b82f6;
  font-weight: 700;
}

.nav a.active::after {
  content: "";
  position: absolute;
  bottom: -6px;
  left: 0;
  width: 100%;
  height: 2px;
  background: #3b82f6;
}

/* 🔥 메인 */
.container {
  max-width: 1200px;
  margin: 10px auto;
  padding: 0 20px;
}
</style>