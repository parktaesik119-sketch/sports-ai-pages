</div>
    </header>

    <main class="container">
     <div class="main-content">
      <slot />
    </div>
    </main>

    
    <!-- 🔥 JS 위치 중요 (body 맨 아래) -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // 페이지 이동 시 스피너 표시
  document.querySelectorAll('a[href]').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      const opensNewTab = link.target === '_blank';
      if (href && !opensNewTab && !href.startsWith('#') && !href.startsWith('javascript') && !e.ctrlKey && !e.metaKey) {
        const spinner = document.getElementById('ph-spinner');
        if (spinner) { spinner.style.opacity = '1'; spinner.style.visibility = 'visible'; spinner.style.pointerEvents = 'auto'; }
      }
    });
  });

  // 뒤로가기/앞으로가기 시 스피너 숨김
  window.addEventListener('pageshow', (e) => {
    const spinner = document.getElementById('ph-spinner');
    if (spinner) { spinner.style.opacity = '0'; spinner.style.visibility = 'hidden'; spinner.style.pointerEvents = 'none'; }
  });

  const menuBtn = document.getElementById('menu-btn');
  const closeBtn = document.getElementById('close-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('menu-overlay');

  if (!menuBtn || !closeBtn || !mobileMenu || !overlay) return;

  // 열기
  menuBtn.addEventListener('click', () => {
    overlay.classList.add('open');
  });

  // 닫기 버튼
  closeBtn.addEventListener('click', () => {
    overlay.classList.remove('open');
  });

  // 🔥 배경 클릭하면 닫힘
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) {
      overlay.classList.remove('open');
    }
  });
});
</script>

<style is:global>
  /* 페이지 이동 로딩 스피너 (순수 CSS, display 전환에 영향 안 받음) */
  .ph-ring-loader-wrap {
    position: relative;
    width: 128px;
    height: 128px;
  }
  .ph-ring-loader {
    position: absolute;
    inset: 0;
    padding: 18px;
    border-radius: 50%;
    background: #5B8DEF;
    --_m:
      conic-gradient(#0000 10%, #000),
      linear-gradient(#000 0 0) content-box;
    -webkit-mask: var(--_m);
            mask: var(--_m);
    -webkit-mask-composite: source-out;
            mask-composite: subtract;
    animation: ph-ring-spin 1s infinite linear;
  }
  .ph-ring-loader-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: Georgia, serif;
    font-weight: 700;
    font-size: 36px;
    color: #5B8DEF;
  }
  @keyframes ph-ring-spin {
    to { transform: rotate(1turn); }
  }

  /* 전체 텍스트 또렷하게 (4번 해결) */
  body {
    color: #1a1a1a !important; /* 더 진한 블랙 */
    line-height: 1.8;
    font-family: 'Pretendard', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* 본문 텍스트(p) 강조 */
  p, li, td {
    color: #2d2d2d;
    font-weight: 400;
  }

  /* 섹션 타이틀 굵게 및 간격 (3번 해결) */
  h3 {
    font-size: 1.4rem;
    font-weight: 800 !important;
    color: #000;
    margin: 3rem 0 1.2rem 0 !important;
    display: block;
  }

  /* 표 디자인 */
  table {
    width: 100%;
    max-width: 800px;
    margin: 1.5rem auto;
    border-collapse: collapse;
    background-color: #fff;
    border: 1px solid #ddd;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
  }

  table thead { display: none; } /* 헤더 숨기기 */

  td {
    border: 1px solid #eee;
    padding: 16px;
    text-align: center;
    vertical-align: middle;
  }

  /* 첫 번째 열 파란색 강조 */
  table tr td:first-child {
    color: #007bff !important;
    font-weight: 700 !important;
    background-color: #fcfdfe;
    width: 25%;
    text-align: center !important;
  }

  /* 🔝 맨 위로 버튼 */
#scrollTopBtn {
  position: fixed;
  right: 18px;
  bottom: 84px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 4px 4px 18px;
  border: none;
  border-radius: 999px;
  background: #fff;
  cursor: pointer;
  z-index: 9999;

  opacity: 0;
  transform: translateY(12px);
  pointer-events: none;
  transition: opacity 0.25s ease, transform 0.25s ease, box-shadow 0.2s ease;

  box-shadow: 0 4px 14px rgba(0,0,0,0.18);
}

.scroll-top-label {
  font-size: 14px;
  font-weight: 700;
  color: #212529;
  white-space: nowrap;
}

.scroll-top-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff922b 0%, #e8590c 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 표시 상태 */
#scrollTopBtn.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

#scrollTopBtn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0,0,0,0.24);
}

#scrollTopBtn:active {
  transform: scale(0.96);
}
</style>

<!-- 🔝 맨 위로 버튼 -->
<button id="scrollTopBtn" aria-label="맨 위로 이동">
  <span class="scroll-top-label">맨위로</span>
  <span class="scroll-top-icon">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </span>
</button>

<script>
  const scrollTopBtn = document.getElementById('scrollTopBtn');

  // 스크롤 시 버튼 표시
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      scrollTopBtn.classList.add('show');
    } else {
      scrollTopBtn.classList.remove('show');
    }
  });

  // 클릭 시 맨 위 이동
  scrollTopBtn.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>

  </body>
</html>

<style>
.header {
  background: #ffffff;
  border-bottom: 1px solid #eaecef;
}

.header-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 14px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 🔥 로고 */
.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  line-height: 1;
  position: relative;
}

/* 🔥 메인 로고 */
.logo-main {
  font-family: 'A2z', sans-serif;
  font-size: 28px;
  font-weight: 800;
  color: #1252b9;
  letter-spacing: 1px;
  position: relative;
}

/* 🔥 왼쪽 날개 */
.logo-main::before {
  content: "";
  position: absolute;
  left: -45px;
  top: 2px;

  width: 34px;
  height: 34px;

  background-image: url('/icons/wing4.png');
  background-size: contain;
  background-repeat: no-repeat;

  transform-origin: right center;

  animation: wing-left 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;

  opacity: 0.95;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.25));
}

/* 🔥 오른쪽 날개 (진짜 반전 적용) */
.logo-main::after {
  content: "";
  position: absolute;
  right: -29px;
  top: 2px;

  width: 34px;
  height: 34px;

  background-image: url('/icons/wing4.png');
  background-size: contain;
  background-repeat: no-repeat;

  transform-origin: 70% center;

  animation: wing-right 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;

  opacity: 0.95;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.25));
}

/* 🔥 왼쪽 날개 */
@keyframes wing-left {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  25% {
    transform: rotate(-14deg) translateY(-4px);
  }
  50% {
    transform: rotate(-0deg) translateY(-1px);
  }
  75% {
    transform: rotate(-7deg) translateY(-3px);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

/* 🔥 오른쪽 날개 (scaleX(-1) 반드시 포함!) */
@keyframes wing-right {
  0% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
  25% {
    transform: scaleX(-1) rotate(-14deg) translateY(-4px);
  }
  50% {
    transform: scaleX(-1) rotate(-0deg) translateY(-1px);
  }
  75% {
    transform: scaleX(-1) rotate(-7deg) translateY(-3px);
  }
  100% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
}

/* 🔥 hover 시 더 크게 펄럭 */
.logo:hover .logo-main::before {
  animation: wing-left-hover 0.9s ease-in-out infinite;
}

.logo:hover .logo-main::after {
  animation: wing-right-hover 0.9s ease-in-out infinite;
}

/* 🔥 hover - 왼쪽 */
@keyframes wing-left-hover {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  50% {
    transform: rotate(-22deg) translateY(-8px);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

/* 🔥 hover - 오른쪽 */
@keyframes wing-right-hover {
  0% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
  50% {
    transform: scaleX(-1) rotate(-22deg) translateY(-8px);
  }
  100% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
}

/* 🔥 서브 텍스트 */
