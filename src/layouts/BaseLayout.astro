---
import "../styles/global.css";

const { url } = Astro;
const currentPath = url.pathname;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <!-- 🔥 기본 -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- 🔥 반응형 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 🔥 제목 -->
    <title>{Astro.props.title}</title>

    <!-- 🔥 SEO -->
    <meta name="description" content={Astro.props.description ?? "스포츠 분석 및 추천픽 제공"} />
    <meta name="keywords" content="스포츠 분석, 축구 분석, 야구 분석, 농구 픽, 토토 추천" />

    <!-- 🔥 canonical (중요!!) -->
    <link rel="canonical" href={Astro.url} />

    <!-- 🔥 Open Graph -->
    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:description" content={Astro.props.description ?? "스포츠 분석 사이트"} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url} />

    <!-- 🔥 썸네일 (없으면 기본 이미지 넣어도 됨) -->
    <meta property="og:image" content="/og-default.jpg" />

    <!-- 🔥 트위터 -->
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
<header class="header">
  <div class="header-container">

    <!-- 🔥 로고 -->
    <a href="/" class="logo">
      <span class="logo-main">픽천국</span>
      <span class="logo-sub">PICK HEAVEN</span>
    </a>

    <!-- 🔥 PC 메뉴 -->
    <nav class="nav">
      <a href="/notice" class={currentPath.startsWith('/notice') ? "active" : ""}>공지사항</a>
      <a href="/posts/soccer" class={currentPath.includes("soccer") ? "active" : ""}>축구</a>
      <a href="/posts/baseball" class={currentPath.includes("baseball") ? "active" : ""}>야구</a>
      <a href="/posts/basketball" class={currentPath.includes("basketball") ? "active" : ""}>농구</a>
      <a href="/posts/volleyball" class={currentPath.includes("volleyball") ? "active" : ""}>배구</a>
      <a href="/posts/hockey" class={currentPath.includes("hockey") ? "active" : ""}>하키</a>
      <a href="/posts/lol" class={currentPath.includes("lol") ? "active" : ""}>LoL</a>
    </nav>

    <!-- 🔥 햄버거 -->
    <button class="menu-btn" id="menuBtn">☰</button>

  </div>

    <!-- 🔥 추가: 오버레이 -->
  <div class="menu-overlay" id="menuOverlay"></div>

  <!-- 🔥 모바일 메뉴 -->
  <div class="mobile-menu" id="mobileMenu">
    <button class="close-btn" id="closeBtn">✕</button>

    <a href="/notice">공지사항</a>
    <a href="/posts/soccer">축구</a>
    <a href="/posts/baseball">야구</a>
    <a href="/posts/basketball">농구</a>
    <a href="/posts/volleyball">배구</a>
    <a href="/posts/hockey">하키</a>
    <a href="/posts/lol">LoL</a>
  </div>

  <!-- 🔥 스크립트 -->
  <script is:inline>
  window.addEventListener("load", () => {
    const menuBtn = document.getElementById("menuBtn");
    const closeBtn = document.getElementById("closeBtn");
    const mobileMenu = document.getElementById("mobileMenu");

    if (!menuBtn || !mobileMenu) return;

    menuBtn.onclick = () => {
      mobileMenu.classList.add("open");
    };

    if (closeBtn) {
      closeBtn.onclick = () => {
        mobileMenu.classList.remove("open");
      };
    }
  });
</script>
</header>

    <main class="container">
      <slot />
    </main>
  </body>
</html>

<style>
.header {
  background: #ffffff;
  border-bottom: 1px solid #eaecef;
}

.header-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 14px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 🔥 로고 */
.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  line-height: 1;
  position: relative;
}

/* 🔥 메인 로고 */
.logo-main {
  font-family: 'A2z', sans-serif;
  font-size: 28px;
  font-weight: 800;
  color: #3b82f6;
  letter-spacing: 1px;
  position: relative;
}

/* 🔥 왼쪽 날개 */
.logo-main::before {
  content: "";
  position: absolute;
  left: -45px;
  top: 2px;

  width: 34px;
  height: 34px;

  background-image: url('/icons/wing4.png');
  background-size: contain;
  background-repeat: no-repeat;

  transform-origin: right center;

  animation: wing-left 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;

  opacity: 0.95;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.25));
}

/* 🔥 오른쪽 날개 (진짜 반전 적용) */
.logo-main::after {
  content: "";
  position: absolute;
  right: -31px;
  top: 2px;

  width: 34px;
  height: 34px;

  background-image: url('/icons/wing4.png');
  background-size: contain;
  background-repeat: no-repeat;

  transform-origin: 70% center;

  animation: wing-right 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;

  opacity: 0.95;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.25));
}

/* 🔥 왼쪽 날개 */
@keyframes wing-left {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  25% {
    transform: rotate(-14deg) translateY(-4px);
  }
  50% {
    transform: rotate(-6deg) translateY(-6px);
  }
  75% {
    transform: rotate(-12deg) translateY(-3px);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

/* 🔥 오른쪽 날개 (scaleX(-1) 반드시 포함!) */
@keyframes wing-right {
  0% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
  25% {
    transform: scaleX(-1) rotate(-14deg) translateY(-4px);
  }
  50% {
    transform: scaleX(-1) rotate(-6deg) translateY(-6px);
  }
  75% {
    transform: scaleX(-1) rotate(-12deg) translateY(-3px);
  }
  100% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
}

/* 🔥 hover 시 더 크게 펄럭 */
.logo:hover .logo-main::before {
  animation: wing-left-hover 0.9s ease-in-out infinite;
}

.logo:hover .logo-main::after {
  animation: wing-right-hover 0.9s ease-in-out infinite;
}

/* 🔥 hover - 왼쪽 */
@keyframes wing-left-hover {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  50% {
    transform: rotate(-22deg) translateY(-8px);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

/* 🔥 hover - 오른쪽 */
@keyframes wing-right-hover {
  0% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
  50% {
    transform: scaleX(-1) rotate(-22deg) translateY(-8px);
  }
  100% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
}

/* 🔥 서브 텍스트 */
.logo-sub {
  font-size: 11px;
  color: #888;
  margin-top: 3px;
  letter-spacing: 2px;
}

/* 🔥 hover */
.logo:hover .logo-main {
  transform: scale(1.05);
  transition: 0.2s;
}

/* 🔥 메뉴 */
.nav {
  display: flex;
  gap: 20px;
}

.nav a {
  text-decoration: none;
  font-size: 15px;
  color: #333;
  font-weight: 500;
  position: relative;
}

.nav a:hover {
  color: #3b82f6;
}

.nav a.active {
  color: #3b82f6;
  font-weight: 700;
}

.nav a.active::after {
  content: "";
  position: absolute;
  bottom: -6px;
  left: 0;
  width: 100%;
  height: 2px;
  background: #3b82f6;
}

/* 🔥 메인 */
.container {
  max-width: 1200px;
  margin: 10px auto;
  padding: 0 20px;
}

/* =========================
   📱 모바일 헤더 개선
========================= */
@media (max-width: 768px) {

  /* 로고 중앙 */
  .logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  /* 햄버거는 오른쪽 */
  .menu-btn {
    position: absolute;
    right: 20px;
  }

  /* 헤더 컨테이너 기준점 */
  .header-container {
    position: relative;
  }

}
</style>