---
import "../styles/global.css";

const { url } = Astro;
const currentPath = url.pathname;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{Astro.props.title}</title>

    <meta name="description" content={Astro.props.description ?? "스포츠 분석 및 추천픽 제공"} />
    <meta name="keywords" content="스포츠 분석, 축구 분석, 야구 분석, 농구 픽, 토토 추천" />

    <link rel="canonical" href={Astro.url} />

    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:description" content={Astro.props.description ?? "픽천국-무료 스포츠픽 분석 사이트"} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="/og-default.jpg" />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="referrer" content="no-referrer" />

    <script type="application/ld+json">
    {JSON.stringify(Astro.props.structuredData)}
    </script>

  </head>

  <body>

   <!-- 🔥 인트로 로고 -->
  <div id="intro">
    <div class="intro-logo">
    <span class="logo-main">픽천국</span>
    <span class="logo-sub">PICK HEAVEN</span>
    </div>
  </div>

    <header class="header">
      <div class="header-container">

        <!-- 🔥 로고 (기존 그대로 유지) -->
        <a href="/" class="logo">
          <span class="logo-main">픽천국</span>
          <span class="logo-sub">PICK HEAVEN</span>
        </a>

        <!-- 🔥 PC 메뉴 (그대로 유지) -->
        <nav class="nav">
          <a href="/notice" class={currentPath.startsWith('/notice') ? "active" : ""}>공지사항</a>
          <a href="/posts/soccer" class={currentPath.includes("soccer") ? "active" : ""}>축구</a>
          <a href="/posts/baseball" class={currentPath.includes("baseball") ? "active" : ""}>야구</a>
          <a href="/posts/basketball" class={currentPath.includes("basketball") ? "active" : ""}>농구</a>
          <a href="/posts/volleyball" class={currentPath.includes("volleyball") ? "active" : ""}>배구</a>
          <a href="/posts/hockey" class={currentPath.includes("hockey") ? "active" : ""}>하키</a>
          <a href="/posts/lol" class={currentPath.includes("lol") ? "active" : ""}>LoL</a>
        </nav>

        <!-- 🔥 햄버거 버튼 (추가) -->
        <button class="menu-btn" id="menu-btn">☰</button>

      </div>

<!-- 🔥 모바일 메뉴 + 배경 -->
<div class="menu-overlay" id="menu-overlay">
  <div class="mobile-menu" id="mobile-menu">
    <button class="close-btn" id="close-btn">✕</button>

    <a href="/notice" class={`menu notice ${currentPath.includes('/notice') ? 'active' : ''}`}>공지사항</a>
    <a href="/posts/soccer" class={`menu soccer ${currentPath.includes('/soccer') ? 'active' : ''}`}>축구분석</a>
  <a href="/posts/baseball" class={`menu baseball ${currentPath.includes('/baseball') ? 'active' : ''}`}>야구분석</a>
<a href="/posts/basketball" class={`menu basketball ${currentPath.includes('/basketball') ? 'active' : ''}`}>농구분석</a>
<a href="/posts/volleyball" class={`menu volleyball ${currentPath.includes('/volleyball') ? 'active' : ''}`}>배구분석</a>
<a href="/posts/hockey" class={`menu hockey ${currentPath.includes('/hockey') ? 'active' : ''}`}>하키분석</a>
<a href="/posts/lol" class={`menu lol ${currentPath.includes('/lol') ? 'active' : ''}`}>LoL분석</a>
  </div>
</div>
    </header>

    <main class="container">
      <slot />
    </main>

    <!-- 🔥 JS 위치 중요 (body 맨 아래) -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const menuBtn = document.getElementById('menu-btn');
  const closeBtn = document.getElementById('close-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('menu-overlay');

  const intro = document.getElementById("intro");
  const introLogo = document.querySelector(".intro-logo");
  const headerLogo = document.querySelector(".logo");

  if (!menuBtn || !closeBtn || !mobileMenu || !overlay) return;

  // 닫기 버튼
  closeBtn.addEventListener('click', () => {
    overlay.classList.remove('open');
  });

  // 배경 클릭
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) {
      overlay.classList.remove('open');
    }
  });

  // =========================
  // 🔥 인트로 애니메이션 (최종 완성형)
  // =========================
  if (introLogo && headerLogo) {

    // 🔥 모바일 위치 튐 방지 핵심
    introLogo.getBoundingClientRect();

    const introRect = introLogo.getBoundingClientRect();
    const headerRect = headerLogo.getBoundingClientRect();

    // 🔥 "중앙 기준" 계산 (이게 핵심이다)
    const introCenterX = introRect.left + introRect.width / 2;
    const introCenterY = introRect.top + introRect.height / 2;

    const headerCenterX = headerRect.left + headerRect.width / 2;
    const headerCenterY = headerRect.top + headerRect.height / 2;

    const deltaX = headerCenterX - introCenterX;
    const deltaY = headerCenterY - introCenterY;

    introLogo.style.setProperty("--target-x", `${deltaX}px`);
    introLogo.style.setProperty("--target-y", `${deltaY}px`);

    // 이동 시작
    setTimeout(() => {
      introLogo.classList.add("move");
      introLogo.classList.add("shine");
    }, 250);

    // 🔥 도착 순간 빛 퍼짐
    setTimeout(() => {
    introLogo.classList.add("flash");
    }, 900);

    // 🔥 종료
    setTimeout(() => {
    introLogo.classList.add("hide");
    if (intro) intro.style.display = "none";
    }, 1400);
    }

});

</script>

<style is:global>
  /* 전체 텍스트 또렷하게 (4번 해결) */
  body {
    color: #1a1a1a !important; /* 더 진한 블랙 */
    line-height: 1.8;
    font-family: 'Pretendard', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* 본문 텍스트(p) 강조 */
  p, li, td {
    color: #2d2d2d;
    font-weight: 400;
  }

  /* 섹션 타이틀 굵게 및 간격 (3번 해결) */
  h3 {
    font-size: 1.4rem;
    font-weight: 800 !important;
    color: #000;
    margin: 3rem 0 1.2rem 0 !important;
    display: block;
  }

  /* 표 디자인 */
  table {
    width: 100%;
    max-width: 800px;
    margin: 1.5rem auto;
    border-collapse: collapse;
    background-color: #fff;
    border: 1px solid #ddd;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
  }

  table thead { display: none; } /* 헤더 숨기기 */

  td {
    border: 1px solid #eee;
    padding: 16px;
    text-align: center;
  }

  /* 첫 번째 열 파란색 강조 */
  table tr td:first-child {
    color: #007bff !important;
    font-weight: 700 !important;
    background-color: #fcfdfe;
    width: 25%;
  }
</style>

  </body>
</html>

<style>
.header {
  background: #ffffff;
  border-bottom: 1px solid #eaecef;
}

.header-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 14px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 🔥 로고 */
.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  line-height: 1;
  position: relative;
}

/* 🔥 메인 로고 */
.logo-main {
  font-family: 'A2z', sans-serif;
  font-size: 28px;
  font-weight: 800;
  color: #1d61cf;
  letter-spacing: 1px;
  position: relative;

  animation: neonGlow 2s ease-in-out infinite alternate;
}

/* 인트로는 따로 */
.intro-logo .logo-main {
  animation: neonPulse 2s ease-in-out infinite;
}

/* 🔥 왼쪽 날개 */
.logo-main::before {
  content: "";
  position: absolute;
  left: -45px;
  top: 2px;

  width: 34px;
  height: 34px;

  background-image: url('/icons/wing4.png');
  background-size: contain;
  background-repeat: no-repeat;

  transform-origin: right center;

  animation: 
  wing-left 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite,
  wing-glow 2.2s ease-in-out infinite;

  opacity: 0.95;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.25));
}

/* 🔥 오른쪽 날개 (진짜 반전 적용) */
.logo-main::after {
  content: "";
  position: absolute;
  right: -29px;
  top: 2px;

  width: 34px;
  height: 34px;

  background-image: url('/icons/wing4.png');
  background-size: contain;
  background-repeat: no-repeat;

  transform-origin: 70% center;

  animation: 
  wing-right 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite,
  wing-glow 2.2s ease-in-out infinite;

  opacity: 0.95;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.25));
}

/* 🔥 왼쪽 날개 */
@keyframes wing-left {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  25% {
    transform: rotate(-14deg) translateY(-4px);
  }
  50% {
    transform: rotate(-0deg) translateY(-1px);
  }
  75% {
    transform: rotate(-7deg) translateY(-3px);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

/* 🔥 glow는 그대로 유지 */
@keyframes wing-glow {
  0%, 100% {
    filter: drop-shadow(0 0 4px rgba(255, 220, 120, 0.2));
  }
  50% {
    filter: drop-shadow(0 0 10px rgba(255, 220, 120, 0.6));
  }
}

/* 🔥 오른쪽 날개 (scaleX(-1) 반드시 포함!) */
@keyframes wing-right {
  0% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
  25% {
    transform: scaleX(-1) rotate(-14deg) translateY(-4px);
  }
  50% {
    transform: scaleX(-1) rotate(-0deg) translateY(-1px);
  }
  75% {
    transform: scaleX(-1) rotate(-7deg) translateY(-3px);
  }
  100% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
}


/* 🔥 hover 시 더 크게 펄럭 */
.logo:hover .logo-main::before {
  animation: wing-left-hover 0.9s ease-in-out infinite;
}

.logo:hover .logo-main::after {
  animation: wing-right-hover 0.9s ease-in-out infinite;
}

/* 🔥 hover - 왼쪽 */
@keyframes wing-left-hover {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  50% {
    transform: rotate(-22deg) translateY(-8px);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

/* 🔥 hover - 오른쪽 */
@keyframes wing-right-hover {
  0% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
  50% {
    transform: scaleX(-1) rotate(-22deg) translateY(-8px);
  }
  100% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
}

/* 🔥 서브 텍스트 */
.logo-sub {
  font-size: 11px;
  color: #888;
  margin-top: 4px;
  letter-spacing: 2px;

  display: block;
  width: 100%;
  text-align: center;
  line-height: 1;
}

.intro-logo .logo-main {
  line-height: 1.05;
}

/* 🔥 hover */
.logo:hover .logo-main {
  transform: scale(1.05);
  transition: 0.2s;
}

@keyframes neonGlow {
  0% {
    text-shadow:
      0 0 1px #fff8c2,
      0 0 6px rgba(255, 236, 140, 0.8),
      0 0 12px rgba(255, 214, 90, 0.4);
  }
  100% {
    text-shadow:
      0 0 2px #fff2a8,
      0 0 8px rgba(255, 232, 120, 1),
      0 0 16px rgba(255, 210, 70, 0.6);
  }
}

@keyframes neonPulse {
  0% {
    transform: scale(1);
    text-shadow:
      0 0 2px #fff6b0,
      0 0 8px rgba(255, 232, 120, 0.8);
  }
  50% {
    transform: scale(1.05);
    text-shadow:
      0 0 3px #fff8c2,
      0 0 12px rgba(255, 220, 90, 1);
  }
  100% {
    transform: scale(1);
    text-shadow:
      0 0 2px #fff6b0,
      0 0 8px rgba(255, 232, 120, 0.8);
  }
}

/* 🔥 메뉴 */
.nav {
  display: flex;
  gap: 30px;
}

.nav a {
  text-decoration: none;
  font-size: 17px;
  color: #333;
  font-weight: 500;
  position: relative;
}

.nav a:hover {
  color: #3b82f6;
}

.nav a.active {
  color: #3b82f6;
  font-weight: 700;
}

.nav a.active::after {
  content: "";
  position: absolute;
  bottom: -6px;
  left: 0;
  width: 100%;
  height: 2px;
  background: #3b82f6;
}

/* 🔥 메인 */
.container {
  max-width: 1200px;
  margin: 5px auto;
  padding: 0 20px;
}

/* =========================
   📱 모바일 헤더 개선
========================= */
@media (max-width: 768px) {

  /* 로고 중앙 */
  .logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  /* 햄버거는 오른쪽 */
  .menu-btn {
    position: absolute;
    right: 20px;
  }

  /* 헤더 컨테이너 기준점 */
  .header-container {
    position: relative;
  }

}

.board {
    background: #fff;
    border-radius: 10px;
    margin-bottom: 10px !important; /* 게시판 사이의 아래 여백을 20px -> 10px로 줄임 */
    
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  /* 🔴 게시판 헤더의 위아래 뚱뚱한 여백도 줄이고 싶다면 이 부분을 수정하세요 */
  .board-header {
    padding: 10px 15px !important; /* 기존보다 위아래를 더 홀쭉하게 만듭니다 */
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

 /* 🔥 인트로 전체 화면 */
#intro {
  position: fixed;
  inset: 0;
  background: #ffffff;
  z-index: 9999;

  display: flex;
  align-items: center;
  justify-content: center;
}

.intro-text {
  font-size: 60px;
  font-weight: 900;
  color: #1d61cf;

  text-shadow:
    0 0 10px #3b82f6,
    0 0 20px #3b82f6,
    0 0 40px #60a5fa;
}

#intro.hide {
  opacity: 0;
  pointer-events: none;
}

/* 🔥 인트로 시작 위치 (중앙) */
.intro-logo {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 10000;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
  gap: 2px;

  transform: translate(-50%, -50%) scale(3);

  transition:
    transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.4s ease;

  will-change: transform, opacity;

  overflow: visible; /* 🔥 여기로 합침 */
}

.intro-logo::before {
  content: "";
  position: absolute;
  top: 0;
  left: -120%;
  width: 60%;
  height: 100%;

  background: linear-gradient(
    120deg,
    transparent,
    rgba(255, 245, 170, 0.6),
    transparent
  );

  transform: skewX(-20deg);
  pointer-events: none;
}

.intro-logo.shine::before {
  animation: shineMove 0.9s ease-out;
}

@keyframes shineMove {
  0% { left: -120%; }
  100% { left: 120%; }
}

/* 🔥 픽천국 / PICK HEAVEN 세로 중앙 정렬 */
.intro-logo .logo-main,
.intro-logo .logo-sub {
  display: block;
  width: 100%;
  text-align: center;
}

/* 🔥 도착 시 빛 퍼짐 효과 */
.intro-logo::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;

  width: 20px;
  height: 20px;

  background: radial-gradient(circle, rgba(59,130,246,0.8) 0%, rgba(59,130,246,0.4) 40%, transparent 70%);
  border-radius: 50%;

  transform: translate(-50%, -50%) scale(0);
  opacity: 0;

  pointer-events: none;
}

/* 🔥 터지는 순간 */
.intro-logo.flash::after {
  animation: flashSpread 0.8s ease-out forwards;
}

/* 🔥 확산 애니메이션 */
@keyframes flashSpread {
  0% {
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0.8;
  }
  50% {
    transform: translate(-50%, -50%) scale(3);
    opacity: 0.5;
  }
  100% {
    transform: translate(-50%, -50%) scale(6);
    opacity: 0;
  }
}

/* 🔥 이동 상태 */
.intro-logo.move {
  transform:
    translate(var(--target-x), var(--target-y))
    scale(1)
    rotate(0deg); /* 🔥 이동하면서 기울어짐 */
}

/* 🔥 사라짐 */
.intro-logo.hide {
  opacity: 0;
}

/* 🔥 인트로에서도 날개 보이게 강제 */
.intro-logo .logo-main::before,
.intro-logo .logo-main::after {
  opacity: 1 !important;
  visibility: visible !important;
  display: block !important;
}

</style>