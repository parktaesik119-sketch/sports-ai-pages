    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-W9QF2SQ5');
    </script>

    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/images/favicon2.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />

    <title>{Astro.props.title ?? "픽천국 | 데이터기반 정밀한 스포츠분석 및 스포츠픽 정보"}</title>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "픽천국",
      "url": "https://pick79.com/"
    }
    </script>

    <meta name="description" content={Astro.props.description ?? "픽천국 | 데이터기반 정밀한 스포츠분석 및 스포츠픽 정보"} />
    <meta name="keywords" content="픽천국, 무료스포츠분석, 무료스포츠픽, 축구경기분석, 야구경기분석, 농구경기분석, 롤분석" />

    <link rel="canonical" href={Astro.url} />

    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:description" content={Astro.props.description ?? "365일 매일 무료로 만나는 데이터 기반의 정밀한 스포츠 분석 서비스. 축구,야구,농구,배구,하키,LOL 프리뷰, 추천픽 제공."} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="https://i.imgur.com/GgcZzZo.png" />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="referrer" content="no-referrer" />

    {Astro.props.noindex && (
  <meta name="robots" content="noindex, follow" />
  )}
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W9QF2SQ5"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- 페이지 이동 로딩 스피너 -->
    <div id="ph-spinner" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.85); z-index:99999; flex-direction:column; align-items:center; justify-content:center;">
      <svg width="80" height="80" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="50" r="48" fill="#5B8DEF"/>
        <text x="50" y="50" text-anchor="middle" dominant-baseline="central"
          font-family="Georgia, serif" font-size="42" font-weight="700" fill="white">PH</text>
        <circle cx="50" cy="50" r="46" fill="none" stroke="white" stroke-width="3"
          stroke-dasharray="215" stroke-dashoffset="54" stroke-linecap="round">
          <animateTransform attributeName="transform" type="rotate"
            from="0 50 50" to="360 50 50" dur="1.2s" repeatCount="indefinite"/>
        </circle>
      </svg>
      <p style="margin-top:12px; font-size:14px; color:#5B8DEF; font-family:sans-serif;">데이터 불러오는 중...</p>
    </div>

    <header class="header">
      <div class="header-container">

        <!-- 🔥 로고 (기존 그대로 유지) -->
        <a href="/" class="logo">
          <span class="logo-main">픽천국</span>
          <span class="logo-sub">PICK HEAVEN</span>
        </a>

        <!-- 🔥 PC 메뉴 (그대로 유지) -->
        <nav class="nav">
          <a href="/notice" class={currentPath.startsWith('/notice') || currentCategory === 'notice' ? "active" : ""}>공지사항</a>
          <a href="/posts/soccer" class={currentPath.includes("soccer") || currentCategory === 'soccer' ? "active" : ""}>축구</a>
          <a href="/posts/baseball" class={currentPath.includes("baseball") || currentCategory === 'baseball' ? "active" : ""}>야구</a>
          <a href="/posts/basketball" class={currentPath.includes("basketball") || currentCategory === 'basketball' ? "active" : ""}>농구</a>
          <a href="/posts/volleyball" class={currentPath.includes("volleyball") || currentCategory === 'volleyball' ? "active" : ""}>배구</a>
          <a href="/posts/hockey" class={currentPath.includes("hockey") || currentCategory === 'hockey' ? "active" : ""}>하키</a>
          <a href="/posts/lol" class={currentPath.includes("lol") || currentCategory === 'lol' ? "active" : ""}>LoL</a>
        </nav>

        <!-- 🔥 햄버거 버튼 (추가) -->
        <button class="menu-btn" id="menu-btn">☰</button>

      </div>

<!-- 🔥 모바일 메뉴 + 배경 -->
<div class="menu-overlay" id="menu-overlay">
  <div class="mobile-menu" id="mobile-menu">
    <button class="close-btn" id="close-btn">✕</button>

    <a href="/notice" class={`menu notice ${currentPath.includes('/notice') ? 'active' : ''}`}>공지사항</a>
    <a href="/posts/soccer" class={`menu soccer ${currentPath.includes('/soccer') ? 'active' : ''}`}>축구분석</a>
    <a href="/posts/baseball" class={`menu baseball ${currentPath.includes('/baseball') ? 'active' : ''}`}>야구분석</a>
    <a href="/posts/basketball" class={`menu basketball ${currentPath.includes('/basketball') ? 'active' : ''}`}>농구분석</a>
    <a href="/posts/volleyball" class={`menu volleyball ${currentPath.includes('/volleyball') ? 'active' : ''}`}>배구분석</a>
    <a href="/posts/hockey" class={`menu hockey ${currentPath.includes('/hockey') ? 'active' : ''}`}>하키분석</a>
    <a href="/posts/lol" class={`menu lol ${currentPath.includes('/lol') ? 'active' : ''}`}>LoL분석</a>
  </div>
</div>
    </header>

    <main class="container">
     <div class="main-content">
      <slot />
    </div>
    </main>

    
    <!-- 🔥 JS 위치 중요 (body 맨 아래) -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // 페이지 이동 시 스피너 표시
  document.querySelectorAll('a[href]').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && !href.startsWith('#') && !href.startsWith('javascript') && !e.ctrlKey && !e.metaKey) {
        const spinner = document.getElementById('ph-spinner');
        if (spinner) spinner.style.display = 'flex';
      }
    });
  });

  // 뒤로가기/앞으로가기 시 스피너 숨김
  window.addEventListener('pageshow', (e) => {
    const spinner = document.getElementById('ph-spinner');
    if (spinner) spinner.style.display = 'none';
  });

  const menuBtn = document.getElementById('menu-btn');
  const closeBtn = document.getElementById('close-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('menu-overlay');

  if (!menuBtn || !closeBtn || !mobileMenu || !overlay) return;

  // 열기
  menuBtn.addEventListener('click', () => {
    overlay.classList.add('open');
  });

  // 닫기 버튼
  closeBtn.addEventListener('click', () => {
    overlay.classList.remove('open');
  });

  // 🔥 배경 클릭하면 닫힘
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) {
      overlay.classList.remove('open');
    }
  });
});
</script>

<style is:global>
  /* 전체 텍스트 또렷하게 (4번 해결) */
  body {
    color: #1a1a1a !important; /* 더 진한 블랙 */
    line-height: 1.8;
    font-family: 'Pretendard', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* 본문 텍스트(p) 강조 */
  p, li, td {
    color: #2d2d2d;
    font-weight: 400;
  }

  /* 섹션 타이틀 굵게 및 간격 (3번 해결) */
  h3 {
    font-size: 1.4rem;
    font-weight: 800 !important;
    color: #000;
    margin: 3rem 0 1.2rem 0 !important;
    display: block;
  }

  /* 표 디자인 */
  table {
    width: 100%;
    max-width: 800px;
    margin: 1.5rem auto;
    border-collapse: collapse;
    background-color: #fff;
    border: 1px solid #ddd;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
  }

  table thead { display: none; } /* 헤더 숨기기 */

  td {
    border: 1px solid #eee;
    padding: 16px;
    text-align: center;
    vertical-align: middle;
  }

  /* 첫 번째 열 파란색 강조 */
  table tr td:first-child {
    color: #007bff !important;
    font-weight: 700 !important;
    background-color: #fcfdfe;
    width: 25%;
    text-align: center !important;
  }

  /* 🔝 맨 위로 버튼 */
#scrollTopBtn {
  position: fixed;
  right: 16px;
  bottom: 80px;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 50%;
  background: rgba(0,0,0,0.7);
  color: white;
  font-size: 22px;
  cursor: pointer;
  z-index: 9999;

  opacity: 0;
  pointer-events: none;
  transition: all 0.25s ease;

  /* 🔥 네온 효과 추가 */
  box-shadow:
    0 0 8px #3b82f6,
    0 0 16px #2563eb;

  backdrop-filter: blur(6px);
}

/* 표시 상태 */
#scrollTopBtn.show {
  opacity: 1;
  pointer-events: auto;
}

#scrollTopBtn:hover {
  transform: scale(1.08);

  box-shadow:
    0 0 12px #60a5fa,
    0 0 24px #3b82f6;
}

/* 모바일 전용 */
@media (min-width: 769px) {
  #scrollTopBtn {
    display: none;
  }
}
</style>

<!-- 🔝 맨 위로 버튼 -->
<button id="scrollTopBtn" aria-label="맨 위로 이동">
  ↑
</button>

<script>
  const scrollTopBtn = document.getElementById('scrollTopBtn');

  // 스크롤 시 버튼 표시
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      scrollTopBtn.classList.add('show');
    } else {
      scrollTopBtn.classList.remove('show');
    }
  });

  // 클릭 시 맨 위 이동
  scrollTopBtn.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>

  </body>
</html>

<style>
.header {
  background: #ffffff;
  border-bottom: 1px solid #eaecef;
}

.header-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 14px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 🔥 로고 */
.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  line-height: 1;
  position: relative;
}

/* 🔥 메인 로고 */
.logo-main {
  font-family: 'A2z', sans-serif;
  font-size: 28px;
  font-weight: 800;
  color: #1252b9;
  letter-spacing: 1px;
  position: relative;
}

/* 🔥 왼쪽 날개 */
.logo-main::before {
  content: "";
  position: absolute;
  left: -45px;
  top: 2px;

  width: 34px;
  height: 34px;

  background-image: url('/icons/wing4.png');
  background-size: contain;
  background-repeat: no-repeat;

  transform-origin: right center;

  animation: wing-left 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;

  opacity: 0.95;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.25));
}

/* 🔥 오른쪽 날개 (진짜 반전 적용) */
.logo-main::after {
  content: "";
  position: absolute;
  right: -29px;
  top: 2px;

  width: 34px;
  height: 34px;

  background-image: url('/icons/wing4.png');
  background-size: contain;
  background-repeat: no-repeat;

  transform-origin: 70% center;

  animation: wing-right 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;

  opacity: 0.95;
  filter: drop-shadow(0 3px 5px rgba(0,0,0,0.25));
}

/* 🔥 왼쪽 날개 */
@keyframes wing-left {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  25% {
    transform: rotate(-14deg) translateY(-4px);
  }
  50% {
    transform: rotate(-0deg) translateY(-1px);
  }
  75% {
    transform: rotate(-7deg) translateY(-3px);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

/* 🔥 오른쪽 날개 (scaleX(-1) 반드시 포함!) */
@keyframes wing-right {
  0% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
  25% {
    transform: scaleX(-1) rotate(-14deg) translateY(-4px);
  }
  50% {
    transform: scaleX(-1) rotate(-0deg) translateY(-1px);
  }
  75% {
    transform: scaleX(-1) rotate(-7deg) translateY(-3px);
  }
  100% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
}

/* 🔥 hover 시 더 크게 펄럭 */
.logo:hover .logo-main::before {
  animation: wing-left-hover 0.9s ease-in-out infinite;
}

.logo:hover .logo-main::after {
  animation: wing-right-hover 0.9s ease-in-out infinite;
}

/* 🔥 hover - 왼쪽 */
@keyframes wing-left-hover {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  50% {
    transform: rotate(-22deg) translateY(-8px);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

/* 🔥 hover - 오른쪽 */
@keyframes wing-right-hover {
  0% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
  50% {
    transform: scaleX(-1) rotate(-22deg) translateY(-8px);
  }
  100% {
    transform: scaleX(-1) rotate(0deg) translateY(0);
  }
}

/* 🔥 서브 텍스트 */
.logo-sub {
  font-size: 11px;
  color: #888;
  margin-top: 3px;
  letter-spacing: 2px;
}

/* 🔥 hover */
.logo:hover .logo-main {
  transform: scale(1.05);
  transition: 0.2s;
}

/* 🔥 메뉴간격 */
.nav {
  display: flex;
  gap: 40px;
}

.nav a {
  text-decoration: none;
  font-size: 17px;
  color: #333;
  font-weight: 500;
  position: relative;
}

.nav a:hover {
  color: #3b82f6;
}

.nav a.active {
  color: #3b82f6;
  font-weight: 700;
}

.nav a.active::after {
  content: "";
  position: absolute;
  bottom: -6px;
  left: 0;
  width: 100%;
  height: 2px;
  background: #3b82f6;
}

/* 🔥 메인 */
.container {
  display: flex;       
  gap: 10px;           /* 🔥 추가: 이 숫자를 30px, 40px 등으로 바꿔서 간격을 조절하세요 */
  max-width: 1230px;
  margin: 0px auto;
  padding: 0 20px;
  align-items: flex-start; /* 추가: 사이드바가 본문 길이에 따라 늘어나지 않게 고정 */
}

@media (max-width: 768px) {
  .container {
    padding: 0 !important;
    width: 100% !important;
    max-width: none !important;
  }
}

/* 🔥 본문 넓이 조절 */
.main-content {
  flex: 1;
  min-width: 0; 
}


@media (max-width: 768px) {
  .main-content {
    width: 100% !important;
    padding: 0 !important;
  }
}

/* 🔥 사이드바 넓이 고정 */
.sidebar {
  width: 280px;
  flex-shrink: 0;
}

/* 🔥 방문자 카운터 카드 디자인 */
.visitor-card {
  background: #fff;
  border: 1px solid #eaecef;
  border-radius: 10px;
  padding: 15px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.visitor-header {
  font-size: 14px;
  font-weight: 700;
  color: #333;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px dashed #eee;
  display: flex;
  align-items: center;
  gap: 5px;
}

.visitor-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.visitor-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 13px;
  color: #666;
}

.count {
  font-size: 14px;
  font-weight: 800;
  color: #1d61cf; /* 픽천국 메인 블루 색상 */
}

/* 모바일에서는 사이드바를 아래로 내림 */
@media (max-width: 1024px) {
  .container {
    flex-direction: column;
  }
  .sidebar {
    width: 100%;
  }
}

/* =========================
   📱 모바일 헤더 개선
========================= */
@media (max-width: 768px) {

  /* 로고 중앙 */
  .logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  /* 햄버거는 오른쪽 */
  .menu-btn {
    position: absolute;
    right: 20px;
  }

  /* 헤더 컨테이너 기준점 */
  .header-container {
    position: relative;
  }

}

.board {
    background: #fff;
    border-radius: 10px;
    margin-bottom: 10px !important; /* 게시판 사이의 아래 여백을 20px -> 10px로 줄임 */
    
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  /* 🔴 게시판 헤더의 위아래 뚱뚱한 여백도 줄이고 싶다면 이 부분을 수정하세요 */
  .board-header {
    padding: 10px 15px !important; /* 기존보다 위아래를 더 홀쭉하게 만듭니다 */
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>