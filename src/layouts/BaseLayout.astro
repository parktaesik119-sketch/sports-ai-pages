---
import "../styles/global.css";

const { url } = Astro;
const currentPath = url.pathname;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{Astro.props.title}</title>

    <meta name="description" content={Astro.props.description ?? "스포츠 분석 및 추천픽 제공"} />
    <meta name="keywords" content="스포츠 분석, 축구 분석, 야구 분석, 농구 픽, 토토 추천" />

    <link rel="canonical" href={Astro.url} />

    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:description" content={Astro.props.description ?? "스포츠 분석 사이트"} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="/og-default.jpg" />

    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <header class="header">
      <div class="header-container">

        <!-- 로고 -->
        <a href="/" class="logo">
          <span class="logo-main">픽천국</span>
          <span class="logo-sub">PICK HEAVEN</span>
        </a>

        <!-- PC 메뉴 -->
        <nav class="nav">
          <a href="/notice" class={currentPath.startsWith('/notice') ? "active" : ""}>공지사항</a>
          <a href="/posts/soccer" class={currentPath.includes("soccer") ? "active" : ""}>축구</a>
          <a href="/posts/baseball" class={currentPath.includes("baseball") ? "active" : ""}>야구</a>
          <a href="/posts/basketball" class={currentPath.includes("basketball") ? "active" : ""}>농구</a>
          <a href="/posts/volleyball" class={currentPath.includes("volleyball") ? "active" : ""}>배구</a>
          <a href="/posts/hockey" class={currentPath.includes("hockey") ? "active" : ""}>하키</a>
          <a href="/posts/lol" class={currentPath.includes("lol") ? "active" : ""}>LoL</a>
        </nav>

        <!-- 햄버거 -->
        <button class="menu-btn" id="menuBtn">☰</button>

      </div>

      <!-- 🔥 오버레이 -->
      <div class="menu-overlay" id="menuOverlay"></div>

      <!-- 모바일 메뉴 -->
      <div class="mobile-menu" id="mobileMenu">
        <button class="close-btn" id="closeBtn">✕</button>

        <a href="/notice">공지사항</a>
        <a href="/posts/soccer">축구</a>
        <a href="/posts/baseball">야구</a>
        <a href="/posts/basketball">농구</a>
        <a href="/posts/volleyball">배구</a>
        <a href="/posts/hockey">하키</a>
        <a href="/posts/lol">LoL</a>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <!-- 🔥 JS (여기가 핵심) -->
    <script is:inline>
      const menuBtn = document.getElementById('menuBtn');
      const closeBtn = document.getElementById('closeBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      const overlay = document.getElementById('menuOverlay');

      function openMenu() {
        mobileMenu.classList.add('open');
        overlay.classList.add('show');
      }

      function closeMenu() {
        mobileMenu.classList.remove('open');
        overlay.classList.remove('show');
      }

      menuBtn?.addEventListener('click', openMenu);
      closeBtn?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);
    </script>

  </body>
</html>

<style>
.header {
  background: #ffffff;
  border-bottom: 1px solid #eaecef;
}

/* 컨테이너 */
.header-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 14px 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 로고 */
.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
}

.logo-main {
  font-size: 28px;
  font-weight: 800;
  color: #3b82f6;
}

.logo-sub {
  font-size: 11px;
  color: #888;
}

/* 메뉴 */
.nav {
  display: flex;
  gap: 20px;
}

.nav a {
  text-decoration: none;
  font-size: 15px;
  color: #333;
}

.nav a.active {
  color: #3b82f6;
  font-weight: 700;
}

/* 햄버거 */
.menu-btn {
  display: none;
  font-size: 24px;
  background: none;
  border: none;
  cursor: pointer;
  z-index: 3000;
}

/* 🔥 오버레이 */
.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;

  background: rgba(0,0,0,0.4);
  opacity: 0;
  visibility: hidden;

  transition: all 0.3s;
  z-index: 1500;
}

.menu-overlay.show {
  opacity: 1;
  visibility: visible;
}

/* 모바일 메뉴 */
.mobile-menu {
  position: fixed;
  top: 0;
  right: -100%;
  width: 260px;
  height: 100%;
  background: #fff;

  display: flex;
  flex-direction: column;
  padding: 20px;
  gap: 15px;

  transition: right 0.3s;
  z-index: 2000;
}

.mobile-menu.open {
  right: 0;
}

.mobile-menu a {
  text-decoration: none;
  font-size: 16px;
  color: #111;
  font-weight: 500;
}

/* 닫기 버튼 */
.close-btn {
  align-self: flex-end;
  font-size: 20px;
  background: none;
  border: none;
}

/* 📱 모바일 */
@media (max-width: 768px) {

  .nav {
    display: none;
  }

  .menu-btn {
    display: block;
  }
}
</style>