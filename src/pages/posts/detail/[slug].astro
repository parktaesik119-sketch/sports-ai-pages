---
// src/pages/posts/detail/[slug].astro
//
// ⚠️ BUILD_ARCHIVE 환경변수로 어느 컬렉션을 빌드할지 분기한다.
// - 평소(lineup-update.yml, 30분마다): 환경변수 없음 → 'posts'(최근 글)만 빌드 → 빠름
// - archive-build.yml(주 1회): BUILD_ARCHIVE=true → 'archive'(7일 지난 글)만 빌드
// 두 빌드가 만든 HTML을 배포 직전에 합쳐서 올리므로, URL 구조(/posts/detail/{slug})는
// 어느 쪽에서 만들어졌든 완전히 동일하게 유지된다. 절대 두 컬렉션을 동시에 빌드하지
// 않는다 — 그러면 archive까지 매번 다시 만들어서 이 구조를 도입한 의미가 없어진다.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { CATEGORY_MAP } from '../../../lib/categories';
import AdGrid from '../../../components/AdGrid.astro';
import TEAM_NAME_MAP from '../../../../scripts/team_name_map.js';
import COUNTRY_MAP from '../../../../scripts/country_map.js';
import COUNTRY_FLAG_MAP from '../../../../data/i18n/country-flag-map.js';
import { EXACT_LEAGUE_MAP } from '../../../../data/i18n/league-name-map.js';
import { sortLineupForPitchView } from '../../../../scripts/formation-common.js';

// ⚠️ getStaticPaths()는 빌드 시점에 별도 청크로 분리되어 실행되기 때문에,
// 파일 최상단의 const를 공유해서 쓸 수 없다(ReferenceError 발생 확인됨, 2026-08).
// 그래서 아래처럼 필요한 곳마다 각자 인라인으로 계산한다 — 중복돼 보여도
// 이게 정상이다.

export async function getStaticPaths() {
  const items = await getCollection(process.env.BUILD_ARCHIVE === 'true' ? 'archive' : 'posts');

  if (!items || items.length === 0) return [];

  return items.map((item) => ({
    params: {
      slug: String(item.data.slug || item.id)
    }
  }));
}

const { slug } = Astro.params;

const allPosts = await getCollection(process.env.BUILD_ARCHIVE === 'true' ? 'archive' : 'posts');

/* 🔥 slug로 직접 찾기 */
const item = allPosts.find(
  (post) => (post.data.slug || post.id) === slug
);

/* 🔥 안전 처리 */
if (!item) {
  throw new Error(`게시글을 찾을 수 없음: ${slug}`);
}

const { Content } = await render(item);

/* 🔥 추가 (핵심) */
const category = item.data.category;
const categoryName = CATEGORY_MAP[category] ?? category;

/* ✅ 카드 표시용 데이터 — frontmatter 우선, 없으면 body 파싱 백업 */
const bodyText = item.body || "";

let country = item.data.country?.trim() && item.data.country !== '국가'
  ? item.data.country.trim() : '';
let league = item.data.league?.trim() && item.data.league !== '리그'
  ? item.data.league.trim() : '';
let homeTeam = item.data.homeTeam?.trim() && item.data.homeTeam !== '홈팀'
  ? item.data.homeTeam.trim() : '';
let awayTeam = item.data.awayTeam?.trim() && item.data.awayTeam !== '원정팀'
  ? item.data.awayTeam.trim() : '';
let homeLogo = item.data.homeLogo?.trim() && item.data.homeLogo !== '/images/wing-home.png'
  ? item.data.homeLogo.trim() : '';
let awayLogo = item.data.awayLogo?.trim() && item.data.awayLogo !== '/images/wing-away.png'
  ? item.data.awayLogo.trim() : '';

// body 파싱 백업 (frontmatter 값이 없을 때만)
if ((!country || !league) && bodyText) {
  const leagueRegex = /\|\s*\*\*<span[^>]*>리그<\/span>\*\*\s*\|\s*\*\*(.*?):\s*(.*?)\*\*\s*\|/;
  const m = bodyText.match(leagueRegex);
  if (m) {
    if (!country) country = m[1].trim();
    if (!league) league = m[2].trim();
  }
}

if ((!homeTeam || !awayTeam) && bodyText) {
  if (!homeTeam) {
    const m = bodyText.match(/\|\s*\*\*<span[^>]*>홈팀<\/span>\*\*\s*\|\s*<img[^>]*>\s*\*\*(.*?)\s*\(/);
    if (m) homeTeam = m[1].trim();
  }
  if (!awayTeam) {
    const m = bodyText.match(/\|\s*\*\*<span[^>]*>원정팀<\/span>\*\*\s*\|\s*<img[^>]*>\s*\*\*(.*?)\s*\(/);
    if (m) awayTeam = m[1].trim();
  }
}

if ((!homeLogo || !awayLogo) && bodyText) {
  const logoRegex = category === 'lol'
    ? /\/logos\/[a-z0-9-_]+\.png/g
    : /https:\/\/media\.api-sports\.io\/[a-z-]+\/teams\/\d+\.png/g;
  const logos = bodyText.match(logoRegex);
  if (logos && logos.length >= 2) {
    if (!homeLogo) homeLogo = logos[0];
    if (!awayLogo) awayLogo = logos[1];
  }
}

// 최종 기본값
country = country || '국가';
league = league || '리그';
homeTeam = homeTeam || '홈팀';
awayTeam = awayTeam || '원정팀';
homeLogo = homeLogo || '/images/wing-home.png';
awayLogo = awayLogo || '/images/wing-away.png';

// ─────────────────────────────────────────────
// 팀명을 화면에 뿌리기 "직전"에 team_name_map.js로 한 번 더 번역한다.
// 글 생성 시점에 이미 한글로 잘 박혀있는 대부분의 값은, 그 한글 문자열이
// TEAM_NAME_MAP의 키(영문)로는 안 걸리니까 그대로 통과한다 — 기존 글에 영향 없음.
// 반대로 (footystats 보충 등으로) 매칭 실패해서 영문으로 박제된 값은, 나중에
// team_name_map.js에 그 팀을 추가하기만 하면 — .md 파일을 다시 안 고쳐도 —
// 이 페이지를 다시 열 때 바로 한글로 나온다.
function translateTeam(name: string) {
  if (!name) return name;
  return (TEAM_NAME_MAP as Record<string, string>)[name] || name;
}

// 리그명도 팀명과 똑같은 방식: league-name-map.js(EXACT_LEAGUE_MAP)에 없는 값(주로
// 아직 매핑을 안 넣어준 마이너 리그)은 원문 그대로 통과한다 — 나중에 league-name-map.js에
// 추가하기만 하면 .md 파일을 다시 안 고쳐도 이 페이지를 다시 열 때 바로 한글로 나온다.
function translateLeague(name: string) {
  if (!name) return name;
  return (EXACT_LEAGUE_MAP as Record<string, string>)[name] || name;
}

// 국가명도 동일한 방식. analyze-router 쪽에서 이미 COUNTRY_MAP으로 작성 시점에 번역해서
// 넣어주고는 있지만, API 소스가 바뀌어서 'South-Korea'처럼 하이픈이 섞이거나 country_map.js에
// 아직 없는 표기가 나중에 뒤늦게 박히는 경우가 있다 — 그런 값도 country_map.js에 보정만
// 추가하면 이 페이지를 다시 열 때 바로 한글로 나온다.
function translateCountry(name: string) {
  if (!name) return name;
  return (COUNTRY_MAP as Record<string, string>)[name] || name;
}

// ⚠️ analyze-router가 글 작성 시점에 COUNTRY_MAP으로 이미 한글로 번역해서
// frontmatter에 박아넣기 때문에, 대부분의 글(과거 글 포함)은 country 값이
// "South Korea"가 아니라 이미 "대한민국"으로 들어있다. country-flag-map.js는
// 영문 원문 키로만 찾을 수 있어서, 한글값 → 영문 원문 역매핑을 만들어 둔다.
const KOREAN_TO_ENGLISH_COUNTRY: Record<string, string> = {};
for (const [en, ko] of Object.entries(COUNTRY_MAP as Record<string, string>)) {
  if (!(ko in KOREAN_TO_ENGLISH_COUNTRY)) {
    KOREAN_TO_ENGLISH_COUNTRY[ko] = en;
  }
}

// country_map.js와 동일한 원문(영문) 키로 flag-icons 클래스 코드를 찾는다.
// 1) country 값이 아직 영문 원문이면 바로 조회
// 2) 이미 한글로 박제돼 있으면(대부분의 글) 위 역매핑으로 영문 원문을 복원해서 재조회
// 그래도 못 찾으면(Asia/World 같은 대륙·기타 값 등) null → 지구본 폴백 아이콘으로 대체.
function getFlagCode(name: string): string | null {
  if (!name) return null;
  const flagMap = COUNTRY_FLAG_MAP as Record<string, string>;
  if (flagMap[name]) return flagMap[name];
  const englishName = KOREAN_TO_ENGLISH_COUNTRY[name];
  if (englishName && flagMap[englishName]) return flagMap[englishName];
  return null;
}

// title/description/summary/homeAnalysis 등 "문장 안에 팀명·리그명·국가명이 섞여있는" 필드용.
// homeTeam/awayTeam/league/country(frontmatter 원문 — 번역 실패 시 영문일 수 있음)이 텍스트
// 어딘가에 등장하면, 그 부분만 찾아서 한글로 치환한다. 이미 한글로 잘 박힌 정상 케이스는
// 해당 값 자체가 한글이라 맵의 키(영문)로는 안 걸려서 아무 일도 안 일어난다(안전).
function translateTeamsInText(text: string): string {
  if (!text) return text;
  let result = text;
  const homeKo = (TEAM_NAME_MAP as Record<string, string>)[homeTeam];
  const awayKo = (TEAM_NAME_MAP as Record<string, string>)[awayTeam];
  const leagueKo = (EXACT_LEAGUE_MAP as Record<string, string>)[league];
  const countryKo = (COUNTRY_MAP as Record<string, string>)[country];
  if (homeKo) result = result.split(homeTeam).join(homeKo);
  if (awayKo) result = result.split(awayTeam).join(awayKo);
  if (leagueKo) result = result.split(league).join(leagueKo);
  if (countryKo) result = result.split(country).join(countryKo);
  return result;
}

// 분석 데이터 프론트매터
const homeAnalysis   = translateTeamsInText(item.data.homeAnalysis  || '');
const awayAnalysis   = translateTeamsInText(item.data.awayAnalysis  || '');
const homePowerItems = (item.data.homePower || '').split('|').map((s: string) => translateTeamsInText(s.trim())).filter(Boolean);
const awayPowerItems = (item.data.awayPower || '').split('|').map((s: string) => translateTeamsInText(s.trim())).filter(Boolean);
let h2hItems: any[] = [];
if (item.data.h2h && item.data.h2h !== '없음') {
  const raw = (item.data.h2h || '').trim();
  if (raw.startsWith('[')) {
    try { h2hItems = JSON.parse(raw); } catch(e) {}
  } else {
    h2hItems = raw.split('|').map((s: string) => s.trim()).filter(Boolean);
  }
}
const summary        = translateTeamsInText(item.data.summary || '');
const translatedTitle       = translateTeamsInText(item.data.title || '');

let homeRecentItems: any[] = [];
let awayRecentItems: any[] = [];
try { homeRecentItems = JSON.parse(item.data.homeRecent || '[]'); } catch(e) {}
try { awayRecentItems = JSON.parse(item.data.awayRecent || '[]'); } catch(e) {}

function fixRecentResult(items: any[], myTeamRaw: string) {
  const myTeam = translateTeam(myTeamRaw);
  return items.map((m: any) => {
    const sm = typeof m.score === 'string' ? m.score.match(/(-?\d+)\s*-\s*(-?\d+)/) : null;
    if (!sm) return m;
    const homeScore = Number(sm[1]);
    const awayScore = Number(sm[2]);
    let my, op;
    if (translateTeam(m.home) === myTeam) { my = homeScore; op = awayScore; }
    else if (translateTeam(m.away) === myTeam) { my = awayScore; op = homeScore; }
    else return m; // 팀명 매칭 안되면 원래 값 유지
    const result = my > op ? '🟢승' : my < op ? '🔴패' : '🟡무';
    return { ...m, result };
  });
}
homeRecentItems = fixRecentResult(homeRecentItems, homeTeam);
awayRecentItems = fixRecentResult(awayRecentItems, awayTeam);

// 라인업 (원본 순서 — "통합 라인업" 리스트 위젯 등, 순서가 중요하지 않은 곳에 사용)
let homeLineupItems: string[] = [];
let awayLineupItems: string[] = [];
try { homeLineupItems = JSON.parse(item.data.homeLineup || '[]'); } catch(e) {}
try { awayLineupItems = JSON.parse(item.data.awayLineup || '[]'); } catch(e) {}

// 포메이션 피치뷰(좌표 배치)용: 소스(footystats 등)가 주는 라인업 순서가 GK→DF→MF→
// WIDE→FW로 깔끔히 정렬돼 있다는 보장이 없어서(윙어가 중간에 섞여 오는 경우가 실사용에서
// 확인됨), 프론트매터의 homeFormation/homeLineup을 그대로 믿지 않고 렌더링 시점에
// sortLineupForPitchView()로 직접 재정렬 + 포메이션을 재계산한다. 이렇게 하면 좌표
// 배치(순서 기반)와 포메이션 라벨이 항상 서로 어긋나지 않는다. 재계산이 실패하면(GK가
// 1명이 아니거나 포지션 정보가 너무 부실한 경우) 프론트매터 값으로 폴백한다.
const homePitchView = sortLineupForPitchView(homeLineupItems);
const awayPitchView = sortLineupForPitchView(awayLineupItems);
const homePitchLineup = homePitchView.formation ? homePitchView.sortedItems : homeLineupItems;
const awayPitchLineup = awayPitchView.formation ? awayPitchView.sortedItems : awayLineupItems;

// 포메이션
const homeFormation = homePitchView.formation || item.data.homeFormation?.trim() || '';
const awayFormation = awayPitchView.formation || item.data.awayFormation?.trim() || '';
const hasFormation  = !!(homeFormation && awayFormation && homeLineupItems.length > 0 && awayLineupItems.length > 0);

// 감독
// 감독: "이름|사진url" 형식 (사진 없으면 이름만 오는 경우도 방어)
function parseCoach(raw: string): { name: string; photo: string } {
  if (!raw) return { name: '', photo: '' };
  const [name, photo] = raw.split('|');
  return { name: (name || '').trim(), photo: (photo || '').trim() };
}
const homeCoachRaw = item.data.homeCoach?.trim() || '';
const awayCoachRaw = item.data.awayCoach?.trim() || '';
const homeCoach = parseCoach(homeCoachRaw);
const awayCoach = parseCoach(awayCoachRaw);

const W_SVG = 700, H_SVG = 360;
function calcPos(formation: string, side: 'home' | 'away') {
  const lines = formation.split('-').map(Number).filter((n: number) => !isNaN(n) && n > 0);
  if (lines.length === 0) lines.push(...[4,3,3]);
  const numLines = lines.length + 1;
  const padX = W_SVG * 0.08;
  const padY = H_SVG * 0.04;
  const halfW = (W_SVG - padX * 2) * 0.40;
  const fieldH = H_SVG - padY * 2;
  const xPos: number[] = [];
  for (let i = 0; i < numLines; i++) {
    const r = i / (numLines - 1);
    xPos.push(side === 'home' ? padX + r * halfW : W_SVG - padX - r * halfW);
  }
  const positions: {x:number,y:number,isGK:boolean}[] = [];
  positions.push({ x: xPos[0], y: H_SVG / 2, isGK: true });
  lines.forEach((count: number, li: number) => {
    const lx = xPos[li + 1];
    const effH = fieldH * 0.85;
const startY = H_SVG / 2 - effH / 2;
for (let j = 0; j < count; j++) {
  const y = startY + effH * ((j + 0.5) / count);
  positions.push({ x: lx, y, isGK: false });
}
  });
  return positions;
}
function makePosFn(formation: string) {
  const lines = formation.split('-').map(Number).filter((n: number) => !isNaN(n) && n > 0);
  const result = ['GK'];
  lines.forEach((count: number, li: number) => {
    const posName = li === 0 ? 'DF' : li === lines.length - 1 ? 'FW' : 'MF';
    for (let j = 0; j < count; j++) result.push(posName);
  });
  return result;
}
function shortenName(name: string) {
  return name.length > 7 ? name.slice(0, 6) + '.' : name;
}

const hCoords = hasFormation ? calcPos(homeFormation, 'home') : [];
const aCoords = hasFormation ? calcPos(awayFormation, 'away') : [];
const hPosFn  = hasFormation ? makePosFn(homeFormation) : [];
const aPosFn  = hasFormation ? makePosFn(awayFormation) : [];
const GK_COLOR   = '#f59f00';
const HOME_COLOR = '#e03131';
const AWAY_COLOR = '#228be6';

// 부상/결장자
const injuryHome = item.data.injuryHome?.trim() || '';
const injuryAway = item.data.injuryAway?.trim() || '';
const hasInjury = !!(
  (injuryHome && injuryHome !== '없음') ||
  (injuryAway && injuryAway !== '없음')
);
// 구형 H2H 데이터(객체 아닌 순수 문자열)는 날짜 뒤에 공백 없이 저장된 경우가 있어
// "26.04.17피츠버그..." 처럼 붙어 보일 수 있음. 방어적으로 공백을 보정.
function formatLegacyH2hText(str: unknown): string {
  if (typeof str !== 'string') return String(str ?? '');
  return str.replace(/^(\d{2}\.\d{2}\.\d{2})(?=\S)/, '$1 ');
}

// "Will Wilson (골절)" → { name: "Will Wilson", reason: "골절" } 로 분리 (사유 우측 정렬용)
function parseInjuryEntry(entry: string): { name: string; reason: string } {
  const m = entry.match(/^(.+?)\s*\(([^)]+)\)\s*$/);
  if (!m) return { name: entry, reason: '' };
  const name = m[1].replace(/\[[^\]]*\]\s*$/, '').trim();   // 이름에 붙은 [주요] 태그 제거
  const reason = m[2].split(' - ')[0].trim();                 // "부상 - 복귀예정 ..." 중 "부상"만 남김
  return { name, reason };
}

function parseInjury(str: string): string[] {
  if (!str || str === '없음') return [];
  const result: string[] = [];
  const cp = String.fromCharCode(41);
  const parts = str.split('|');
  for (const part of parts) {
    const trimmed = part.trim();
    if (!trimmed) continue;
    const subparts = trimmed.split(cp + ', ');
    for (let i = 0; i < subparts.length; i++) {
      const s = i < subparts.length - 1 ? subparts[i] + cp : subparts[i];
      if (s.trim()) result.push(s.trim());
    }
  }
  return result;
}
function dedupeInjuryEntries(entries: string[]): string[] {
  const seen = new Set<string>();
  const result: string[] = [];
  for (const entry of entries) {
    const { name } = parseInjuryEntry(entry);
    // "강백호(내야수)" 처럼 이름 뒤에 붙는 포지션 등 부가 표기를 지운 순수 이름으로
    // 비교해서, 같은 선수가 소스별로 다르게 표기돼도 중복으로 잡아낸다
    const key = name.replace(/\([^)]*\)\s*$/, '').trim();
    if (seen.has(key)) continue;
    seen.add(key);
    result.push(entry);
  }
  return result;
}

const injuryHomeItems = dedupeInjuryEntries(parseInjury(injuryHome));
const injuryAwayItems = dedupeInjuryEntries(parseInjury(injuryAway));

// 추천 픽
const pickWinTeam       = translateTeamsInText(item.data.pickWinTeam?.trim()       || '');
const pickWinResult     = item.data.pickWinResult?.trim()      || '';
const pickHandicapTeam  = translateTeamsInText(item.data.pickHandicapTeam?.trim()   || '');
const pickHandicapValue = item.data.pickHandicapValue?.trim()  || '';
const pickExpectedHome  = item.data.pickExpectedHome?.trim()   || '';
const pickExpectedAway  = item.data.pickExpectedAway?.trim()   || '';
// 기존 글 호환: pickOuValue/pickOuDirection 백업으로 유지
const pickOuDirection   = item.data.pickOuDirection?.trim()    || '';
const pickOuValue       = item.data.pickOuValue?.trim()        || '';
const hasExpectedScore  = !!(pickExpectedHome && pickExpectedAway);
const hasPick = !!(pickWinTeam || pickHandicapValue || pickExpectedHome || pickOuValue);

// ─────────────────────────────────────────────
// Schema.org 구조화 데이터(JSON-LD) — 구글에게 "이건 실제 스포츠 경기 분석
// 콘텐츠"임을 명시적으로 알림. BreadcrumbList + Article은 항상, SportsEvent는
// 팀명이 정상 파싱됐을 때만 추가한다(기본값 '홈팀'/'원정팀'이면 의미 없는 데이터라 스킵).
// ─────────────────────────────────────────────
const pageUrl = `https://pick79.com/posts/detail/${slug}/`;

const SPORT_MAP: Record<string, string> = {
  soccer: 'Soccer',
  baseball: 'Baseball',
  basketball: 'Basketball',
  volleyball: 'Volleyball',
  hockey: 'IceHockey',
};
const sportName = SPORT_MAP[category];

const eventDateObj = new Date(item.data.date);
const eventDateISO = !isNaN(eventDateObj.getTime()) ? eventDateObj.toISOString() : undefined;

const structuredData: any = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '홈', item: 'https://pick79.com/' },
        { '@type': 'ListItem', position: 2, name: categoryName, item: `https://pick79.com/posts/${category}/` },
        { '@type': 'ListItem', position: 3, name: translatedTitle, item: pageUrl },
      ],
    },
    {
      '@type': 'Article',
      headline: translatedTitle,
      description: summary || `${translatedTitle} 스포츠경기 분석글입니다.`,
      ...(eventDateISO ? { datePublished: eventDateISO } : {}),
      author: { '@type': 'Organization', name: '픽천국' },
      publisher: {
        '@type': 'Organization',
        name: '픽천국',
        logo: { '@type': 'ImageObject', url: 'https://i.imgur.com/GgcZzZo.png' },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      ...(homeLogo && homeLogo !== '/images/wing-home.png' ? { image: [homeLogo] } : {}),
    },
  ],
};

if (homeTeam !== '홈팀' && awayTeam !== '원정팀') {
  structuredData['@graph'].push({
    '@type': 'SportsEvent',
    name: `${homeTeam} vs ${awayTeam}`,
    ...(eventDateISO ? { startDate: eventDateISO } : {}),
    ...(sportName ? { sport: sportName } : {}),
    homeTeam: { '@type': 'SportsTeam', name: homeTeam },
    awayTeam: { '@type': 'SportsTeam', name: awayTeam },
    ...(league && league !== '리그' ? { superEvent: { '@type': 'SportsOrganization', name: translateLeague(league) } } : {}),
    location: { '@type': 'Place', name: country && country !== '국가' ? translateCountry(country) : '미정' },
    url: pageUrl,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  });
}

// "</script>" 같은 시퀀스가 팀명/제목에 우연히 섞여 스크립트 태그가 조기 종료되는
// 사고를 방지하기 위한 안전장치
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<BaseLayout 
  title={`${translatedTitle} - ${categoryName}`}
    description={`${translatedTitle} 스포츠경기 분석글입니다. 최신 스포츠분석 및 추천 스포츠픽 제공`}
    currentCategory={category}
>
  <script type="application/ld+json" set:html={structuredDataJson} />
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <article class="board-card detail-view">

        <header class="detail-header">
          <div class="category-badge">{categoryName}</div>
          <h1>{translatedTitle}</h1>

          <div class="post-meta">
            작성일: {new Date(item.data.date).toLocaleDateString('ko-KR')}
          </div>
        </header>

<div class="detail-content">

  <div style="margin-bottom: 20px;">
    <AdGrid type="top" />
  </div>
<!-- ✅ 경기 정보 카드 (광고 아래 고정) -->
  <div class="match-info-card" id="matchInfoCard">
    <div class="card-top">
      <span class="league-info">
        {getFlagCode(country) ? (
          <span class={`fi fi-${getFlagCode(country)} flag-icon`} aria-hidden="true"></span>
        ) : (
          <img src="/assets/fallback/flag.svg" class="flag-icon flag-icon--fallback" alt="" aria-hidden="true" />
        )}
        {translateCountry(country)} <span class="league-bracket">[ {translateLeague(league)} ]</span>
      </span>
      <span class="match-time-text">
        {(() => {
          const d = new Date(item.data.date);
          const kst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
          const yy = String(kst.getUTCFullYear()).slice(-2);
          const mm = String(kst.getUTCMonth() + 1).padStart(2, '0');
          const dd = String(kst.getUTCDate()).padStart(2, '0');
          const hh = String(kst.getUTCHours()).padStart(2, '0');
          const mi = String(kst.getUTCMinutes()).padStart(2, '0');
          return `${yy}년 ${mm}월 ${dd}일 ${hh}:${mi}`;
        })()}
      </span>
    </div>
    <div class="card-center">
      <div class="team home-team">
        <span class="team-name">{translateTeam(homeTeam)}</span>
      <img src={homeLogo} alt={translateTeam(homeTeam)}
          class="team-logo"
          onerror="if(!this.dataset.failed){this.dataset.failed='1';this.src='/images/wing-home.png';}"
        />
      </div>
      <div class="vs-zone">VS</div>
      <div class="team away-team">
         <img src={awayLogo} alt={translateTeam(awayTeam)}
          class="team-logo"
          onerror="if(!this.dataset.failed){this.dataset.failed='1';this.src='/images/wing-away.png';}"
        />
        <span class="team-name">{translateTeam(awayTeam)}</span>
      </div>
    </div>
  </div>

  <!-- 구 방식 글: homeAnalysis 없으면 본문 그대로 렌더링 -->
  {!homeAnalysis && (
    <div class="prose">
      <Content />
    </div>
  )}

  <!-- 포메이션 -->
  {hasFormation && (
    <div class="section-widget" style="margin-bottom:20px;">
      <h2 class="section-widget-header" style="background:#1a1a2e;background-image:linear-gradient(180deg,#1a1a2e 0%,#16213e 100%);">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#fff;flex-shrink:0;margin-right:6px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a1a2e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="3" x2="12" y2="21"/><line x1="3" y1="12" x2="21" y2="12"/></svg>
        </span>
        예상 포메이션
      </h2>
      <!-- 소파스코어식 상단 팀명+포메이션 바 -->
      <div style="display:flex;align-items:center;background:#f8f9fa;border-bottom:1px solid #e9ecef;padding:10px 16px;">
        <div style="flex:1;text-align:center;">
          <div style="font-weight:800;font-size:0.95rem;color:#1a1a2e;">{translateTeam(homeTeam)}</div>
          <div style="font-size:1rem;color:#1a1a2e;margin-top:2px;font-weight:700;">{homeFormation}</div>
        </div>
        <div style="display:flex;gap:12px;align-items:center;padding:0 16px;">
          <!-- 홈 유니폼: 빨간색 -->
          <svg width="22" height="26" viewBox="0 0 22 26" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 1 L1 5 L3 10 L6 9 L6 25 L16 25 L16 9 L19 10 L21 5 L15 1 Q11 3 7 1Z" fill="#e03131" stroke="#c92a2a" stroke-width="0.5"/>
          </svg>
          <!-- 원정 유니폼: 파란색 -->
          <svg width="22" height="26" viewBox="0 0 22 26" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 1 L1 5 L3 10 L6 9 L6 25 L16 25 L16 9 L19 10 L21 5 L15 1 Q11 3 7 1Z" fill="#228be6" stroke="#1971c2" stroke-width="0.5"/>
          </svg>
        </div>
        <div style="flex:1;text-align:center;">
          <div style="font-weight:800;font-size:0.95rem;color:#1a1a2e;">{translateTeam(awayTeam)}</div>
          <div style="font-size:1rem;color:#1a1a2e;margin-top:2px;font-weight:700;">{awayFormation}</div>
        </div>
      </div>
      <div style="background:#fff;padding:0;">
        <svg viewBox={`0 0 ${W_SVG} ${H_SVG}`} xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block;">
          <rect width={W_SVG} height={H_SVG} fill="#2d6a1f"/>
          <rect x="10" y="10" width={W_SVG-20} height={H_SVG-20} fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.5"/>
          <line x1={W_SVG/2} y1="10" x2={W_SVG/2} y2={H_SVG-10} stroke="rgba(255,255,255,0.35)" stroke-width="1.5"/>
          <circle cx={W_SVG/2} cy={H_SVG/2} r="55" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.5"/>
          <circle cx={W_SVG/2} cy={H_SVG/2} r="4" fill="rgba(255,255,255,0.5)"/>
          <rect x="10" y={H_SVG*0.32} width={W_SVG*0.13} height={H_SVG*0.37} fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.2"/>
          <rect x={W_SVG-10-W_SVG*0.13} y={H_SVG*0.32} width={W_SVG*0.13} height={H_SVG*0.37} fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.2"/>
          {homePitchLineup.filter((p: string) => !p.startsWith('선발투수') && !p.includes('번 ')).slice(0,11).map((player: string, i: number) => (() => {
  const coord = hCoords[i];
  if (!coord) return null;
  const base = player.split('|')[0];
  const name = shortenName(base.replace(/\s*\(.*\)$/, ''));
  const pos  = (base.match(/\(([^)]+)\)/) || [])[1] || hPosFn[i] || '';
  const color = coord.isGK ? GK_COLOR : HOME_COLOR;
  return (
    <g transform={`translate(${coord.x.toFixed(0)},${coord.y.toFixed(0)})`}>
      <circle r="16" fill={color} opacity="0.95"/>
      <text y="-22" text-anchor="middle" font-size="9.5" fill="#fff" font-family="sans-serif" font-weight="700">{name}</text>
      <text y="4" text-anchor="middle" font-size="8" fill="#fff" font-family="sans-serif" font-weight="600">{pos}</text>
    </g>
  );
})())}
          {awayPitchLineup.filter((p: string) => !p.startsWith('선발투수') && !p.includes('번 ')).slice(0,11).map((player: string, i: number) => (() => {
  const coord = aCoords[i];
  if (!coord) return null;
  const base = player.split('|')[0];
  const name = shortenName(base.replace(/\s*\(.*\)$/, ''));
  const pos  = (base.match(/\(([^)]+)\)/) || [])[1] || aPosFn[i] || '';
  const color = coord.isGK ? GK_COLOR : AWAY_COLOR;
  return (
    <g transform={`translate(${coord.x.toFixed(0)},${coord.y.toFixed(0)})`}>
      <circle r="16" fill={color} opacity="0.95"/>
      <text y="-22" text-anchor="middle" font-size="9.5" fill="#fff" font-family="sans-serif" font-weight="700">{name}</text>
      <text y="4" text-anchor="middle" font-size="8" fill="#fff" font-family="sans-serif" font-weight="600">{pos}</text>
    </g>
  );
})())}
          <text x="20" y={H_SVG-13} font-size="10" font-family="sans-serif">
            <tspan fill={GK_COLOR}>■</tspan>
            <tspan fill="rgba(255,255,255,0.8)"> GK &nbsp;&nbsp;&nbsp;</tspan>
            <tspan fill={HOME_COLOR}>■</tspan>
            <tspan fill="rgba(255,255,255,0.8)"> {translateTeam(homeTeam)} &nbsp;&nbsp;&nbsp;</tspan>
            <tspan fill={AWAY_COLOR}>■</tspan>
            <tspan fill="rgba(255,255,255,0.8)"> {translateTeam(awayTeam)}</tspan>
          </text>
        </svg>
      </div>
    </div>
  )}

  <!-- 감독 -->
  {(homeCoach.name || awayCoach.name) && (
    <div style="display:flex;align-items:center;justify-content:space-between;background:#fff;border-top:1px solid #e9ecef;padding:14px 16px;gap:12px;">
      <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
        {homeCoach.photo && (
          <img src={homeCoach.photo} alt={homeCoach.name} loading="lazy"
               style="width:32px;height:32px;border-radius:50%;object-fit:cover;background:#f1f3f5;flex-shrink:0;"
               onerror="this.style.display='none'" />
        )}
        <span style="font-weight:700;font-size:0.9rem;color:#1a1a2e;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{homeCoach.name || '-'}</span>
      </div>
      <div style="flex:0 0 auto;">
        <span style="font-size:0.8rem;font-weight:700;color:#606871;">감독</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;flex:1;min-width:0;">
        <span style="font-weight:700;font-size:0.9rem;color:#1a1a2e;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{awayCoach.name || '-'}</span>
        {awayCoach.photo && (
          <img src={awayCoach.photo} alt={awayCoach.name} loading="lazy"
               style="width:32px;height:32px;border-radius:50%;object-fit:cover;background:#f1f3f5;flex-shrink:0;"
               onerror="this.style.display='none'" />
        )}
      </div>
    </div>
  )}

  <!-- 통합 라인업 -->
  {(homeLineupItems.length > 0 || awayLineupItems.length > 0) && (() => {
  function parsePitcher(player: string) {
    const base = player.split('|')[0];
    const m = base.match(/^선발투수\s+(.+?)\s+\((\d+)-(\d+),\s*([\d.]+)\)/);
    if (m) return { name: m[1], record: `${m[2]}승 ${m[3]}패`, era: m[4] };

    // 승패 없이 ERA만 있는 경우(KBO 등): "선발투수 이름 (ERA 3.45)"
    const eraOnly = base.match(/^선발투수\s+(.+?)\s*\(ERA\s+([\d.]+)\)\s*$/);
    if (eraOnly) return { name: eraOnly[1].trim(), record: '', era: eraOnly[2] };

    return { name: base.replace(/^선발투수\s+/, '').replace(/\s+ERA\s+[\d.]+$/, ''), record: '', era: '' };
  }
  function getPosBadge(player: string) {
    const base = player.split('|')[0];
    const m = base.match(/\(([^)]+)\)$/);
    const pos = m ? m[1] : '';
    if (!pos) return { pos: '', cls: '' };
    const upper = pos.toUpperCase();
    // 농구는 "G"가 골키퍼(GK)가 아니라 가드(Guard) — 축구용 GK 라벨로 강제 치환하지 않고 그대로 표시
    if (category === 'basketball' && upper === 'G') return { pos: 'G', cls: 'pos-mf' };
    if (upper === 'G' || upper === 'GK') return { pos: 'GK', cls: 'pos-gk' };
    if (upper.startsWith('CD') || upper === 'CB' || upper === 'LB' || upper === 'RB' || upper === 'WB') return { pos, cls: 'pos-df' };
    if (upper === 'F' || upper === 'FW' || upper === 'CF' || upper === 'ST') return { pos, cls: 'pos-fw' };
    if (upper.startsWith('AM') || upper === 'CAM' || upper === 'SS') return { pos, cls: 'pos-am' };
    return { pos, cls: 'pos-mf' };
  }
  function stripPos(player: string) {
    const base = player.split('|')[0];
    return base.replace(/\s*\([^)]+\)$/, '');
  }
  // 야구 포지션(한글)을 색상 배지로 분류 - 기존 축구용 색상 팔레트 재사용
  // 포수=GK색(노랑), 내야수=DF색(초록), 외야수=MF색(파랑), 지명타자=FW색(빨강)
  function getBaseballPosClass(pos: string): string {
    if (pos === '포수') return 'pos-gk';
    if (['1루수', '2루수', '3루수', '유격수'].includes(pos)) return 'pos-df';
    if (['좌익수', '중견수', '우익수'].includes(pos)) return 'pos-mf';
    if (pos === '지명타자') return 'pos-fw';
    return 'pos-pos'; // 알 수 없는 포지션은 기존 회색 그대로
  }
  function getPhoto(player: string) {
    const parts = player.split('|');
    return parts.length > 1 ? parts[parts.length - 1] : '';
  }
  return (
    <div class="section-widget">
      <h2 class="section-widget-header sw-lineup">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#fff;vertical-align:middle;margin-right:6px;flex-shrink:0;">
          <svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <clipPath id="lh"><rect x="0" y="0" width="16" height="32"/></clipPath>
              <clipPath id="la"><rect x="16" y="0" width="16" height="32"/></clipPath>
            </defs>
            <g clip-path="url(#lh)">
              <path d="M10 3 L6 6 L2 8 L4 13 L7 12 L7 27 L25 27 L25 12 L28 13 L30 8 L26 6 L22 3 Q16 6 10 3Z" fill="#e03131"/>
            </g>
            <g clip-path="url(#la)">
              <path d="M10 3 L6 6 L2 8 L4 13 L7 12 L7 27 L25 27 L25 12 L28 13 L30 8 L26 6 L22 3 Q16 6 10 3Z" fill="#228be6"/>
            </g>
          </svg>
        </span>
        <span class="lineup-header-content"><span class="lineup-header-teams"><span class="mi-line1">{translateTeam(homeTeam)}</span> <span class="mi-line2"><span class="vs-accent">vs</span> {translateTeam(awayTeam)}</span></span> <span class="lineup-header-label">라인업</span></span>
      </h2>
      <div class="lineup-split-body">
        <div class="lineup-split-col">
          <div class="lineup-split-title lineup-split-title--home">{translateTeam(homeTeam)}</div>
          {homeLineupItems.map((player: string, idx: number) => {
  if (player.startsWith('선발투수')) {
    const { name, record, era } = parsePitcher(player);
    const pitcherPhoto = getPhoto(player);
    return (
      <div class="lineup-player-row" key={idx}>
        {pitcherPhoto
          ? <img src={pitcherPhoto} alt={name} class="lineup-player-photo" onError="this.onerror=null;this.src='/images/home-man.png';" />
          : <img src="/images/home-man.png" alt={name} class="lineup-player-photo" />
          /* : <span class="lineup-player-photo lineup-player-photo--placeholder"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"/></svg></span> */
          }
        <span class="pos-badge pos-gk">선발투수</span>
        <span class="lineup-player-name">{name} {(record || era) && <span style="color:#868e96;font-size:0.82rem;">({record ? `${record} ` : ''}평균자책점 {era})</span>}</span>
      </div>
    );
  }
  if (player.match(/^\d+번 /)) {
    const base = player.split('|')[0];
    const numMatch = base.match(/^(\d+)번 (.+?)\s*\(([^)]+)\)$/);
    const num = numMatch ? numMatch[1] : '';
    const pname = numMatch ? numMatch[2] : base.replace(/^\d+번 /, '');
    const ppos = numMatch ? numMatch[3] : '';
    const photo = getPhoto(player);
    return (
      <div class="lineup-player-row" key={idx}>
        {photo
          ? <img src={photo} alt={pname} class="lineup-player-photo" onError="this.onerror=null;this.src='/images/home-man.png';" />
          : <img src="/images/home-man.png" alt={pname} class="lineup-player-photo" />
          /* : <span class="lineup-player-photo lineup-player-photo--placeholder"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"/></svg></span> */
          }
        <span class="pos-badge pos-num">{num}번</span>
        <span class="lineup-player-name">{pname}</span>
        {ppos && <span class={`pos-badge ${getBaseballPosClass(ppos)}`}>{ppos}</span>}
      </div>
    );
  }
  const { pos, cls } = getPosBadge(player);
  const name = stripPos(player);
  const photo = getPhoto(player);
  return (
    <div class="lineup-player-row" key={idx}>
      {photo
      ? <img src={photo} alt={name} class="lineup-player-photo" onError="this.onerror=null;this.src='/images/home-man.png';" />
      : <img src="/images/home-man.png" alt={name} class="lineup-player-photo" />
      /* : <span class="lineup-player-photo lineup-player-photo--placeholder"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"/></svg></span> */
      }
      <span class="lineup-player-name">{name}</span>
      {pos && <span class={`pos-badge ${cls}`}>{pos}</span>}
    </div>
  );
})}
        </div>
        <div class="lineup-split-col">
          <div class="lineup-split-title lineup-split-title--away">{translateTeam(awayTeam)}</div>
          {awayLineupItems.map((player: string, idx: number) => {
  if (player.startsWith('선발투수')) {
    const { name, record, era } = parsePitcher(player);
    const pitcherPhoto = getPhoto(player);
    return (
      <div class="lineup-player-row" key={idx}>
        {pitcherPhoto
          ? <img src={pitcherPhoto} alt={name} class="lineup-player-photo" onError="this.onerror=null;this.src='/images/away-man.png';" />
          : <img src="/images/away-man.png" alt={name} class="lineup-player-photo" />
          /* : <span class="lineup-player-photo lineup-player-photo--placeholder"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"/></svg></span> */
          }
        <span class="pos-badge pos-gk">선발투수</span>
        <span class="lineup-player-name">{name} {(record || era) && <span style="color:#868e96;font-size:0.82rem;">({record ? `${record} ` : ''}평균자책점 {era})</span>}</span>
      </div>
    );
  }
  if (player.match(/^\d+번 /)) {
    const base = player.split('|')[0];
    const numMatch = base.match(/^(\d+)번 (.+?)\s*\(([^)]+)\)$/);
    const num = numMatch ? numMatch[1] : '';
    const pname = numMatch ? numMatch[2] : base.replace(/^\d+번 /, '');
    const ppos = numMatch ? numMatch[3] : '';
    const photo = getPhoto(player);
    return (
      <div class="lineup-player-row" key={idx}>
        {photo
          ? <img src={photo} alt={pname} class="lineup-player-photo" onError="this.onerror=null;this.src='/images/away-man.png';" />
          : <img src="/images/away-man.png" alt={pname} class="lineup-player-photo" />
          /* : <span class="lineup-player-photo lineup-player-photo--placeholder"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"/></svg></span> */
          }
        <span class="pos-badge pos-num">{num}번</span>
        <span class="lineup-player-name">{pname}</span>
        {ppos && <span class={`pos-badge ${getBaseballPosClass(ppos)}`}>{ppos}</span>}
      </div>
    );
  }
  const { pos, cls } = getPosBadge(player);
  const name = stripPos(player);
  const photo = getPhoto(player);
  return (
    <div class="lineup-player-row" key={idx}>
      {photo
      ? <img src={photo} alt={name} class="lineup-player-photo" onError="this.onerror=null;this.src='/images/away-man.png';" />
      : <img src="/images/away-man.png" alt={name} class="lineup-player-photo" />
      /* : <span class="lineup-player-photo lineup-player-photo--placeholder"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#adb5bd" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"/></svg></span> */
      }
      <span class="lineup-player-name">{name}</span>
      {pos && <span class={`pos-badge ${cls}`}>{pos}</span>}
    </div>
  );
})}
        </div>
      </div>
    </div>
  );
})()}

