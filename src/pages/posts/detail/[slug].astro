---
// src/pages/posts/detail/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { CATEGORY_MAP } from '../../../lib/categories';
import AdGrid from '../../../components/AdGrid.astro';

export async function getStaticPaths() {
  const items = await getCollection('posts');

  if (!items || items.length === 0) return [];

  return items.map((item) => ({
    params: {
      slug: String(item.data.slug || item.id)
    }
  }));
}

const { slug } = Astro.params;

const allPosts = await getCollection('posts');

/* 🔥 slug로 직접 찾기 */
const item = allPosts.find(
  (post) => (post.data.slug || post.id) === slug
);

/* 🔥 안전 처리 */
if (!item) {
  throw new Error(`게시글을 찾을 수 없음: ${slug}`);
}

const { Content } = await render(item);

/* 🔥 추가 (핵심) */
const category = item.data.category;
const categoryName = CATEGORY_MAP[category] ?? category;

/* ✅ 카드 표시용 데이터 — frontmatter 우선, 없으면 body 파싱 백업 */
const bodyText = item.body || "";

let country = item.data.country?.trim() && item.data.country !== '국가'
  ? item.data.country.trim() : '';
let league = item.data.league?.trim() && item.data.league !== '리그'
  ? item.data.league.trim() : '';
let homeTeam = item.data.homeTeam?.trim() && item.data.homeTeam !== '홈팀'
  ? item.data.homeTeam.trim() : '';
let awayTeam = item.data.awayTeam?.trim() && item.data.awayTeam !== '원정팀'
  ? item.data.awayTeam.trim() : '';
let homeLogo = item.data.homeLogo?.trim() && item.data.homeLogo !== '/images/wing-home.png'
  ? item.data.homeLogo.trim() : '';
let awayLogo = item.data.awayLogo?.trim() && item.data.awayLogo !== '/images/wing-away.png'
  ? item.data.awayLogo.trim() : '';

// body 파싱 백업 (frontmatter 값이 없을 때만)
if ((!country || !league) && bodyText) {
  const leagueRegex = /\|\s*\*\*<span[^>]*>리그<\/span>\*\*\s*\|\s*\*\*(.*?):\s*(.*?)\*\*\s*\|/;
  const m = bodyText.match(leagueRegex);
  if (m) {
    if (!country) country = m[1].trim();
    if (!league) league = m[2].trim();
  }
}

if ((!homeTeam || !awayTeam) && bodyText) {
  if (!homeTeam) {
    const m = bodyText.match(/\|\s*\*\*<span[^>]*>홈팀<\/span>\*\*\s*\|\s*<img[^>]*>\s*\*\*(.*?)\s*\(/);
    if (m) homeTeam = m[1].trim();
  }
  if (!awayTeam) {
    const m = bodyText.match(/\|\s*\*\*<span[^>]*>원정팀<\/span>\*\*\s*\|\s*<img[^>]*>\s*\*\*(.*?)\s*\(/);
    if (m) awayTeam = m[1].trim();
  }
}

if ((!homeLogo || !awayLogo) && bodyText) {
  const logoRegex = category === 'lol'
    ? /\/logos\/[a-z0-9-_]+\.png/g
    : /https:\/\/media\.api-sports\.io\/[a-z-]+\/teams\/\d+\.png/g;
  const logos = bodyText.match(logoRegex);
  if (logos && logos.length >= 2) {
    if (!homeLogo) homeLogo = logos[0];
    if (!awayLogo) awayLogo = logos[1];
  }
}

// 최종 기본값
country = country || '국가';
league = league || '리그';
homeTeam = homeTeam || '홈팀';
awayTeam = awayTeam || '원정팀';
homeLogo = homeLogo || '/images/wing-home.png';
awayLogo = awayLogo || '/images/wing-away.png';
---

<BaseLayout 
  title={`${item.data.title} - ${categoryName}`}
    description={`${item.data.title} 스포츠경기 분석글입니다. 최신 스포츠 분석 및 추천픽 제공`}
    currentCategory={category}
>
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <article class="board-card detail-view">

        <header class="detail-header">
          <div class="category-badge">{categoryName}</div>
          <h1>{item.data.title}</h1>

          <div class="post-meta">
            작성일: {new Date(item.data.date).toLocaleDateString('ko-KR')}
          </div>
        </header>

<div class="detail-content">

  <div style="margin-bottom: 20px;">
    <AdGrid type="top" />
  </div>
<!-- ✅ 경기 정보 카드 (광고 아래 고정) -->
  <div class="match-info-card" id="matchInfoCard">
    <div class="card-top">
      <span class="league-info">
        {country} [ {league} ]
      </span>
      <span class="match-time-text">
        {(() => {
          const d = new Date(item.data.date);
          const kst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
          const yy = String(kst.getUTCFullYear()).slice(-2);
          const mm = String(kst.getUTCMonth() + 1).padStart(2, '0');
          const dd = String(kst.getUTCDate()).padStart(2, '0');
          const hh = String(kst.getUTCHours()).padStart(2, '0');
          const mi = String(kst.getUTCMinutes()).padStart(2, '0');
          return `${yy}년 ${mm}월 ${dd}일 ${hh}:${mi}`;
        })()}
      </span>
    </div>
    <div class="card-center">
      <div class="team home-team">
        <span class="team-name">{homeTeam}</span>
      <img src={homeLogo} alt={homeTeam}
          class="team-logo"
          onerror="if(!this.dataset.failed){this.dataset.failed='1';this.src='/images/wing-home.png';}"
        />
      </div>
      <div class="vs-zone">VS</div>
      <div class="team away-team">
         <img src={awayLogo} alt={awayTeam}
          class="team-logo"
          onerror="if(!this.dataset.failed){this.dataset.failed='1';this.src='/images/wing-away.png';}"
        />
        <span class="team-name">{awayTeam}</span>
      </div>
    </div>
  </div>

  <div class="prose">
    <Content />
  </div>

          <div style="margin-top: 30px; padding-top: 20px; border-top: 1px dashed #eee;">
    <AdGrid type="bottom" />
  </div>
        </div>

        <footer class="detail-footer">
          <a href={`/posts/${category}`} class="back-btn">
            목록으로 돌아가기
          </a>
        </footer>

      </article>
    </main>

  </div>
</BaseLayout>

<style>

/* 레이아웃 유지 */
.main-layout-container {
  display: flex !important;
  flex-direction: row;
  gap: 30px;
  max-width: 1260px;
  margin: 20px auto;
  padding: 0 15px;
  align-items: flex-start;
  width: 100%;
}

.sidebar-area {
  width: 280px;
  flex-shrink: 0;
}

.content-area {
  flex: 1;
  min-width: 0;
  width: 100%;
}

/* 카드 */
.board-card {
  width: 100%;
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e1e4e8;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.06);
}

.detail-view {
  width: 100%;
}

/* 헤더 */
.detail-header {
  padding: 35px 35px 25px;
  border-bottom: 1px solid #eee;
}

.category-badge {
  display: inline-block;
  padding: 4px 10px;
  background: #e7f5ff;
  color: #228be6;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 15px;
}

.detail-header h1 {
  font-size: 1.7rem;
  font-weight: 800;
  line-height: 1.4;
  margin-bottom: 12px;
}

.post-meta {
  color: #868e96;
  font-size: 0.9rem;
}

/* 본문 */
.detail-content {
  padding: 20px 30px;
}

/* 본문 스타일 */
.prose {
  line-height: 1.9;
  font-size: 1.05rem;
  color: #333;
}

.prose h1,
.prose h2,
.prose h3 {
  margin-top: 2.2em;
  margin-bottom: 0.8em;
  font-weight: 700;
  line-height: 1.4;
}

.prose h2 {
  font-size: 1.5rem;
  border-left: 5px solid #4dabf7;
  padding-left: 10px;
}

.prose h3 {
  font-size: 1.25rem;
  color: #444;
}

.prose p {
  margin-bottom: 1.2em;
}

.prose ul,
.prose ol {
  margin: 1.2em 0;
  padding-left: 20px;
}

.prose li {
  margin-bottom: 6px;
}

.prose strong {
  color: #111;
  font-weight: 700;
}

.prose blockquote {
  border-left: 4px solid #4dabf7;
  background: #f8fafc;
  padding: 12px 15px;
  margin: 20px 0;
  color: #555;
}

.prose code {
  background: #f1f3f5;
  padding: 3px 6px;
  border-radius: 4px;
}

.prose img {
  max-width: 100%;
  border-radius: 10px;
  margin: 20px 0;
}

/* ✅ 경기 정보 카드 */
.match-info-card {
  border-radius: 10px;
  background: linear-gradient(135deg, #f8fafc, #eef2f7);
  border: 1.5px solid #dee2e6;
  border-bottom: 4px solid rgba(0,0,0,0.1);
  padding: 12px;
  margin-bottom: 20px;
}
.match-info-card .card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.match-info-card .league-info {
  font-size: 0.85rem;
  font-weight: 700;
  color: #2b2b2b;
}
.match-info-card .match-time-text {
  font-size: 0.8rem;
  color: #666;
}
.match-info-card .card-center {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
}
.match-info-card .team {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  min-width: 0;
}
.match-info-card .home-team { justify-content: flex-end; text-align: right; }
.match-info-card .away-team { justify-content: flex-start; text-align: left; }
.match-info-card .team-name {
  font-size: 0.95rem;
  font-weight: 800;
  color: #111;
  word-break: keep-all;
}
.match-info-card .team-logo {
  width: 31px;
  height: 31px;
  object-fit: contain;
  flex-shrink: 0;
}
.match-info-card .vs-zone {
  font-size: 1.1rem;
  font-weight: 800;
  color: #aeaeae;
  font-style: italic;
  width: 10%;
  text-align: center;
}

.prose table {
  width: 100%;
  border-collapse: collapse;
  margin: 20px 0;
}

.prose th,
.prose td {
  border: 1px solid #dee2e6;
  padding: 10px;
}

.prose th {
  background: #f1f3f5;
}

/* 하단 */
.detail-footer {
  padding: 25px;
  background: #f8fafc;
  text-align: center;
}

.back-btn {
  padding: 10px 20px;
  background: #495057;
  color: white;
  border-radius: 6px;
  text-decoration: none;
}

.back-btn:hover {
  background: #343a40;
}

/* 모바일 */
@media (max-width: 1024px) {
  .main-layout-container {
    flex-direction: column;
  }

  .detail-header h1 {
    font-size: 1.5rem;
  }
}

@media (max-width: 768px) {
  .post-header {
    padding: 20px 15px !important; /* 모바일 상단 여백 축소 */
  }
  .post-body {
    padding: 15px 10px !important; /* 모바일 본문 좌우 여백을 10px로 축소 */
  }
}

@media (max-width: 768px) {
  .detail-header {
    padding: 18px 12px !important;
  }

  .detail-content {
    padding: 12px 8px !important;
  }

  .detail-header h1 {
    font-size: 1.15rem !important;
    line-height: 1.5;
  }

  .prose {
    font-size: 0.9rem !important;
    line-height: 1.8;
  }
}
</style>

<script>
  // 🏟️ 경기 정보 요약 h3를 찾아서 카드로 교체
  document.addEventListener('DOMContentLoaded', () => {
    const prose = document.querySelector('.prose');
    if (!prose) return;

    // 🏟️ 경기 정보 요약 h3와 표 숨김
    const allH3 = prose.querySelectorAll('h3');
    allH3.forEach(h3 => {
      if (!h3.textContent.includes('🏟️')) return;

      h3.style.display = 'none';

      let next = h3.nextElementSibling;
      while (next && next.tagName !== 'H3') {
        const curr = next;
        next = next.nextElementSibling;
        if (curr.tagName === 'TABLE') {
          curr.style.display = 'none';
          break;
        }
      }
    });
  });
</script>