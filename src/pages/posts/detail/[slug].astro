---
// src/pages/posts/detail/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { CATEGORY_MAP } from '../../../lib/categories';
import AdGrid from '../../../components/AdGrid.astro';

export async function getStaticPaths() {
  const items = await getCollection('posts');

  if (!items || items.length === 0) return [];

  return items.map((item) => ({
    params: {
      slug: String(item.data.slug || item.id)
    }
  }));
}

const { slug } = Astro.params;

const allPosts = await getCollection('posts');

/* 🔥 slug로 직접 찾기 */
const item = allPosts.find(
  (post) => (post.data.slug || post.id) === slug
);

/* 🔥 안전 처리 */
if (!item) {
  throw new Error(`게시글을 찾을 수 없음: ${slug}`);
}

const { Content } = await render(item);

/* 🔥 추가 (핵심) */
const category = item.data.category;
const categoryName = CATEGORY_MAP[category] ?? category;

/* ✅ 카드 표시용 데이터 — frontmatter 우선, 없으면 body 파싱 백업 */
const bodyText = item.body || "";

let country = item.data.country?.trim() && item.data.country !== '국가'
  ? item.data.country.trim() : '';
let league = item.data.league?.trim() && item.data.league !== '리그'
  ? item.data.league.trim() : '';
let homeTeam = item.data.homeTeam?.trim() && item.data.homeTeam !== '홈팀'
  ? item.data.homeTeam.trim() : '';
let awayTeam = item.data.awayTeam?.trim() && item.data.awayTeam !== '원정팀'
  ? item.data.awayTeam.trim() : '';
let homeLogo = item.data.homeLogo?.trim() && item.data.homeLogo !== '/images/wing-home.png'
  ? item.data.homeLogo.trim() : '';
let awayLogo = item.data.awayLogo?.trim() && item.data.awayLogo !== '/images/wing-away.png'
  ? item.data.awayLogo.trim() : '';

// body 파싱 백업 (frontmatter 값이 없을 때만)
if ((!country || !league) && bodyText) {
  const leagueRegex = /\|\s*\*\*<span[^>]*>리그<\/span>\*\*\s*\|\s*\*\*(.*?):\s*(.*?)\*\*\s*\|/;
  const m = bodyText.match(leagueRegex);
  if (m) {
    if (!country) country = m[1].trim();
    if (!league) league = m[2].trim();
  }
}

if ((!homeTeam || !awayTeam) && bodyText) {
  if (!homeTeam) {
    const m = bodyText.match(/\|\s*\*\*<span[^>]*>홈팀<\/span>\*\*\s*\|\s*<img[^>]*>\s*\*\*(.*?)\s*\(/);
    if (m) homeTeam = m[1].trim();
  }
  if (!awayTeam) {
    const m = bodyText.match(/\|\s*\*\*<span[^>]*>원정팀<\/span>\*\*\s*\|\s*<img[^>]*>\s*\*\*(.*?)\s*\(/);
    if (m) awayTeam = m[1].trim();
  }
}

if ((!homeLogo || !awayLogo) && bodyText) {
  const logoRegex = category === 'lol'
    ? /\/logos\/[a-z0-9-_]+\.png/g
    : /https:\/\/media\.api-sports\.io\/[a-z-]+\/teams\/\d+\.png/g;
  const logos = bodyText.match(logoRegex);
  if (logos && logos.length >= 2) {
    if (!homeLogo) homeLogo = logos[0];
    if (!awayLogo) awayLogo = logos[1];
  }
}

// 최종 기본값
country = country || '국가';
league = league || '리그';
homeTeam = homeTeam || '홈팀';
awayTeam = awayTeam || '원정팀';
homeLogo = homeLogo || '/images/wing-home.png';
awayLogo = awayLogo || '/images/wing-away.png';

// 분석 데이터 프론트매터
const homeAnalysis   = item.data.homeAnalysis  || '';
const awayAnalysis   = item.data.awayAnalysis  || '';
const homePowerItems = (item.data.homePower || '').split('|').map((s: string) => s.trim()).filter(Boolean);
const awayPowerItems = (item.data.awayPower || '').split('|').map((s: string) => s.trim()).filter(Boolean);
const h2hItems       = (!item.data.h2h || item.data.h2h === '없음') ? [] : (item.data.h2h || '').split('|').map((s: string) => s.trim()).filter(Boolean);
const summary        = item.data.summary || '';

let homeRecentItems: any[] = [];
let awayRecentItems: any[] = [];
try { homeRecentItems = JSON.parse(item.data.homeRecent || '[]'); } catch(e) {}
try { awayRecentItems = JSON.parse(item.data.awayRecent || '[]'); } catch(e) {}

// 부상/결장자
const injuryHome = item.data.injuryHome?.trim() || '';
const injuryAway = item.data.injuryAway?.trim() || '';
const hasInjury = !!(
  (injuryHome && injuryHome !== '없음') ||
  (injuryAway && injuryAway !== '없음')
);
function parseInjury(str: string): string[] {
  if (!str || str === '없음') return [];
  const result: string[] = [];
  const cp = String.fromCharCode(41);
  const parts = str.split('|');
  for (const part of parts) {
    const trimmed = part.trim();
    if (!trimmed) continue;
    const subparts = trimmed.split(cp + ', ');
    for (let i = 0; i < subparts.length; i++) {
      const s = i < subparts.length - 1 ? subparts[i] + cp : subparts[i];
      if (s.trim()) result.push(s.trim());
    }
  }
  return result;
}
const injuryHomeItems = parseInjury(injuryHome);
const injuryAwayItems = parseInjury(injuryAway);

// 추천 픽
const pickWinTeam       = item.data.pickWinTeam?.trim()       || '';
const pickWinResult     = item.data.pickWinResult?.trim()      || '';
const pickHandicapTeam  = item.data.pickHandicapTeam?.trim()   || '';
const pickHandicapValue = item.data.pickHandicapValue?.trim()  || '';
const pickOuDirection   = item.data.pickOuDirection?.trim()    || '';
const pickOuValue       = item.data.pickOuValue?.trim()        || '';
const hasPick = !!(pickWinTeam || pickHandicapValue || pickOuValue);
---

<BaseLayout 
  title={`${item.data.title} - ${categoryName}`}
    description={`${item.data.title} 스포츠경기 분석글입니다. 최신 스포츠 분석 및 추천픽 제공`}
    currentCategory={category}
>
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <article class="board-card detail-view">

        <header class="detail-header">
          <div class="category-badge">{categoryName}</div>
          <h1>{item.data.title}</h1>

          <div class="post-meta">
            작성일: {new Date(item.data.date).toLocaleDateString('ko-KR')}
          </div>
        </header>

<div class="detail-content">

  <div style="margin-bottom: 20px;">
    <AdGrid type="top" />
  </div>
<!-- ✅ 경기 정보 카드 (광고 아래 고정) -->
  <div class="match-info-card" id="matchInfoCard">
    <div class="card-top">
      <span class="league-info">
        {country} [ {league} ]
      </span>
      <span class="match-time-text">
        {(() => {
          const d = new Date(item.data.date);
          const kst = new Date(d.getTime() + 9 * 60 * 60 * 1000);
          const yy = String(kst.getUTCFullYear()).slice(-2);
          const mm = String(kst.getUTCMonth() + 1).padStart(2, '0');
          const dd = String(kst.getUTCDate()).padStart(2, '0');
          const hh = String(kst.getUTCHours()).padStart(2, '0');
          const mi = String(kst.getUTCMinutes()).padStart(2, '0');
          return `${yy}년 ${mm}월 ${dd}일 ${hh}:${mi}`;
        })()}
      </span>
    </div>
    <div class="card-center">
      <div class="team home-team">
        <span class="team-name">{homeTeam}</span>
      <img src={homeLogo} alt={homeTeam}
          class="team-logo"
          onerror="if(!this.dataset.failed){this.dataset.failed='1';this.src='/images/wing-home.png';}"
        />
      </div>
      <div class="vs-zone">VS</div>
      <div class="team away-team">
         <img src={awayLogo} alt={awayTeam}
          class="team-logo"
          onerror="if(!this.dataset.failed){this.dataset.failed='1';this.src='/images/wing-away.png';}"
        />
        <span class="team-name">{awayTeam}</span>
      </div>
    </div>
  </div>

  <!-- 구 방식 글: homeAnalysis 없으면 본문 그대로 렌더링 -->
  {!homeAnalysis && (
    <div class="prose">
      <Content />
    </div>
  )}

  <!-- 홈팀 분석 -->
  {homeAnalysis && (
    <div class="section-widget">
      <h2 class="section-widget-header sw-home">
        {homeLogo && <img src={homeLogo} style="width:26px;height:26px;object-fit:contain;vertical-align:middle;margin-right:6px;" />}
        {homeTeam} 최근 전력 분석
      </h2>
      <div class="section-widget-body">
  {homeAnalysis.split(/(?<=\.) /).filter(Boolean).map((sentence: string, idx: number) => (
    <span>{idx > 0 && <hr class="sw-divider" />}{sentence}</span>
  ))}
</div>
    </div>
  )}

  <!-- 홈팀 최근 경기 -->
  {homeRecentItems.length > 0 && (
    <div class="section-widget">
      <h2 class="section-widget-header sw-gray">📋 {homeTeam} 최근 경기</h2>
      <div class="section-widget-body">
        {homeRecentItems.map((m: any, idx: number) => (
          <div>
            {idx > 0 && <hr class="sw-divider" />}
            <div class="recent-row">
              <span class="recent-dot"></span>
              <span>{m.date} {m.home} vs {m.away} ({m.score}) → {m.result}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- 원정팀 분석 -->
  {awayAnalysis && (
    <div class="section-widget">
      <h2 class="section-widget-header sw-away">
        {awayLogo && <img src={awayLogo} style="width:26px;height:26px;object-fit:contain;vertical-align:middle;margin-right:6px;" />}
        {awayTeam} 최근 전력 분석
      </h2>
      <div class="section-widget-body">
  {awayAnalysis.split(/(?<=\.) /).filter(Boolean).map((sentence: string, idx: number) => (
    <span>{idx > 0 && <hr class="sw-divider" />}{sentence}</span>
  ))}
</div>
    </div>
  )}

  <!-- 원정팀 최근 경기 -->
  {awayRecentItems.length > 0 && (
    <div class="section-widget">
      <h2 class="section-widget-header sw-gray">📋 {awayTeam} 최근 경기</h2>
      <div class="section-widget-body">
        {awayRecentItems.map((m: any, idx: number) => (
          <div>
            {idx > 0 && <hr class="sw-divider" />}
            <div class="recent-row">
              <span class="recent-dot"></span>
              <span>{m.date} {m.home} vs {m.away} ({m.score}) → {m.result}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

<!-- 결장/부상 현황 -->
  {hasInjury && (
    <div class="injury-widget">
      <div class="injury-header">🚑 결장/부상 현황</div>
      {injuryHomeItems.length > 0 && (
        <div class="injury-row">
          <div class="injury-team-label injury-team-label--home">{homeTeam}</div>
          <div class="injury-content">
            {injuryHomeItems.map((entry: string) => (
              <div class="injury-entry"><span class="recent-dot"></span><span>{entry}</span></div>
            ))}
          </div>
        </div>
      )}
      {injuryAwayItems.length > 0 && (
        <div class="injury-row">
          <div class="injury-team-label injury-team-label--away">{awayTeam}</div>
          <div class="injury-content">
            {injuryAwayItems.map((entry: string) => (
              <div class="injury-entry"><span class="recent-dot"></span><span>{entry}</span></div>
            ))}
          </div>
        </div>
      )}
    </div>
  )}

  <!-- 상대전적 -->
  <div class="section-widget">
    <h2 class="section-widget-header sw-h2h">⚔️ 상대 전적</h2>
    <div class="section-widget-body">
      {h2hItems.length > 0 ? h2hItems.map((row: string, idx: number) => (
        <div>
          {idx > 0 && <hr class="sw-divider" />}
          <div class="recent-row"><span class="recent-dot"></span><span>{row}</span></div>
        </div>
      )) : <span>※ 최근 공식 맞대결 정보 부족</span>}
    </div>
  </div>

  <!-- 팀별 핵심 전력 -->
  <div class="section-widget">
    <h2 class="section-widget-header sw-power">⚡ 팀별 핵심 전력 분석</h2>
    <div class="power-body" style="display:flex;background:#fff;flex-wrap:wrap;margin:0;padding:0;align-items:flex-start;">
      <div style="flex:1;min-width:240px;padding:6px 18px 14px;box-sizing:border-box;border-right:1px solid #f0f0f0;">
        <h3 class="power-title power-title--home">{homeTeam}</h3>
        <ul class="power-list">
          {homePowerItems.map((p: string) => (<li class="power-item"><span class="recent-dot"></span><span>{p}</span></li>))}
        </ul>
      </div>
      <div style="flex:1;min-width:240px;padding:6px 18px 14px;box-sizing:border-box;">
        <h3 class="power-title power-title--away">{awayTeam}</h3>
        <ul class="power-list">
          {awayPowerItems.map((p: string) => (<li class="power-item"><span class="recent-dot"></span><span>{p}</span></li>))}
        </ul>
      </div>
    </div>
  </div>

  <!-- 종합 분석 -->
  {summary && (
    <div class="section-widget">
      <h2 class="section-widget-header sw-summary">📝 종합 분석</h2>
      <div class="section-widget-body">
  {summary.split(/(?<=\.) /).filter(Boolean).map((sentence: string, idx: number) => (
    <span>{idx > 0 && <hr class="sw-divider" />}{sentence}</span>
  ))}
</div>
    </div>
  )}

  <!-- 추천 픽 -->
  {hasPick && (
    <div class="section-widget">
      <h2 class="section-widget-header" style="background:#2f9e44;background-image:linear-gradient(180deg,#2f9e44 0%,#0ca678 100%);">🎯 추천 픽</h2>
      <div style="background:#fff;">
        <div style="display:flex;align-items:center;padding:14px 18px;border-bottom:1px solid #f0f0f0;">
          <div style="width:38px;height:38px;border-radius:50%;background:#2f9e44;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          </div>
          <div style="margin-left:14px;flex:1;">
            <div style="font-size:0.72rem;color:#868e96;font-weight:600;letter-spacing:0.5px;">승무패</div>
            <div style="font-size:0.92rem;color:#222;font-weight:700;margin-top:3px;">{pickWinTeam}</div>
          </div>
          <div style="font-size:1.15rem;font-weight:800;color:#2f9e44;">{pickWinResult}</div>
        </div>
        <div style="display:flex;align-items:center;padding:14px 18px;border-bottom:1px solid #f0f0f0;">
          <div style="width:38px;height:38px;border-radius:50%;background:#1971c2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <div style="margin-left:14px;flex:1;">
            <div style="font-size:0.72rem;color:#868e96;font-weight:600;letter-spacing:0.5px;">핸디캡</div>
            <div style="font-size:0.92rem;color:#222;font-weight:700;margin-top:3px;">{pickHandicapTeam}</div>
          </div>
          <div style="font-size:1.15rem;font-weight:800;color:#1971c2;">{pickHandicapValue}</div>
        </div>
        <div style="display:flex;align-items:center;padding:14px 18px;">
          <div style="width:38px;height:38px;border-radius:50%;background:#e67700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <div style="margin-left:14px;flex:1;">
            <div style="font-size:0.72rem;color:#868e96;font-weight:600;letter-spacing:0.5px;">O/U</div>
            <div style="font-size:0.92rem;color:#222;font-weight:700;margin-top:3px;">{pickOuDirection}</div>
          </div>
          <div style="font-size:1.15rem;font-weight:800;color:#e67700;">{pickOuValue}</div>
        </div>
      </div>
    </div>
  )}

          <div style="margin-top: 30px; padding-top: 20px; border-top: 1px dashed #eee;">
    <AdGrid type="bottom" />
  </div>
        </div>

        <footer class="detail-footer">
          <a href={`/posts/${category}`} class="back-btn">
            목록으로 돌아가기
          </a>
        </footer>

      </article>
    </main>

  </div>
</BaseLayout>

<style>

/* 레이아웃 유지 */
.main-layout-container {
  display: flex !important;
  flex-direction: row;
  gap: 30px;
  max-width: 1260px;
  margin: 20px auto;
  padding: 0 15px;
  align-items: flex-start;
  width: 100%;
}

.sidebar-area {
  width: 280px;
  flex-shrink: 0;
}

.content-area {
  flex: 1;
  min-width: 0;
  width: 100%;
}

/* 카드 */
.board-card {
  width: 100%;
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e1e4e8;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.06);
}

.detail-view {
  width: 100%;
}

/* 헤더 */
.detail-header {
  padding: 35px 35px 25px;
  border-bottom: 1px solid #eee;
}

.category-badge {
  display: inline-block;
  padding: 4px 10px;
  background: #e7f5ff;
  color: #228be6;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 15px;
}

.detail-header h1 {
  font-size: 1.7rem;
  font-weight: 800;
  line-height: 1.4;
  margin-bottom: 12px;
}

.post-meta {
  color: #868e96;
  font-size: 0.9rem;
}

/* 본문 */
.detail-content {
  padding: 20px 30px;
}

/* 본문 스타일 */
.prose {
  line-height: 1.9;
  font-size: 1.05rem;
  color: #333;
}

.prose h1,
.prose h2,
.prose h3 {
  margin-top: 2.2em;
  margin-bottom: 0.8em;
  font-weight: 700;
  line-height: 1.4;
}

.prose h2 {
  font-size: 1.5rem;
  border-left: 5px solid #4dabf7;
  padding-left: 10px;
}

.prose h3 {
  font-size: 1.25rem;
  color: #444;
}

.prose p {
  margin-bottom: 1.2em;
}

.prose ul,
.prose ol {
  margin: 1.2em 0;
  padding-left: 20px;
}

.prose li {
  margin-bottom: 6px;
}

.prose strong {
  color: #111;
  font-weight: 700;
}

.prose blockquote {
  border-left: 4px solid #4dabf7;
  background: #f8fafc;
  padding: 12px 15px;
  margin: 20px 0;
  color: #555;
}

.prose code {
  background: #f1f3f5;
  padding: 3px 6px;
  border-radius: 4px;
}

.prose img {
  max-width: 100%;
  border-radius: 10px;
  margin: 20px 0;
}

/* ✅ 경기 정보 카드 */
.match-info-card {
  border-radius: 10px;
  background: linear-gradient(135deg, #f8fafc, #eef2f7);
  border: 1.5px solid #dee2e6;
  border-bottom: 4px solid rgba(0,0,0,0.1);
  padding: 12px;
  margin-bottom: 20px;
}
.match-info-card .card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.match-info-card .league-info {
  font-size: 0.85rem;
  font-weight: 700;
  color: #2b2b2b;
}
.match-info-card .match-time-text {
  font-size: 0.8rem;
  color: #666;
}
.match-info-card .card-center {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
}
.match-info-card .team {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  min-width: 0;
}
.match-info-card .home-team { justify-content: flex-end; text-align: right; }
.match-info-card .away-team { justify-content: flex-start; text-align: left; }
.match-info-card .team-name {
  font-size: 1.2rem;       /* 0.95rem → 1.2rem */
  font-weight: 800;
  color: #111;
  word-break: keep-all;
}
.match-info-card .team-logo {
  width: 48px;             /* 31px → 48px */
  height: 48px;            /* 31px → 48px */
  object-fit: contain;
  flex-shrink: 0;
}
.match-info-card .vs-zone {
  font-size: 1.3rem;       /* 1.1rem → 1.3rem */
