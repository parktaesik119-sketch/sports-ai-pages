          </div>
          <div style="font-size:1.15rem;font-weight:800;color:#e67700;">{pickOuValue}</div>
        </div>
        ) : null}
      </div>
    </div>
  )}

          <div style="margin-top: 30px; padding-top: 20px; border-top: 1px dashed #eee;">
    <AdGrid type="bottom" />
  </div>
        </div>

        <footer class="detail-footer">
