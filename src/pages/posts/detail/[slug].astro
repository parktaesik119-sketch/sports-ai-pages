---
// src/pages/posts/detail/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { CATEGORY_MAP } from '../../../lib/categories';
import AdGrid from '../../../components/AdGrid.astro';

export async function getStaticPaths() {
  const items = await getCollection('posts');

  if (!items || items.length === 0) return [];

  return items.map((item) => ({
    params: {
      slug: String(item.data.slug || item.id)
    }
  }));
}

const { slug } = Astro.params;

const allPosts = await getCollection('posts');

/* 🔥 slug로 직접 찾기 */
const item = allPosts.find(
  (post) => (post.data.slug || post.id) === slug
);

/* 🔥 안전 처리 */
if (!item) {
  throw new Error(`게시글을 찾을 수 없음: ${slug}`);
}

const { Content } = await render(item);

/* 🔥 추가 (핵심) */
const category = item.data.category;
const categoryName = CATEGORY_MAP[category] ?? category;
---

<BaseLayout 
  title={`${item.data.title} - ${categoryName}`}
  /* 🔵 앞부분에 백틱(`)이 빠져있어서 에러가 났던 부분입니다 */
  description={`${item.data.title} 분석글입니다. 최신 스포츠 분석 및 추천픽 제공`}
>
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <article class="board-card detail-view">

        <header class="detail-header">
          <div class="category-badge">{categoryName}</div>
          <h1>{item.data.title}</h1>

          <div class="post-meta">
            작성일: {new Date(item.data.date).toLocaleDateString('ko-KR')}
          </div>
        </header>

        <div class="detail-content">
        <div style="margin-bottom: 20px;">
    <AdGrid type="top" />
  </div>

          <div class="prose">
            <Content />
          </div>

          <div style="margin-top: 30px; padding-top: 20px; border-top: 1px dashed #eee;">
    <AdGrid type="bottom" />
  </div>
        </div>

        <footer class="detail-footer">
          <a href={`/posts/${category}`} class="back-btn">
            목록으로 돌아가기
          </a>
        </footer>

      </article>
    </main>

  </div>
</BaseLayout>

<style>
/* 레이아웃 유지 */
.main-layout-container {
  display: flex !important;
  flex-direction: row;
  gap: 30px;
  max-width: 1260px;
  margin: 20px auto;
  padding: 0 15px;
  align-items: flex-start;
  width: 100%;
}

.sidebar-area {
  width: 280px;
  flex-shrink: 0;
}

.content-area {
  flex: 1;
  min-width: 0;
  width: 100%;
}

/* 카드 */
.board-card {
  width: 100%;
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e1e4e8;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.06);
}

.detail-view {
  width: 100%;
}

/* 헤더 */
.detail-header {
  padding: 35px 35px 25px;
  border-bottom: 1px solid #eee;
}

.category-badge {
  display: inline-block;
  padding: 4px 10px;
  background: #e7f5ff;
  color: #228be6;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 15px;
}

.detail-header h1 {
  font-size: 2rem;
  font-weight: 800;
  line-height: 1.4;
  margin-bottom: 12px;
}

.post-meta {
  color: #868e96;
  font-size: 0.9rem;
}

/* 본문 */
.detail-content {
  padding: 40px 35px;
}

/* 본문 스타일 */
.prose {
  line-height: 1.9;
  font-size: 1.08rem;
  color: #333;
}

.prose h1,
.prose h2,
.prose h3 {
  margin-top: 2.2em;
  margin-bottom: 0.8em;
  font-weight: 700;
  line-height: 1.4;
}

.prose h2 {
  font-size: 1.5rem;
  border-left: 5px solid #4dabf7;
  padding-left: 10px;
}

.prose h3 {
  font-size: 1.25rem;
  color: #444;
}

.prose p {
  margin-bottom: 1.2em;
}

.prose ul,
.prose ol {
  margin: 1.2em 0;
  padding-left: 20px;
}

.prose li {
  margin-bottom: 6px;
}

.prose strong {
  color: #111;
  font-weight: 700;
}

.prose blockquote {
  border-left: 4px solid #4dabf7;
  background: #f8fafc;
  padding: 12px 15px;
  margin: 20px 0;
  color: #555;
}

.prose code {
  background: #f1f3f5;
  padding: 3px 6px;
  border-radius: 4px;
}

.prose img {
  max-width: 100%;
  border-radius: 10px;
  margin: 20px 0;
}

.prose table {
  width: 100%;
  border-collapse: collapse;
  margin: 20px 0;
}

.prose th,
.prose td {
  border: 1px solid #dee2e6;
  padding: 10px;
}

.prose th {
  background: #f1f3f5;
}

/* 하단 */
.detail-footer {
  padding: 25px;
  background: #f8fafc;
  text-align: center;
}

.back-btn {
  padding: 10px 20px;
  background: #495057;
  color: white;
  border-radius: 6px;
  text-decoration: none;
}

.back-btn:hover {
  background: #343a40;
}

/* 모바일 */
@media (max-width: 1024px) {
  .main-layout-container {
    flex-direction: column;
  }

  .detail-header h1 {
    font-size: 1.5rem;
  }
}
</style>