  .recent-row .recent-result { margin-top: 2px; }
  .pick-score-value { min-width: 0; }

  /* 라인업 헤더: 팀명은 기본 한 줄, 공간 부족시에만 vs 기준 줄바꿈 + "라인업" 라벨 우측 고정 */
  .lineup-header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }
