---
// 📦 데이터 불러오기
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORY_MAP, CATEGORY_COLOR } from '../../lib/categories';

// 📌 URL에서 category 가져오기
const { category } = Astro.params;

// 📌 전체 게시글 가져오기
const allPosts = await getCollection('posts');

// 📌 해당 카테고리만 필터링
const filteredPosts = allPosts
  .filter((post) => post.data.category === category)
  .sort(
    (a, b) =>
      new Date(b.data.date).valueOf() -
      new Date(a.data.date).valueOf()
  );

// 📌 카테고리 이름 & 색상
const categoryName = CATEGORY_MAP[category] ?? category;
const categoryColor = CATEGORY_COLOR[category] ?? "#4dabf7";
---

<BaseLayout title={`${categoryName} - 스포츠 분석`}>
  <div class="main-layout-container">
    
    <!-- 🔵 사이드바 -->
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <!-- 🔵 본문 -->
    <main class="content-area">
      <div class={`board board-card ${category}`}>

        <!-- 🔥 여기 핵심 (색상 적용) -->
        <div 
          class="board-header"
          style={`background: ${categoryColor}`}
        >
          <h2>{categoryName}</h2>
        </div>

        <!-- 게시글 리스트 -->
        <div class="board-content">
          <ul class="post-list">
            {filteredPosts.map((post) => (
              <li class="post-item">
                <a href={`/posts/detail/${post.data.slug ?? post.id}`}>
                  <span class="title">{post.data.title}</span>
                  <span class="date">
                    {new Date(post.data.date).toLocaleDateString('ko-KR')}
                  </span>
                </a>
              </li>
            ))}
          </ul>

          {filteredPosts.length === 0 && (
            <div class="empty-msg">
              등록된 게시글이 없습니다.
            </div>
          )}
        </div>

      </div>
    </main>

  </div>
</BaseLayout>

<style>
/* =========================
   📌 레이아웃 (핵심)
========================= */
.main-layout-container {
  display: flex !important;
  flex-direction: row;
  gap: 40px;
  max-width: 1260px;
  margin: 20px auto;
  padding: 0 15px;
  align-items: flex-start;
  width: 100%;
}

.sidebar-area {
  width: 280px;
  flex-shrink: 0;
}

.content-area {
  flex: 1;
  min-width: 0;
}

/* =========================
   📌 게시판
========================= */
.board-card {
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e1e4e8;
  overflow: hidden;
}

.board-header {
  padding: 15px 20px;
  color: #333;
}

.board-header h2 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
}

/* =========================
   📌 리스트
========================= */
.post-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.post-item {
  border-bottom: 1px solid #f1f3f5;
}

.post-item a {
  display: flex;
  justify-content: space-between;
  padding: 18px 20px;
  text-decoration: none;
  color: #333;
}

.post-item a:hover {
  background: #f8fafc;
}

.title {
  font-weight: 500;
}

.date {
  font-size: 0.85rem;
  color: #94a3b8;
}

/* =========================
   📱 모바일
========================= */
@media (max-width: 1024px) {
  .main-layout-container {
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-area {
    width: 100%;
  }

  .post-item a {
    flex-direction: column;
    gap: 5px;
  }
}
</style>