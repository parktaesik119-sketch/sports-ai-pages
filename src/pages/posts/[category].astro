---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

import { CATEGORY_MAP } from '../../lib/categories';

export async function getStaticPaths() {
  return Object.keys(CATEGORY_MAP).map((category) => ({
    params: { category }
  }));
}

const { category } = Astro.params;

const allPosts = await getCollection('posts');

const filteredPosts = allPosts
  .filter(post => post.data.category === category)
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
---

<BaseLayout title={`${CATEGORY_MAP[category]} - 스포츠 분석 사이트`}>
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <div class="board-card">
        <div class="board-header">
          <h2>{CATEGORY_MAP[category]}</h2>
        </div>
        
        <div class="board-content">
          <ul class="notice-list-full">
            {filteredPosts.map((post) => (
              <li class="notice-item-full">
                <a href={`/posts/${post.data.slug ?? post.id}`}>
                  <span class="title">{post.data.title}</span>
                  <span class="date">
                    {new Date(post.data.date).toLocaleDateString('ko-KR')}
                  </span>
                </a>
              </li>
            ))}
          </ul>

          {filteredPosts.length === 0 && (
            <div class="empty-msg">등록된 게시글이 없습니다.</div>
          )}
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
/* 🔥 공지사항과 완전히 동일 */
.main-layout-container {
  display: flex !important;
  flex-direction: row;
  gap: 40px;
  max-width: 1260px;
  margin: 20px auto;
  padding: 0 15px;
  align-items: flex-start;
  width: 100%;
}

.sidebar-area {
  width: 280px;
  flex-shrink: 0;
}

.content-area {
  flex: 1;
  min-width: 0;
}

.board-card {
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e1e4e8;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.board-header {
  background: linear-gradient(135deg, #4dabf7, #339af0);
  padding: 15px 20px;
  color: white;
}

.board-header h2 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
}

.notice-list-full {
  list-style: none;
  padding: 0;
  margin: 0;
}

.notice-item-full {
  border-bottom: 1px solid #f1f3f5;
}

.notice-item-full a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  text-decoration: none;
  color: #333;
}

.notice-item-full a:hover {
  background-color: #f8fafc;
}

.title {
  font-weight: 500;
}

.date {
  font-size: 0.85rem;
  color: #94a3b8;
}

/* 모바일 */
@media (max-width: 1024px) {
  .main-layout-container {
    flex-direction: column;
  }
  .sidebar-area {
    width: 100%;
  }
}
</style>