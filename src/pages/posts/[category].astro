---
// 📦 데이터 불러오기
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORY_MAP, CATEGORY_COLOR } from '../../lib/categories';

/* =========================
   🔥 핵심 추가 (여기!)
========================= */
export async function getStaticPaths() {
  const posts = await getCollection('posts');

  // 👉 카테고리 자동 추출
  const allCategories = ['soccer', 'baseball', 'basketball', 'volleyball', 'hockey', 'lol'];
  // 👉 카테고리 날짜기준 변수 추가
  const now = new Date();
  const todayStr = `${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`;


  return allCategories.map(cat => ({
    params: { category: cat }
  }));
}

/* ========================= */

/* 📌 URL에서 category 가져오기 */
const { category } = Astro.params;

/* 📌 전체 게시글 가져오기 */
const allPosts = await getCollection('posts');

/* 📌 해당 카테고리만 필터링 */
const filteredPosts = allPosts
  .filter((post) => post.data.category === category)
  .sort(
    (a, b) =>
      new Date(b.data.date).valueOf() -
      new Date(a.data.date).valueOf()
  );

/* 📌 카테고리 이름 & 색상 */
const categoryName = CATEGORY_MAP[category] ?? category;
const categoryColor = CATEGORY_COLOR[category] ?? "#4dabf7";

/* 🔥 추가: 현재 시간 (24시간 NEW 기준용) */
const now = new Date(); // ✅ 추가
---

<BaseLayout title={`${categoryName} - 스포츠 분석`}>
  <div class="main-layout-container" data-category={category}>
    
    <!-- 🔵 사이드바 -->
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <!-- 🔵 본문 -->
    <main class="content-area">
      <div class={`board-card`}>

        <!-- 🔥 헤더 -->
        <div 
          class="board-header"
          style={`background: ${categoryColor}`}
        >
          <h2>{categoryName}</h2>
        </div>

        <!-- 게시글 리스트 -->
        <div class="board-content">
          <ul class="post-list">
            {filteredPosts.map((post) => {
              
              /* 🔥 추가: 24시간 NEW 계산 */
              const postDate = new Date(post.data.date); // ✅ 추가
              const isNew = (now - postDate) < (24 * 60 * 60 * 1000); // ✅ 추가

              return (
                <li class="post-item">
                  <a href={`/posts/detail/${post.data.slug ?? post.id}`}>
                    <span class="title">
                      {post.data.title}
                      {isNew && <span class="new-badge">N</span>} {/* ✅ 추가 */}
                    </span>
                    <span class="date">
                      {new Date(post.data.date).toLocaleDateString('ko-KR')}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>

          {filteredPosts.length === 0 && (
            <div class="empty-msg">
              등록된 {categoryName} 글이 없습니다.
            </div>
          )}
        </div>

      </div>
    </main>

  </div>
</BaseLayout>

<style>
/* =========================
   📌 레이아웃 (기존 유지)
========================= */
.main-layout-container {
  display: flex !important;
  flex-direction: row;
  gap: 40px;
  max-width: 1260px;
  margin: 20px auto;
  padding: 0 15px;
  align-items: flex-start;
  width: 100%;

  overflow: visible;
}

.sidebar-area {
  width: 280px;
  flex-shrink: 0;
  align-self: flex-start;

  position: relative;
}

.content-area {
  flex: 1;
  min-width: 0;
}

/* =========================
   📌 게시판 및 아이콘 (핵심 추가)
========================= */
.board-card {
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e1e4e8;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.board-header {
  padding: 15px 20px;
  color: #333;
}

.board-header h2 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10px;
}

/* 아이콘 공통 설정 */
.board-header h2::before {
  content: "";
  display: inline-block;
  width: 24px;
  height: 24px;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 종목별 아이콘 주소 연결 */
/* ⚽ 축구 */
[data-category="soccer"] .board-header h2::before {
  background-image: url('/icons/soccer.png') !important;
}

/* ⚾ 야구 */
[data-category="baseball"] .board-header h2::before {
  background-image: url('/icons/baseball.png') !important;
}

/* 🏀 농구 */
[data-category="basketball"] .board-header h2::before {
  background-image: url('/icons/basketball.png') !important;
}

/* 🏐 배구 */
[data-category="volleyball"] .board-header h2::before {
  background-image: url('/icons/volleyball.png') !important;
}

/* 🏒 하키 */
[data-category="hockey"] .board-header h2::before {
  background-image: url('/icons/hockey.png') !important;
}

/* 🎮 LoL */
[data-category="lol"] .board-header h2::before {
  background-image: url('/icons/lol.png') !important;
}

/* =========================
   📌 리스트 (기존 유지)
========================= */
.post-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.post-item {
  border-bottom: 1px solid #f1f3f5;
}

.post-item a {
  display: flex;
  justify-content: space-between;
  padding: 18px 20px;
  text-decoration: none;
  color: #333;
}

.post-item a:hover {
  background: #f8fafc;
}

.title {
  font-weight: 500;
}

.date {
  font-size: 0.85rem;
  color: #94a3b8;
}

/* 🔥 추가: NEW 뱃지 */
.new-badge {
  color: red;
  font-weight: bold;
  margin-left: 6px;
}

.empty-msg {
  padding: 50px;
  text-align: center;
  color: #94a3b8;
}

/* =========================
   📱 모바일 (기존 유지)
========================= */
@media (max-width: 1024px) {
  .main-layout-container {
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-area {
    display: none; /* 모바일에서 사이드바 숨김 */
  }

  .post-item a {
    flex-direction: column;
    gap: 5px;
  }
}
</style>