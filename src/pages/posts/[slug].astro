---
// src/pages/posts/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  
  // 데이터가 없을 경우 빈 배열 반환
  if (!posts || posts.length === 0) return [];

  return posts.map((post) => {
    // slug가 누락된 경우를 대비해 id를 사용
    const slugValue = post.data.slug || post.id || "test-post";
    
    return {
      params: { slug: String(slugValue) },
      props: { post },
    };
  });
}

const { post } = Astro.props;
// 🔵 핵심 수정: post.render() 대신 render(post) 사용
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
  <article style="padding:20px; max-width: 800px; margin: 0 auto;">
    <header style="margin-bottom: 30px;">
      <h1 style="font-size: 2rem; margin-bottom: 10px;">{post.data.title}</h1>
      <p style="color:gray;">
        작성일: {new Date(post.data.date).toLocaleDateString('ko-KR')}
      </p>
    </header>
    <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;" />
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .prose {
    line-height: 1.8;
    font-size: 1.1rem;
    color: #333;
  }
</style>