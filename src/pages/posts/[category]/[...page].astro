    font-size: 0.85rem;
    color: #666;
  }

  .no-data-msg {
    text-align: center;
    padding: 50px 20px;
    color: #868e96;
    font-size: 0.95rem;
  }

  /* 🔍 하단 검색 바 */
  .pagination-section {
    padding: 20px;
    border-top: 1px solid #eee;
    display: flex;
    justify-content: center;
  }
