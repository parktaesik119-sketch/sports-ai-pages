</style>

<script>
  const input = document.getElementById("categorySearchInput");
  const btn = document.getElementById("categorySearchBtn"); 
  const dateInput = document.getElementById("dateFilterInput");
  const prevDateBtn = document.getElementById("prevDateBtn");
  const nextDateBtn = document.getElementById("nextDateBtn");
  const currentDateDisplay = document.getElementById("currentDateDisplay");
  currentDateDisplay?.addEventListener("click", () => {
  if (!dateInput) return;

  dateInput.style.pointerEvents = "auto";

  if (typeof dateInput.showPicker === "function") {
    dateInput.showPicker();
  } else {
    dateInput.click();
  }
});
  const noDataMessage = document.getElementById("noDataMessage");

  // 브라우저 클라이언트 환경에서 안전하게 KST 기준 당일 날짜 초기화
  const sysNow = new Date();
  const utcTime = sysNow.getTime() + (sysNow.getTimezoneOffset() * 60 * 1000);
  const kstTime = new Date(utcTime + (9 * 60 * 60 * 1000));
  
  let activeDate = new Date(
    kstTime.getFullYear(),
    kstTime.getMonth(),
    kstTime.getDate()
  );

  function filterListByDate() {
    // 타임존 연산 격차 없이 선택된 순수 날짜 문자열 그대로 매칭
    const year = activeDate.getFullYear();
    const month = String(activeDate.getMonth() + 1).padStart(2, '0');
    const day = String(activeDate.getDate()).padStart(2, '0');
    const targetKstStr = `${year}-${month}-${day}`;

    // 달력 원본 UI 값 동기화
    if (dateInput) dateInput.value = targetKstStr;
    
    // 상단 타이틀 텍스트 변경구조 동기화
    if (currentDateDisplay) {
      currentDateDisplay.textContent = `${activeDate.getMonth() + 1}월 ${activeDate.getDate()}일`;
    }

    const cards = document.querySelectorAll(".post-card-item");
    let visibleCount = 0;
    
    cards.forEach(card => {
      const matchDate = card.getAttribute("data-match-date");
      if (matchDate === targetKstStr) {
        card.style.display = "";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });
    
    if (noDataMessage) {
      noDataMessage.style.display = visibleCount === 0 ? "block" : "none";
    }
  }

  prevDateBtn?.addEventListener("click", () => {
    activeDate.setDate(activeDate.getDate() - 1);
    filterListByDate();
  });

  nextDateBtn?.addEventListener("click", () => {
    activeDate.setDate(activeDate.getDate() + 1);
    filterListByDate();
  });

  dateInput?.addEventListener("change", () => {
  if (!dateInput.value) return;

  activeDate = new Date(dateInput.value);
  filterListByDate();
});

  function goSearch() {
    if (!input) return;
    const value = input.value.trim();
    if (!value) return;
    const currentCategory = window.location.pathname.split('/')[2] || 'soccer'; 
    window.location.href = `/search?team=${encodeURIComponent(value)}&category=${currentCategory}`;
  }

  btn?.addEventListener("click", goSearch);
  input?.addEventListener("keydown", (e) => { if (e.key === "Enter") goSearch(); });

  // 초기 구동 시 실행
  filterListByDate();
</script>