---
// 📦 데이터 불러오기
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { CATEGORY_MAP, CATEGORY_COLOR } from '../../../lib/categories';

/* =========================
   🔥 핵심 추가 (페이징 로직)
========================= */
export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('posts');

  // 👉 카테고리 자동 추출
  const allCategories = ['soccer', 'baseball', 'basketball', 'volleyball', 'hockey', 'lol'];
  
  return allCategories.flatMap(cat => {
    const categoryPosts = allPosts
      .filter(post => post.data.category === cat)
      .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

    return paginate(categoryPosts, {
      params: { category: cat },
      pageSize: 20,
    });
  });
}

const { page } = Astro.props;
const { category } = Astro.params;

// 🔥 추가: 5개씩 끊어서 보여주기 위한 계산
const range = 5; // 한 번에 보여줄 페이지 수
const startPage = Math.floor((page.currentPage - 1) / range) * range + 1;
const endPage = Math.min(startPage + range - 1, page.lastPage);
const pageNumbers = Array.from({ length: endPage - startPage + 1 }, (_, i) => startPage + i);

// 🔥 핵심: 이전 그룹 마지막 페이지 / 다음 그룹 첫 번째 페이지 계산
const prevGroupPage = startPage - 1; // 6~10일 때 5페이지로
const nextGroupPage = endPage + 1;   // 1~5일 때 6페이지로

// URL 생성 함수 (1페이지는 기본 경로, 나머지는 숫자 경로)
const getPageHref = (num) => num === 1 ? `/posts/${category}` : `/posts/${category}/${num}`;

// 👉 카테고리 날짜기준 변수 추가
const now = new Date();
const todayStr = `${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`;

const categoryName = CATEGORY_MAP[category] || category;
const categoryColor = CATEGORY_COLOR[category] || '#4dabf7';
---


<BaseLayout
  title={`${categoryName} 분석글 - 페이지 ${page.currentPage}`}
  
/>
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <section class="board-section" data-category={category}>
        <div class="board-header" style={`border-top: 3px solid ${categoryColor}`}>
          <h2>{categoryName} 게시판</h2>
        </div>

        <ul class="post-list">
          {/* 🔥 filteredPosts.map 대신 page.data.map 사용 */}
          {page.data.map((post) => {
            const postDate = new Date(post.data.date);
            const dateStr = `${String(postDate.getMonth() + 1).padStart(2, '0')}.${String(postDate.getDate()).padStart(2, '0')}`;
            const isNew = dateStr === todayStr;
            const finalSlug = post.data.slug || post.slug;

            return (
              <li class="post-item">
                <a href={`/posts/detail/${finalSlug}`}>
                  <div class="title-group">
                    <span class="title">{post.data.title}</span>
                    {isNew && <span class="new-tag">N</span>}
                  </div>
                  <span class="date">{dateStr}</span>
                </a>
              </li>
            );
          })}
        </ul>



        {/* 🔥 추가: 페이지네이션 UI */}
        <nav class="pagination">
        <div class="category-search">
  <input
    type="text"
    id="categorySearchInput"
    placeholder="팀명 검색"
  />
  <button id="categorySearchBtn">검색</button>
</div>

  {/* 🔥 이전 버튼 */}
  {startPage > 1 ? (
    <a href={getPageHref(prevGroupPage)} class="page-btn">이전</a>
  ) : (
    <span class="page-btn disabled">이전</span>
  )}

  {/* 🔥 숫자 */}
  <div class="page-numbers">
    {pageNumbers.map((pageNum) => (
      <a href={getPageHref(pageNum)} class={page.currentPage === pageNum ? "active" : null}>
        {pageNum}
      </a>
    ))}
  </div>

  {/* 🔥 다음 버튼 */}
  {endPage < page.lastPage ? (
    <a href={getPageHref(nextGroupPage)} class="page-btn">다음</a>
  ) : (
    <span class="page-btn disabled">다음</span>
  )}

</nav>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  /* =========================
     📌 레이아웃 (본문 폭 고정 핵심)
  ========================= */
  .main-layout-container {
    display: flex;
    gap: 20px;
    max-width: 1200px;
    width: 100%;       /* 전체 너비 100% */
    margin: 20px auto;
    padding: 0 15px;
    align-items: flex-start;
  }

  .sidebar-area {
    width: 280px;
    flex-shrink: 0;
  }

  .content-area {
    flex: 1;           /* 남은 공간 무조건 꽉 채우기 */
    min-width: 0;      /* 내부 요소의 overflow 제어를 위해 필수 */
  }

  /* =========================
     📌 게시판 섹션 (기존 유지)
  ========================= */
  .board-section {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.05);
    overflow: hidden;
    width: 100%;       /* 섹션 가로폭 강제 고정 */
  }

  .board-header {
    padding: 20px;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .board-header h2 {
    margin: 0;
    font-size: 1.3rem;
    color: #333;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Pretendard', sans-serif;
    font-weight: 700;
  }

  /* 📌 아이콘 공통 */
  .board-header h2::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 28px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  /* ⚽ 축구 */
  [data-category="soccer"] .board-header h2::before {
    background-image: url('/icons/soccer.png') !important;
  }

  /* ⚾ 야구 */
  [data-category="baseball"] .board-header h2::before {
    background-image: url('/icons/baseball.png') !important;
  }

  /* 🏀 농구 */
  [data-category="basketball"] .board-header h2::before {
    background-image: url('/icons/basketball.png') !important;
  }

  /* 🏐 배구 */
  [data-category="volleyball"] .board-header h2::before {
    background-image: url('/icons/volleyball.png') !important;
  }

  /* 🏒 하키 */
  [data-category="hockey"] .board-header h2::before {
    background-image: url('/icons/hockey.png') !important;
  }

  /* 🎮 LoL */
  [data-category="lol"] .board-header h2::before {
    background-image: url('/icons/lol.png') !important;
  }

  /* =========================
     📌 리스트 (디테일 수정)
  ========================= */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item {
    border-bottom: 1px solid #f1f3f5;
  }

  .post-item a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    text-decoration: none;
    color: #333;
    width: 100%;       /* 리스트 내부 가로 꽉 채우기 */
  }

  .post-item a:hover {
    background: #f8fafc;
  }

  .title-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;           /* 날짜 영역 제외한 나머지 다 차지 */
    min-width: 0;      /* 글자 잘림 처리를 위해 필수 */
    margin-right: 3px; /* 날짜와의 최소 간격 확보 */
  }

  .title {
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .title {
      font-size: 13px; /* 모바일에서 제목 글자 크기 축소 */
    }

    .date {
      font-size: 10px;   /* 날짜 크기도 작게 */
    }

    .post-item {
      padding: 8px 0;    /* 리스트 위아래 간격을 좁게 */
      gap: 5px;          /* 제목과 날짜 사이 빈공간 축소 */
    }

    /* N 아이콘과 제목 사이의 간격을 좁히고 싶다면 추가 */
    .title-wrapper {
      gap: 2px;
    }
  }

  .new-tag {
    background: #ff5252;
    color: #fff;
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 3px;
    font-weight: bold;
    flex-shrink: 0;
  }

  .date {
    color: #999;
    font-size: 0.9rem;
    flex-shrink: 0;    /* 날짜가 밀려나거나 작아지지 않게 고정 */
    text-align: right;
  }

  /* =========================
     📌 페이지네이션 디자인 
  ========================= */
  .pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  padding: 30px 0;
  border-top: 1px solid #f1f3f5;
}

/* 숫자 */
.page-numbers {
  display: flex;
  gap: 8px;
}



/* 숫자 버튼 */
.page-numbers a {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid #dee2e6;
  border-radius: 6px;
  text-decoration: none;
  color: #495057;
  background-color: #fff;
}

.page-numbers a.active {
  background-color: #4dabf7;
  color: white;
  border-color: #4dabf7;
  font-weight: bold;
}

/* 비활성 */
.page-btn.disabled {
  color: #adb5bd;
  background: #f8f9fa;
  cursor: not-allowed;
}

  /* 🔥 이전/다음 버튼 디자인 - 한 줄에 사이좋게 절반씩 차지 */
  .page-btn {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #dee2e6;
  border-radius: 6px;
  text-decoration: none;
  color: #495057;
  font-size: 13px;
  background: #fff;

  flex: none;
}

  .page-btn.disabled {
    color: #adb5bd;
    background: #f8f9fa;
    cursor: not-allowed;
  }

  /* PC 버전: 다시 한 줄로 길게 배치 */
  @media (min-width: 768px) {
  .pagination {
    flex-direction: row; 
    gap: 20px;
  }

  /* 👉 필요 없으면 order도 지워도 됨 (지금은 단순 구조라 의미 없음) */
  .page-numbers { }

  /* 👉 버튼 크기만 유지 */
  .page-btn {
    width: 80px;
  }
}

  /* =========================
     📌 모바일 (기존 유지)
  ========================= */
  @media (max-width: 768px) {
    .main-layout-container {
      flex-direction: column;
      margin-top: 10px;
      padding: 0 10px;
    }

    .sidebar-area {
      display: none;
    }

    .board-header h2 {
      font-size: 1.15rem;
    }

    .post-item a {
      padding: 15px;
    }
  }

  /* 🔥 검색창 스타일 추가 */
.category-search {
  display: flex;
  justify-content: center;   /* 가운데 정렬 */
  gap: 6px;
  margin: 20px 0;
}

.category-search input {
  width: 220px;              /* ✅ 고정폭 */
  padding: 8px;
  border: 1px solid #ddd;
  border-radius: 6px;
}

.category-search button {
  padding: 8px 12px;
  background: #4dabf7;
  color: #fff;
  border: none;
  border-radius: 6px;
  cursor: pointer;
}
</style>

<script>
  const input = document.getElementById("categorySearchInput");
  const btn = document.getElementById("categorySearchBtn");

  function goSearch() {
    const value = input.value.trim();
    if (!value) return;

    window.location.href = `/search?team=${encodeURIComponent(value)}`;
  }

  btn?.addEventListener("click", goSearch);

  input?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      goSearch();
    }
  });
</script>