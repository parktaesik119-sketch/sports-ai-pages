---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="픽천국 - 매일 만나는 무료스포츠분석, 스포츠픽">
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <div class="board-card">
        <div class="board-header">
          <h2>전체 분석글</h2>
        </div>
        
        <div class="board-content">
          <ul class="notice-list-full">
            {sortedPosts.map((post) => (
              <li class="notice-item-full">
                <a href={`/posts/detail/${post.data.slug ?? post.id}`}>
                  <span class="title">{post.data.title}</span>
                  <span class="date">
                    {new Date(post.data.date).toLocaleDateString('ko-KR')}
                  </span>
                </a>
              </li>
            ))}
          </ul>

          {sortedPosts.length === 0 && (
            <div class="empty-msg">등록된 게시글이 없습니다.</div>
          )}
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
/* 🔥 레이아웃 (공지사항과 동일) */
.main-layout-container {
  display: flex !important;
  flex-direction: row;
  gap: 20px;
  max-width: 1230px;
  margin: 20px auto;
  padding: 0 15px;
  align-items: flex-start;
  width: 100%;
}

.sidebar-area {
  width: 280px;
  flex-shrink: 0;
}

.content-area {
  flex: 1;
  min-width: 0;
}

/* 🔥 게시판 스타일 */
.board-card {
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e1e4e8;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.board-header {
  background: linear-gradient(135deg, #4dabf7, #339af0);
  padding: 10px 20px;
  color: white;
}

.board-header h2 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
}

/* 🔥 리스트 */
.notice-list-full {
  list-style: none;
  padding: 0;
  margin: 0;
}

.notice-item-full {
  border-bottom: 1px solid #f1f3f5;
}

.notice-item-full a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  text-decoration: none;
  color: #333;
}

.notice-item-full a:hover {
  background-color: #f8fafc;
}

.title {
  font-weight: 500;
}

@media (max-width: 768px) {

  .board-header {
    padding: 8px 15px; /* 모바일에서 제목 상자를 더 슬림하게 */
  }
  
  .board-content {
    padding-top: 0px !important; /* 모바일에서 위쪽 여백 강제 제거 */
  }

    .notice-item-full a {
      padding: 12px 15px; /* 모바일에서 리스트 높이 줄임 */
    }
    .title {
      font-size: 13px; /* 글자 크기 축소 */
    }
    .date {
      font-size: 11px;
    }
  }

.date {
  font-size: 0.85rem;
  color: #94a3b8;
}

/* 🔥 모바일 */
@media (max-width: 1024px) {
  .main-layout-container {
    flex-direction: column;
  }
  .sidebar-area {
    width: 100%;
  }
}

/* 🔥 게시판 본문 컨테이너 (여백 확보의 핵심) */
.board-content {
  display: flex;
  flex-direction: column;
  min-height: 400px; /* 게시글이 없을 때 상자 높이를 넉넉히 잡습니다 */
  background-color: #fff;
}

/* 🔥 게시글이 없을 때 메시지 스타일 */
.empty-msg {
  flex: 1;                 /* 부모인 board-content의 남은 공간을 다 차지 */
  display: flex !important;
  justify-content: center; /* 가로 가운데 */
  align-items: center;     /* 세로 가운데 */
  
  padding: 60px 20px !important;
  color: #94a3b8;
  font-size: 1.1rem;
  font-weight: 500;
  text-align: center;
  
  /* 위아래 선이 필요하다면 추가 (선택 사항) */
  border-top: 1px solid #f1f3f5; 
}
</style>