---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');

const limitedPosts = allPosts
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 300);
---

<BaseLayout title="검색 결과" noindex={true}>
  <main class="search-container">
    <h2 class="search-title">🔍 검색 결과</h2>

    <div id="posts-data" data-json={JSON.stringify(limitedPosts)}></div>

    <ul class="search-list">
      </ul>

    <div class="pagination" id="pagination"></div>
  </main>
</BaseLayout>

<style is:global>
  /* 🔥 is:global을 사용하여 자바스크립트로 생성된 태그에도 스타일이 먹히게 합니다. */

  .search-container {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .search-list {
    list-style: none;
    padding: 0;
    margin: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* 카드 디자인 */
  .search-item {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #eee;
    border-radius: 12px;
    background: #fff;
    overflow: hidden; /* 영역 밖으로 나가는 것 기본 차단 */
  }

  .search-item a {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%;
    padding: 16px;
    box-sizing: border-box;
  }

  /* 🔥 글자 튀어나감 방지 및 2줄 고정 핵심 설정 */
  .search-item .title {
    font-size: 15px;
    line-height: 1.4;
    color: #333;
    
    /* 박스 너비 고정 및 뚫림 방지 */
    width: 100%;
    max-width: 100%;
    display: block;
    min-width: 0;

    /* 줄바꿈 강제 설정 */
    white-space: normal !important; 
    overflow-wrap: anywhere !important;
    word-break: break-all !important; /* 영어/숫자 길어도 무조건 줄바꿈 */

    /* 2줄 제한 및 말줄임표 처리 */
    display: -webkit-box !important;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .search-item a { padding: 12px; }
    .search-item .title { font-size: 13px; }
  }

  /* 페이지네이션 */
  .pagination {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }
  .page-btn {
    padding: 8px 14px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 13px;
    color: #333;
    background: #fff;
    text-decoration: none;
  }
  .page-btn.disabled {
    background: #f5f5f5;
    color: #aaa;
    cursor: not-allowed;
  }
</style>

<script type="module">
  const raw = document.getElementById('posts-data').dataset.json;
  const allPosts = JSON.parse(raw);

  const params = new URLSearchParams(window.location.search);
  const keyword = params.get('team') || '';
  const dateQuery = params.get('date') || '';
  const categoryQuery = params.get('category') || ''; // 🔥 종목 정보 가져오기
  const page = parseInt(params.get('page')) || 1;
  const pageSize = 10;

  // 토론토 보정 로직
  const keywords = keyword
    ? [
        keyword,
        keyword.replace(/토론토/g, 'toronto'),
        keyword.replace(/toronto/g, '토론토'),
      ]
    : [];

  const container = document.querySelector('.search-list');
  const paginationEl = document.getElementById('pagination');

  let filtered = [];
  
  // 🔥 수정: 키워드(팀명) 또는 날짜가 있을 때 필터링 수행
  if (keyword || dateQuery) {
    filtered = allPosts
      .filter(post => {
        const title = post.data.title ? post.data.title.toLowerCase() : '';
        const slug = post.data.slug || '';
        
        // 1. 팀명 키워드 매칭 여부
        const matchesKeyword = keyword ? keywords.some(k => title.includes(k)) : true;

        // 🔥 2. 종목(카테고리) 매칭 여부 추가
        const matchesCategory = categoryQuery ? post.data.category === categoryQuery : true;

        // 3. 날짜 매칭 여부 (dateQuery: "2026-05-08" -> 제목의 "26/05/08"와 비교)
        let matchesDate = true;
        if (dateQuery) {
          const [y, m, d] = dateQuery.split('-');
          const targetDateStr = `${y.substring(2)}/${m}/${d}`;
          matchesDate = title.startsWith(targetDateStr);
        }

        return slug && matchesKeyword && matchesCategory && matchesDate;
      })
      .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
  }

  const effectivePageSize = dateQuery ? filtered.length : pageSize;
  const totalPages = Math.ceil(filtered.length / effectivePageSize);
  const start = (page - 1) * effectivePageSize;
  const paged = filtered.slice(start, start + effectivePageSize);

  if (!keyword && !dateQuery) {
    container.innerHTML = '<li style="text-align:center; padding:40px 0;">검색어 또는 날짜를 선택하세요</li>';
  } else if (filtered.length === 0) {
    container.innerHTML = '<li style="text-align:center; padding:40px 0;">검색 결과가 없습니다.</li>';
  } else {
    // ❗ CSS 클래스 'title' 사용
    container.innerHTML = paged.map(post => `
      <li class="search-item">
        <a href="/posts/detail/${post.data.slug}">
          <div class="title">${post.data.title}</div>
        </a>
      </li>
    `).join('');
  }

  // 페이지네이션 렌더링
  if (keyword && filtered.length > 0) {
    paginationEl.innerHTML = `
      ${page > 1 ? `<a class="page-btn" href="?team=${keyword}&page=${page-1}">이전</a>` : `<span class="page-btn disabled">이전</span>`}
      <span style="align-self:center;">${page} / ${totalPages}</span>
      ${page < totalPages ? `<a class="page-btn" href="?team=${keyword}&page=${page+1}">다음</a>` : `<span class="page-btn disabled">다음</span>`}
    `;
  }
</script>