---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');
---

<BaseLayout title="검색 결과">
  <main style="max-width:800px; margin:40px auto;">

    <h2>🔍 검색 결과</h2>

    <!-- 🔥 안전한 데이터 전달 -->
    <div id="posts-data" data-json={JSON.stringify(allPosts)}></div>

    <ul class="search-list">
      <li class="placeholder">검색 중...</li>
    </ul>

  </main>
</BaseLayout>

<style>
.search-list {
  list-style: none;
  padding: 0;
  margin-top: 20px;
}

.search-item {
  border-bottom: 1px solid #ddd;
  padding: 12px 0;
}

.search-item a {
  text-decoration: none;
  color: inherit;
  display: block;
}

.title {
  font-size: 15px;
  line-height: 1.4;
}

.placeholder {
  color: #888;
}
</style>

<script>
  // 🔥 안정적으로 JSON 읽기
  const raw = document.getElementById('posts-data').dataset.json;
  const allPosts = JSON.parse(raw);

  const params = new URLSearchParams(window.location.search);
  const keyword = (params.get('team') || '').toLowerCase().trim();

  const keywords = keyword
    ? [
        keyword,
        keyword.replace(/토론토/g, 'toronto'),
        keyword.replace(/toronto/g, '토론토'),
      ]
    : [];

  const container = document.querySelector('.search-list');

  let filtered = [];

  if (keyword) {
    filtered = allPosts
      .filter(post => {
        const title = post.data.title.toLowerCase();
        return post.data.slug && keywords.some(k => title.includes(k));
      })
      .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
  }

  container.innerHTML = '';

  if (!keyword) {
    container.innerHTML = '<li>검색어를 입력하세요</li>';
  } else if (filtered.length === 0) {
    container.innerHTML = '<li>검색 결과 없음</li>';
  } else {
    container.innerHTML = filtered.map(post => `
      <li class="search-item">
        <a href="/posts/detail/${post.data.slug}">
          <div class="title">${post.data.title}</div>
        </a>
      </li>
    `).join('');
  }
</script>