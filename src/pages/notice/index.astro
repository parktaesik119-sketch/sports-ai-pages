---
// src/pages/notice/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const allNotices = await getCollection('notice');
const sortedNotices = allNotices.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---

<BaseLayout title="공지사항 - 스포츠 분석 사이트">
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <div class="board-card board notice">
        <div class="board-header">
          <h2>공지사항</h2>
        </div>
        
        <div class="board-content">
          <ul class="notice-list-full">
            {sortedNotices.map((notice) => (
              <li class="notice-item-full">
                <a href={`/notice/${notice.data.slug ?? notice.id}`}>
                  <span class="title">{notice.data.title}</span>
                  <span class="date">
                    {new Date(notice.data.date).toLocaleDateString('ko-KR')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          
          {sortedNotices.length === 0 && (
            <div class="empty-msg">등록된 공지사항이 없습니다.</div>
          )}
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  /* 1. 핵심 레이아웃: 가로 배치 강제 */
  .main-layout-container {
    display: flex !important; /* 가로 배치를 최우선으로 강제 */
    flex-direction: row;      /* 가로 방향 */
    gap: 20px;
    max-width: 1230px;
    margin: 20px auto;
    padding: 0 15px;
    align-items: flex-start;
    width: 100%;
  }

  .sidebar-area {
    width: 280px; /* 사이드바 너비 고정 */
    flex-shrink: 0; /* 사이드바 크기 줄어듦 방지 */
  }

  .content-area {
    flex: 1;      /* 남은 공간 전부 차지 */
    min-width: 0; /* Flex 내부 텍스트 넘침 방지 */
  }

  /* 2. 게시판 스타일 */
  .board-card {
    background: #fff;
    border-radius: 12px;
    border: 1px solid #e1e4e8;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    width: 100%;       /* 추가: 가로폭 꽉 채우기 */
    display: flex;     /* 추가: 내부 요소 정렬 */
    flex-direction: column;
  }

  .board-content {
    width: 100%;       /* 추가: 리스트 영역 가로폭 꽉 채우기 */
    padding: 0;        /* 추가: 불필요한 좌우 여백 제거 */
  }

  .board-header {
    background: linear-gradient(135deg, #4dabf7, #339af0);
    padding: 15px 20px;
    color: white;
  }

  .board-header h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
  }

  /* 3. 리스트 스타일 */
  .notice-list-full {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .notice-item-full {
    border-bottom: 1px solid #f1f3f5;
  }

  .notice-item-full a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    text-decoration: none;
    color: #333;
    width: 100%; /* 추가: 리스트 너비를 부모에 맞게 꽉 채움 */
    box-sizing: border-box; /* 추가: 패딩이 너비에 포함되도록 설정 */
  }

  .notice-item-full a:hover {
    background-color: #f8fafc;
  }

  .title {
    font-weight: 500;
    flex: 1; /* 추가: 제목이 남은 공간을 다 차지하도록 함 */
    white-space: nowrap; /* 추가: 제목이 길어도 줄바꿈 방지 */
    overflow: hidden; /* 추가: 넘치는 텍스트 숨김 */
    text-overflow: ellipsis; /* 추가: 넘치는 텍스트 ... 처리 */
    margin-right: 10px; /* 추가: 날짜와의 간격 확보 */
  }

  @media (max-width: 768px) {

   .board-header {
    padding: 8px 15px; /* 모바일에서 제목 상자를 더 슬림하게 */
  }
  
   .board-content {
    padding-top: 0px !important; /* 모바일에서 위쪽 여백 강제 제거 */
  }

    .notice-item-full a {
      padding: 12px 15px; /* 모바일에서 리스트 높이 줄임 */
    }
    .title {
      font-size: 14px; /* 글자 크기 축소 */
    }
    .date {
      font-size: 11px;
    }
  }

  .date {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  /* 4. 모바일 대응: 1024px 이하에서 세로로 변경 */
  @media (max-width: 1024px) {
    .main-layout-container {
      flex-direction: column;
      padding: 0 10px; /* 추가: 모바일 양옆 여백 조정 */
    }
    .sidebar-area {
      width: 100%;
      margin-bottom: 20px; /* 추가: 사이드바와 본문 사이 간격 */
    }
    .content-area {
      width: 100%;       /* 추가: 본문 영역 가로폭 100% 강제 */
      flex: none;        /* 추가: flex 비율 계산 무시 */
    }
  }
</style>