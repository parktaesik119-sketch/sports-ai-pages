---
// src/pages/notice/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const allNotices = await getCollection('notice');
const sortedNotices = allNotices.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---

<BaseLayout title="공지사항 - 스포츠 분석 사이트">
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <div class="board-card board notice">
        <div class="board-header">
          <h2>공지사항</h2>
        </div>
        
        <div class="board-content">
          <ul class="notice-list-full">
            {sortedNotices.map((notice) => (
              <li class="notice-item-full">
                <a href={`/notice/${notice.data.slug ?? notice.id}`}>
                  <span class="title">{notice.data.title}</span>
                  <span class="date">
                    {new Date(notice.data.date).toLocaleDateString('ko-KR')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          
          {sortedNotices.length === 0 && (
            <div class="empty-msg">등록된 공지사항이 없습니다.</div>
          )}
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  /* 1. 핵심 레이아웃: 가로 배치 강제 */
  .main-layout-container {
    display: flex !important; /* 가로 배치를 최우선으로 강제 */
    flex-direction: row;      /* 가로 방향 */
    gap: 40px;
    max-width: 1260px;
    margin: 20px auto;
    padding: 0 15px;
    align-items: flex-start;
    width: 100%;
  }

  .sidebar-area {
    width: 280px; /* 사이드바 너비 고정 */
    flex-shrink: 0; /* 사이드바 크기 줄어듦 방지 */
  }

  .content-area {
    flex: 1;      /* 남은 공간 전부 차지 */
    min-width: 0; /* Flex 내부 텍스트 넘침 방지 */
  }

  /* 2. 게시판 스타일 */
  .board-card {
    background: #fff;
    border-radius: 12px;
    border: 1px solid #e1e4e8;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  .board-header {
    background: linear-gradient(135deg, #4dabf7, #339af0);
    padding: 15px 20px;
    color: white;
  }

  .board-header h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
  }

  /* 3. 리스트 스타일 */
  .notice-list-full {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .notice-item-full {
    border-bottom: 1px solid #f1f3f5;
  }

  .notice-item-full a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    text-decoration: none;
    color: #333;
  }

  .notice-item-full a:hover {
    background-color: #f8fafc;
  }

  .title {
    font-weight: 500;
  }

  .date {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  /* 4. 모바일 대응: 1024px 이하에서 세로로 변경 */
  @media (max-width: 1024px) {
    .main-layout-container {
      flex-direction: column;
    }

    
    .sidebar-area {
      width: 100%;
    }

    @media (max-width: 768px) {
      .board-card {
        border-radius: 0 !important;  /* 모서리 둥글기 제거 */
        border-left: none !important; /* 왼쪽 테두리 제거 */
        border-right: none !important;/* 오른쪽 테두리 제거 */
        box-shadow: none !important;  /* 그림자 제거 */
      }
      
      .notice-item-full a {
        padding: 15px 15px; /* 리스트 내부 여백 미세 조정 */
      }
    }
  }
</style>