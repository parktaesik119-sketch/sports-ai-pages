---
// src/pages/schedule/[date].astro
//
// URL 예: /schedule/2026-07-04
// root/database/{date}.json 을 읽어서 ScheduleList에 그대로 넘겨줍니다.
// BaseLayout으로 감싸서 사이트 공용 헤더/메뉴 안에서 보이도록 합니다.

import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleList, { type Match } from "../../components/ScheduleList.astro";

export async function getStaticPaths() {
  const dataDir = path.resolve("./database");
  const DATE_FILE_RE = /^\d{4}-\d{2}-\d{2}\.json$/;
  const files = fs.existsSync(dataDir)
    ? fs.readdirSync(dataDir).filter((f) => DATE_FILE_RE.test(f))
    : [];

  return files.map((file) => ({ params: { date: file.replace(".json", "") } }));
}

const { date } = Astro.params;
const filePath = path.resolve(`./database/${date}.json`);

let matches: Match[] = [];
if (fs.existsSync(filePath)) {
  matches = JSON.parse(fs.readFileSync(filePath, "utf-8"));
}

function shiftDate(base: string, days: number) {
  const d = new Date(`${base}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

const prevDate = shiftDate(date!, -1);
const nextDate = shiftDate(date!, 1);
const [y, m, d] = date!.split("-");
const pageTitle = `${y}년 ${parseInt(m)}월 ${parseInt(d)}일 경기 일정 | 픽천국`;
---

<BaseLayout title={pageTitle} currentCategory="schedule">
  <ScheduleList matches={matches}>
    <Fragment slot="date-label">
      {`${y}년 ${parseInt(m)}월 ${parseInt(d)}일`}
    </Fragment>
  </ScheduleList>
</BaseLayout>

<script define:vars={{ prevDate, nextDate }}>
  document.addEventListener("astro:page-load", () => {
    document.querySelector('[data-nav="prev"]')?.addEventListener("click", () => {
      location.href = `/schedule/${prevDate}`;
    });
    document.querySelector('[data-nav="next"]')?.addEventListener("click", () => {
      location.href = `/schedule/${nextDate}`;
    });
  });
</script>