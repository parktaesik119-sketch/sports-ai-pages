---
// src/pages/schedule/[date].astro
//
// URL 예: /schedule/2026-07-04
// 중요: 날짜 파일 하나에 d-1~d+2 경기가 섞여 들어있는 구조라서,
// "파일명 = 날짜"로 취급하지 않습니다. 대신 database/ 안의 모든 파일을 읽어
// 전체 경기를 합친 뒤, 각 경기의 실제 date(KST 기준 날짜)로 걸러냅니다.
// 같은 경기(id)가 여러 파일에 겹쳐 있으면 파일명 오름차순 기준 나중 파일(더 최신 fetch) 값으로 덮어씁니다.
// BaseLayout으로 감싸서 사이트 공용 헤더/메뉴 안에서 보이도록 합니다.

import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import ScheduleList, { type Match } from "../../components/ScheduleList.astro";

// getStaticPaths는 Astro가 빌드 시 별도 청크로 분리해서 먼저 실행합니다.
// 그래서 바깥(모듈 최상단)에 선언한 함수를 참조하면 "함수가 정의되지 않음" 에러가
// 날 수 있어요 — 그래서 getStaticPaths 안에 필요한 로직을 전부 자체적으로 넣어서
// 완전히 독립적으로 동작하게 만듭니다. (아래 본문용 loadMatchesForDate와 내용은
// 같지만, 번들링 문제를 피하려고 일부러 중복시켜뒀습니다.)
export async function getStaticPaths() {
  function toKstDateString(iso: string) {
    const kst = new Date(new Date(iso).getTime() + 9 * 60 * 60 * 1000);
    return kst.toISOString().slice(0, 10);
  }

  const dataDir = path.resolve("./database");
  const DATE_FILE_RE = /^\d{4}-\d{2}-\d{2}\.json$/;
  const files = fs.existsSync(dataDir)
    ? fs.readdirSync(dataDir).filter((f) => DATE_FILE_RE.test(f)).sort()
    : [];

  const dates = new Set<string>();
  for (const file of files) {
    try {
      const json = JSON.parse(fs.readFileSync(path.join(dataDir, file), "utf-8"));
      if (Array.isArray(json)) {
        for (const m of json) dates.add(toKstDateString(m.date));
      }
    } catch {
      // 파싱 실패한 파일은 건너뜀
    }
  }

  return [...dates].map((date) => ({ params: { date } }));
}

// UTC ISO -> KST 기준 "YYYY-MM-DD" (서버 타임존과 무관하게 항상 KST로 고정)
function toKstDateString(iso: string) {
  const kst = new Date(new Date(iso).getTime() + 9 * 60 * 60 * 1000);
  return kst.toISOString().slice(0, 10);
}

// database/ 안의 모든 날짜 파일을 읽어서 id 기준으로 합친 뒤, 특정 날짜(KST)만 걸러냅니다.
// (파일명 오름차순으로 처리해서, 겹치는 id는 더 나중 파일 값이 최종 반영되도록)
function loadMatchesForDate(targetDate: string): Match[] {
  const dataDir = path.resolve("./database");
  if (!fs.existsSync(dataDir)) return [];

  const DATE_FILE_RE = /^\d{4}-\d{2}-\d{2}\.json$/;
  const files = fs.readdirSync(dataDir).filter((f) => DATE_FILE_RE.test(f)).sort();
  const byId = new Map<string, Match>();

  for (const file of files) {
    try {
      const json = JSON.parse(fs.readFileSync(path.join(dataDir, file), "utf-8"));
      if (Array.isArray(json)) {
        for (const m of json) byId.set(m.id, m);
      }
    } catch (err) {
      console.warn(`[schedule] ${file} 파싱 실패, 건너뜀:`, err);
    }
  }

  return [...byId.values()].filter((m) => toKstDateString(m.date) === targetDate);
}

const { date } = Astro.params;
const matches: Match[] = loadMatchesForDate(date!);

function shiftDate(base: string, days: number) {
  const d = new Date(`${base}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

const prevDate = shiftDate(date!, -1);
const nextDate = shiftDate(date!, 1);
const [y, m, d] = date!.split("-");
const pageTitle = `${y}년 ${parseInt(m)}월 ${parseInt(d)}일 경기 일정 | 픽천국`;
---

<BaseLayout title={pageTitle} currentCategory="schedule">
  <div class="main-layout-container">
    <div class="sidebar-area">
      <Sidebar />
    </div>

    <main class="content-area">
      <ScheduleList matches={matches}>
        <Fragment slot="date-label">
          {`${y}년 ${parseInt(m)}월 ${parseInt(d)}일`}
        </Fragment>
      </ScheduleList>
    </main>
  </div>
</BaseLayout>

<style>
/* 🔥 레이아웃 (index.astro / 축구·뉴스 게시판과 동일) */
.main-layout-container {
  display: flex !important;
  flex-direction: row;
  gap: 20px;
  max-width: 1230px;
  margin: 20px auto;
  padding: 0 15px;
  align-items: flex-start;
  width: 100%;
}

.sidebar-area {
  width: 280px;
  flex-shrink: 0;
}

.content-area {
  flex: 1;
  min-width: 0;
}

@media (max-width: 1024px) {
  .main-layout-container {
    flex-direction: column;
  }
  .sidebar-area {
    width: 100%;
  }
}
</style>

<script define:vars={{ prevDate, nextDate }}>
  function initDateNav() {
    document.querySelector('[data-nav="prev"]')?.addEventListener("click", () => {
      location.href = `/schedule/${prevDate}`;
    });
    document.querySelector('[data-nav="next"]')?.addEventListener("click", () => {
      location.href = `/schedule/${nextDate}`;
    });
  }
  document.addEventListener("astro:page-load", initDateNav);
  initDateNav();
</script>