---
// 1. 광고 데이터
const ads = [
  { id: 1, normal: "/images/ads/ad1.png", long: "/images/ads/ad1_long.png", link: "https://trp-s.com", "altText": "토토사이트제작 카지노사이트제작 전문 트리플솔루션" },
  { id: 2, normal: "/images/ads/ad00.png", long: "/images/ads/ad00_long.png", link: "https://t.me/pickheaven", "altText": "데이터기반 스포츠분석 무료 스포츠픽 제공 픽천국"  },
];

const { type } = Astro.props;
---

<div class={type ? "premium-container" : "ad-grid"} id={`ad-wrapper-${type || 'main'}`} data-type={type} style="display: none;">
  {/* filter 부분을 아래와 같이 수정하세요 */}
  {ads.map((ad) => (
    <div class="ad-item-unit" data-id={ad.id}>
      <a href={ad.link} target="_blank" rel="noopener noreferrer">
        <img 
          src={type ? ad.long : ad.normal} 
          alt={`ad${ad.id}`} 
          class="ad-img" 
        />
      </a>
    </div>
  ))}
</div>

<script is:inline define:vars={{ type }}>
  (function() {
    const container = document.getElementById(`ad-wrapper-${type || 'main'}`);
    if (!container) return;

    let items = Array.from(container.querySelectorAll('.ad-item-unit'));
    
    // 본문(type이 있는 경우)은 1~4번만 사용
    if (type) {
      items = items.filter(el => parseInt(el.dataset.id) <= 4);
    }
    
    // 📌 세션 스토리지를 사용하여 페이지 내에서 동일한 순서 공유
    const storageKey = 'ad_display_order';
    let displayOrder;

    if (type === 'top' || !type) {
      // 상단이거나 메인일 때 새로 섞고 저장
      displayOrder = items.map(el => el.dataset.id).sort(() => Math.random() - 0.5);
      if (type === 'top') sessionStorage.setItem(storageKey, JSON.stringify(displayOrder));
    } else if (type === 'bottom') {
      // 하단은 저장된 순서를 가져옴 (중복 방지 핵심)
      const saved = sessionStorage.getItem(storageKey);
      displayOrder = saved ? JSON.parse(saved) : items.map(el => el.dataset.id);
    }

    // 순서에 맞춰 필터링 및 노출
    const sortedItems = displayOrder.map(id => items.find(el => el.dataset.id === id)).filter(Boolean);
    
    let toShow = [];
    if (type === 'top') {
      // 상단 노출 로직
      if (sortedItems.length === 1) toShow = sortedItems.slice(0, 1); // 1개일 때 상단 1
      else if (sortedItems.length === 2) toShow = sortedItems.slice(0, 1); // 2개일 때 상단 1
      else if (sortedItems.length >= 3) toShow = sortedItems.slice(0, 2); // 3~4개일 때 상단 2
    } else if (type === 'bottom') {
      // 하단 노출 로직
      if (sortedItems.length === 1) toShow = []; // 1개일 때 하단 0
      else if (sortedItems.length === 2) toShow = sortedItems.slice(1, 2); // 2개일 때 하단 1
      else if (sortedItems.length === 3) toShow = sortedItems.slice(2, 3); // 3개일 때 하단 1
      else if (sortedItems.length === 4) toShow = sortedItems.slice(2, 4); // 4개일 때 하단 2
    } else {
      toShow = sortedItems; // 메인은 전체 노출
    }

    // 결과 반영
    container.innerHTML = '';
    toShow.forEach(el => container.appendChild(el));
    container.style.display = type ? 'flex' : 'grid';
  })();
</script>

<style>
.premium-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  margin: 5px 0;
  align-items: center;
}
.ad-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 5px;
}
@media (max-width: 768px) {
  .ad-grid { grid-template-columns: 1fr; }
}
.ad-item-unit { width: 100%; display: flex; justify-content: center; }
.ad-img { 
  width: 100%; 
  border-radius: 8px; 
  display: block; 
  object-fit: fill; /* 비율 무시하고 지정된 영역에 꽉 채움 */
  transition: all 0.3s ease-in-out;
}

/* ✅ 마우스 오버 시 살짝 커지는 효과 */
.ad-item-unit a:hover .ad-img {
  transform: scale(1.03); /* 2%만 살짝 커짐 */
  position: relative;
  z-index: 5;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1); /* 그림자를 살짝 넣어 입체감 부여 */
}

/* 1. 본문 long 배너 (2000x390) */
.premium-container .ad-img {
  width: 100%;
  height: auto; /* 기본값 */
  aspect-ratio: 1200 / 230;
  object-fit: fill;
  min-height: 65px; /* 이미지가 너무 작아지는 것 방지 (본문용) */
}

/* 2. 메인화면 배너 (1200x350) */
.ad-grid .ad-img {
  width: 100%;
  /* aspect-ratio가 작동하지 않는 구형 환경 대비 height 강제 지정 */
  height: 130px; /* 메인 화면 배너 높이를 고정 (적당한 높이로 조절 가능) */
  object-fit: fill; 
  border-radius: 0px;
  will-change: transform;
}

/* 모바일 대응: 가로 100%를 유지 */
@media (max-width: 768px) {
  .ad-grid { 
    grid-template-columns: 1fr; /* 1단으로 변경 */
    width: 100%;
    gap: 10px 0;
  }
  
  .ad-grid .ad-img {
    width: 100% !important; 
    height: 100px; 
    object-fit: fill; 
    border-radius: 0px;
  }
}
</style>