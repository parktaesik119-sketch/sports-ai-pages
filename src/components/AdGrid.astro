---
// 각 번호에 연결하고 싶은 실제 주소를 입력.
const adLinks = {
  1: "https://trp-s.com",
  2: "https://trp-s.com",
  3: "https://trp-s.com",
  4: "https://naver.com",
  5: "https://주소5.com",
  6: "https://주소6.com",
  7: "https://주소7.com",
  8: "https://주소8.com",
  9: "https://주소9.com",
  10: "https://t.me/pickheaven"
};

// 광고 번호 리스트 (위의 adLinks에 적은 숫자와 일치해야 합니다)
const ads = Object.keys(adLinks).map(Number);
const hasAds = ads && ads.length > 0;
---

{hasAds ? (
  <div class="ad-grid">
    {ads.map(num => (
      <div class="ad-item">
        <a href={adLinks[num]} target="_blank" rel="noopener noreferrer">
          <img 
            src={`/images/ads/ad${num}.png`} 
            alt={`제휴배너 ${num}`} 
            class="ad-img"
            onerror="this.closest('.ad-item').style.display='none'"
          />
        </a>
      </div>
    ))}
  </div>
) : null}

<style>
  .ad-grid {
    display: grid;
    /* !important를 사용하여 외부 스타일보다 우선적으로 2열을 강제합니다 */
    grid-template-columns: 1fr 1fr !important; 
    gap: 5px;
    margin-bottom: 5px;
    width: 100%;
  }

  .ad-item {
    width: 100%;
    aspect-ratio: 3 / 1;
    border-radius: 8px;
    border: 1px solid #e1e4e8;
    overflow: hidden;
    background-color: #ffffff;
  }

  .ad-img {
    width: 100%;
    height: 100%;
    /* 이미지가 배너 영역을 빈틈없이 꽉 채우도록 설정 */
    object-fit: cover; 
    display: block;
  }

  @media (max-width: 768px) {
    .ad-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>