---
// 1. 광고 데이터
const ads = [
  { id: 1, normal: "https://i.imgur.com/2TEoKN2.png", long: "https://i.imgur.com/w0edAQi.png", link: "https://trp-s.com" },
  { id: 2, normal: "https://i.imgur.com/cb1Zmw6.png", long: "https://i.imgur.com/7PrjmHJ.png", link: "https://t.me/pickheaven" },
];

const { type } = Astro.props;

// 2. 랜덤 셔플 함수 (새로고침 시마다 변함)
const shuffle = (arr) => [...arr].sort(() => Math.random() - 0.5);

let displayAds = [];

// 3. 로직 처리
if (type === 'top' || type === 'bottom') {
  // 게시글용 (long 이미지가 있는 광고만)
  const longAds = ads.filter(ad => ad && ad.long);
  
  // 📌 현재 접속 시간을 기준으로 리스트를 섞어 위/아래가 같은 결과물을 공유하게 함
  // 1초 단위로 바뀌므로 새로고침 시 위치가 바뀝니다.
  const secondSeed = Math.floor(Date.now() / 1000);
  const shuffledPool = [...longAds].sort((a, b) => {
    return (Math.sin(a.id + secondSeed) - Math.sin(b.id + secondSeed));
  }).slice(0, 4);

  const total = shuffledPool.length;

  if (type === 'top') {
    const count = total <= 2 ? 1 : 2;
    displayAds = shuffledPool.slice(0, count);
  } else if (type === 'bottom') {
    const count = total <= 2 ? 1 : 2;
    // 광고가 1개면 하단은 빈 배열, 그 외에는 나머지 슬라이스
    displayAds = total > 1 ? shuffledPool.slice(count) : [];
  }
} else {
  // 메인 화면용
  displayAds = shuffle(ads);
}

// 4. undefined 방지 필터링
displayAds = displayAds.filter(ad => ad !== undefined && ad !== null);
const hasAds = displayAds.length > 0;
---

{hasAds && (
  <div class={type ? "post-ad-container" : "main-ad-grid"}>
    {displayAds.map((ad) => (
      <div class="ad-item" key={ad.id}>
        <a href={ad.link} target="_blank" rel="noopener noreferrer">
          <img 
            src={type ? ad.long : ad.normal} 
            alt={`ad${ad.id}`}
            class="ad-img"
          />
        </a>
      </div>
    ))}
  </div>
)}

<style>
.main-ad-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 20px;
}
@media (max-width: 768px) {
  .main-ad-grid { grid-template-columns: 1fr; }
}
.post-ad-container {
  display: flex;
  flex-direction: column;
  gap: 15px;
  width: 100%;
  margin: 15px 0;
  align-items: center;
}
.ad-item { width: 100%; display: flex; justify-content: center; }
.ad-img { width: 100%; height: auto; border-radius: 8px; }
</style>