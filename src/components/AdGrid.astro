---
// 1. 광고 번호와 연결될 실제 주소 설정 (서버 영역)
const adLinks = {
  1: "https://trp-s.com",
  2: "https://t.me/pickheaven",
  3: "https://trp-s.com",
  4: "https://naver.com",
  5: "https://주소5.com",
  6: "https://주소6.com",
  7: "https://주소7.com",
  8: "https://주소8.com",
  9: "https://주소9.com",
  10: "https://t.me/pickheaven"
};

// 광고 번호 배열 생성
const ads = Object.keys(adLinks).map(Number);
const hasAds = ads && ads.length > 0;
---

{hasAds ? (
  /* id="ad-grid"를 추가하여 스크립트에서 찾을 수 있게 합니다 */
  <div class="ad-grid" id="ad-grid">
    {ads.map(num => (
      <div class="ad-item">
        <a href={adLinks[num]} target="_blank" rel="noopener noreferrer">
          <img 
            src={`/images/ads/ad${num}.png`} 
            alt={`제휴배너 ${num}`} 
            class="ad-img"
            onerror="this.closest('.ad-item').style.display='none'"
          />
        </a>
      </div>
    ))}
  </div>
) : null}

<script>
  /**
   * 브라우저에서 실행되는 스크립트입니다.
   * 페이지가 로드될 때 광고 요소들의 순서를 무작위로 섞습니다.
   */
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('ad-grid');
    if (grid) {
      // 1. 광고 아이템들을 배열로 가져옵니다.
      const items = Array.from(grid.children);
      
      // 2. 배열의 순서를 랜덤하게 섞습니다.
      items.sort(() => Math.random() - 0.5);
      
      // 3. 섞인 순서대로 그리드 안에 다시 배치합니다.
      items.forEach(item => grid.appendChild(item));
    }
  });
</script>

<style>
  .ad-grid {
    display: grid;
    /* PC와 모바일 모두 2열로 고정 */
    grid-template-columns: 1fr 1fr !important; 
    gap: 5px;
    margin-bottom: 5px;
    width: 100%;
  }

  .ad-item {
    width: 100%;
    aspect-ratio: 3 / 1;
    border-radius: 8px;
    border: 1px solid #e1e4e8;
    overflow: hidden;
    background-color: #ffffff;
  }

  .ad-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 모바일 환경(화면 너비 768px 이하) 설정 */
  @media (max-width: 768px) {
    .ad-grid {
      /* 모바일에서도 확실하게 2열로 나오도록 설정 */
      grid-template-columns: 1fr !important;
      gap: 5px;
    }
  }
</style>