---
const ads = [1, 2, 3, 4, 5, 6]; 
const hasAds = ads && ads.length > 0;
---

{hasAds ? (
  <div class="ad-grid">
    {ads.map(num => (
      <div class="ad-item">
        <a href={`/partners/ad${num}`}>
          <img 
            src={`/images/ads/ad${num}.png`} 
            alt={`제휴배너 ${num}`} 
            class="ad-img"
            onerror="this.closest('.ad-item').style.display='none'"
          />
        </a>
      </div>
    ))}
  </div>
) : null}

<style>
  .ad-grid {
    display: grid;
    /* !important를 사용하여 외부 스타일보다 우선적으로 2열을 강제합니다 */
    grid-template-columns: 1fr 1fr !important; 
    gap: 15px;
    margin-bottom: 20px;
    width: 100%;
  }

  .ad-item {
    width: 100%;
    aspect-ratio: 3 / 1;
    border-radius: 8px;
    border: 1px solid #e1e4e8;
    overflow: hidden;
    background-color: #ffffff;
  }

  .ad-img {
    width: 100%;
    height: 100%;
    /* 이미지가 배너 영역을 빈틈없이 꽉 채우도록 설정 */
    object-fit: cover; 
    display: block;
  }

  @media (max-width: 768px) {
    .ad-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>