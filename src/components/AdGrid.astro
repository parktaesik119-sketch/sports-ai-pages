---
// 1. 모든 광고 링크 설정
const adLinks = {
  1: "https://trp-s.com",
  2: "https://t.me/pickheaven",
  // 3: "https://주소3.com", // 나중에 파일 생기면 주소 추가
  // 4: "https://주소4.com",
  5: "https://주소5.com",
  6: "https://주소6.com",
  7: "https://주소7.com",
  8: "https://주소8.com",
  9: "https://주소9.com",
  10: "https://t.me/pickheaven"
};

const { type } = Astro.props; 

let displayAds = [];

if (type === 'top' || type === 'bottom') {
  // [상세 페이지 모드] ad1 ~ ad4 중 링크가 설정된 것만 추출
  const premiumIds = [1, 2, 3, 4].filter(id => adLinks[id]);
  const totalCount = premiumIds.length;

  // 🚩 무조건 먼저 랜덤하게 섞습니다. (중복 방지의 핵심)
  const shuffled = premiumIds.sort(() => Math.random() - 0.5);

  if (totalCount <= 2) {
    /**
     * Case A: 광고가 2개 이하일 때 (ad1, ad2만 있는 경우)
     * 상단(top)에서 섞인 광고를 모두 보여주고, 하단(bottom)은 비웁니다.
     */
    if (type === 'top') {
      displayAds = shuffled.map(id => ({ id, link: adLinks[id] }));
    } else {
      displayAds = []; // 하단은 표시 안 함
    }
  } else {
    /**
     * Case B: 광고가 3개 이상일 때
     * 섞인 리스트를 반으로 나눠 상/하단에 각각 배정 (중복 없음)
     */
    const half = Math.ceil(totalCount / 2);
    const targetIds = type === 'top' ? shuffled.slice(0, half) : shuffled.slice(half);
    displayAds = targetIds.map(id => ({ id, link: adLinks[id] }));
  }

} else {
  // [메인 화면 모드] 5번부터 무작위 노출
  const mainIds = Object.keys(adLinks)
    .map(Number)
    .filter(id => id >= 5)
    .sort(() => Math.random() - 0.5);

  displayAds = mainIds.map(id => ({ id, link: adLinks[id] }));
}

const hasAds = displayAds && displayAds.length > 0;
---

{hasAds ? (
  <div class={type ? "premium-container" : "ad-grid"}>
    {displayAds.map(ad => (
      <div class="ad-item">
        <a href={ad.link} target="_blank" rel="noopener noreferrer">
          <img 
            src={`/images/ads/ad${ad.id}.png`} 
            alt={`배너 ${ad.id}`} 
            class="ad-img"
            onerror="this.closest('.ad-item').style.display='none'"
          />
        </a>
      </div>
    ))}
  </div>
) : null}

<style>
  /* 상세페이지 배너 컨테이너 */
  .premium-container {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 100%;
    margin: 15px 0;
    align-items: center; /* PC에서 중앙 정렬 */
  }

  /* 메인페이지용 그리드 */
  .ad-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 20px;
  }

  .ad-item {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .ad-img {
    width: 100%; /* 모바일 기본값 */
    height: auto;
    border-radius: 8px;
    display: block;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  /* PC 버전 스타일 최적화 (사용자 설정 400px 반영) */
  @media (min-width: 1024px) {
    .premium-container .ad-item {
      max-width: 400px; /* 요청하신 400px로 고정 */
    }
    
    .premium-container .ad-img {
      width: 100%;
      height: auto;
    }
  }

  @media (max-width: 768px) {
    .premium-container {
      gap: 10px;
    }
  }
</style>