---
// ========================
// 📌 광고 데이터 (Imgur)
/// ========================
const ads = [
  {
    id: 1,
    normal: "https://i.imgur.com/2TEoKN2.png",
    long: "https://i.imgur.com/w0edAQi.png",
    link: "https://trp-s.com"
  },
  {
    id: 2,
    normal: "https://i.imgur.com/cb1Zmw6.png",
    long: "https://i.imgur.com/7PrjmHJ.png",
    link: "https://t.me/pickheaven"
  },
  // 계속 추가 가능
];

const { type } = Astro.props;
let displayAds = [];

// ========================
// 📌 랜덤 1회만 생성
// ========================
if (!Astro.locals.adShuffle) {
  const shuffle = (arr) => [...arr].sort(() => Math.random() - 0.5);
  const longAds = ads.filter(ad => ad.long);
  Astro.locals.adShuffle = shuffle(longAds).slice(0, 4);
}

const shuffled = Astro.locals.adShuffle;
const total = shuffled.length;


// ========================
// 📌 게시글 페이지
// ========================
if (type === 'top' || type === 'bottom') {

  if (total === 1) {
    displayAds = type === 'top' ? [shuffled[0]] : [];
  } 
  else if (total === 2) {
    displayAds = type === 'top' ? [shuffled[0]] : [shuffled[1]];
  } 
  else if (total === 3) {
    displayAds = type === 'top' 
      ? [shuffled[0], shuffled[1]] 
      : [shuffled[2]];
  } 
  else if (total >= 4) {
    displayAds = type === 'top' 
      ? [shuffled[0], shuffled[1]] 
      : [shuffled[2], shuffled[3]];
  }

} 
// ========================
// 📌 메인 페이지
// ========================
else {
  const shuffle = (arr) => [...arr].sort(() => Math.random() - 0.5);
  displayAds = shuffle(ads);
}

const hasAds = displayAds.length > 0;
---


{hasAds && (
  <div class={type ? "premium-container" : "ad-grid"}>
    {displayAds.map(ad => (
      <div class="ad-item">
        <a href={ad.link} target="_blank" rel="noopener noreferrer">
          <img 
            src={type ? ad.long : ad.normal}
            alt={`ad${ad.id}`}
            class="ad-img"
            onerror="this.closest('.ad-item').style.display='none'"
          />
        </a>
      </div>
    ))}
  </div>
)}

<style>
/* 게시글 */
.premium-container {
  display: flex;
  flex-direction: column;
  gap: 15px;
  width: 100%;
  margin: 15px 0;
  align-items: center;
}

/* 메인 */
.ad-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 20px;
}

/* 모바일 */
@media (max-width: 768px) {
  .ad-grid {
    grid-template-columns: 1fr;
  }
}

.ad-item {
  width: 100%;
  display: flex;
  justify-content: center;
}

.ad-img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
</style>