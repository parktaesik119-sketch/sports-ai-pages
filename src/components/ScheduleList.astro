---
// src/components/ScheduleList.astro
//
// 지금까지 확정된 설계 전부 반영:
// - 데이터 원본: root/database/YYYY-MM-DD.json (UTC), 이 컴포넌트가 받는 매치들
// - 번역/국가/국기/로고는 전부 "빌드 시점(이 frontmatter, Node)"에 미리 계산해서
//   이미 완성된 문자열/경로만 클라이언트로 내려보냄 (사전 파일 자체는 브라우저로 안 감)
// - 시간은 항상 KST 고정
// - 정렬: 예정/시작·종료 2블록, 둘 다 오름차순(과거→미래)
// - 국가+리그명은 바로 위 행과 같으면 생략
// - LoL은 로컬 로고(data/i18n/team-additions/lol-logos.js) 우선 → 없으면 API 로고 →
//   그것도 없으면 홈/원정 각각 다른 기본 이미지
// - 종목 필터(전체+6종목), 무한 스크롤(스피너 없이 이미 가진 데이터를 나눠서 렌더링)
//
// 주의: 경기 목록은 클라이언트 JS가 innerHTML로 나중에 그려 넣기 때문에,
// Astro의 기본 scoped style로는 스타일이 안 먹습니다. 그래서 아래 <style>은
// is:global로 두고, 대신 클래스 충돌을 막기 위해 전부 sched- 접두사를 붙였습니다.

import MERGED_TEAM_NAME_MAP from "../../data/i18n/team-additions/index.js";
import LOL_LOGO_MAP from "../../data/i18n/team-additions/lol-logos.js";
import { translateLeagueName } from "../../data/i18n/league-name-map.js";
import { getCountryName, getFlagCode } from "../../data/i18n/country-lookup.js";

export interface Match {
  id: string;
  sport: string;
  country?: string | null;
  league: string;
  date: string; // ISO, UTC
  home: string;
  away: string;
  homeLogo?: string | null;
  awayLogo?: string | null;
}

export interface Props {
  matches: Match[];
}

const { matches } = Astro.props;

const FALLBACK_HOME_LOGO = "/icon/wing3-home.png";
const FALLBACK_AWAY_LOGO = "/icon/wing3-away.png";
const FALLBACK_FLAG = "/assets/fallback/flag.svg";

function resolveLogo(match: Match, side: "home" | "away") {
  const teamName = match[side];
  const apiLogo = side === "home" ? match.homeLogo : match.awayLogo;

  if (match.sport === "lol") {
    const localFile = LOL_LOGO_MAP[teamName];
    if (localFile) return `/logos/${localFile}`;
  }
  if (apiLogo) return apiLogo;
  return side === "home" ? FALLBACK_HOME_LOGO : FALLBACK_AWAY_LOGO;
}

// UTC ISO -> KST("HH:mm") 문자열로, 서버 타임존과 무관하게 항상 KST 고정 변환
function formatKST(iso: string) {
  const utcMs = new Date(iso).getTime();
  const kst = new Date(utcMs + 9 * 60 * 60 * 1000);
  const hh = String(kst.getUTCHours()).padStart(2, "0");
  const mm = String(kst.getUTCMinutes()).padStart(2, "0");
  return `${hh}:${mm}`;
}

const enriched = matches.map((m) => {
  const countryName = getCountryName(m.country ?? null);
  const flagCode = getFlagCode(m.country ?? null);
  return {
    id: m.id,
    sport: m.sport,
    timestamp: new Date(m.date).getTime(),
    timeLabel: formatKST(m.date),
    countryName, // null 가능 (country 필드 자체가 없는 경우, 예: 일부 e스포츠)
    flagCode, // null 가능 (country는 있지만 실제 국기가 없는 값, 예: World/대륙명)
    league: translateLeagueName(m.league),
    home: MERGED_TEAM_NAME_MAP[m.home] ?? m.home,
    away: MERGED_TEAM_NAME_MAP[m.away] ?? m.away,
    homeLogo: resolveLogo(m, "home"),
    awayLogo: resolveLogo(m, "away"),
  };
});

const SPORTS = [
  { key: "all", label: "전체" },
  { key: "soccer", label: "축구" },
  { key: "baseball", label: "야구" },
  { key: "basketball", label: "농구" },
  { key: "volleyball", label: "배구" },
  { key: "hockey", label: "하키" },
  { key: "lol", label: "LoL" },
];
---

<!--
  flag-icons 라이브러리 필요: `npm install flag-icons` 하신 뒤
  레이아웃(BaseLayout.astro) 한 곳에서
  `import "flag-icons/css/flag-icons.min.css";` 한 번만 넣어주세요.
-->

<div
  class="sched-root"
  data-matches={JSON.stringify(enriched)}
>
  <svg width="0" height="0" style="position:absolute;" aria-hidden="true">
    <defs>
      <symbol id="ic-soccer" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9.3" fill="none" stroke="currentColor" stroke-width="1.3"/>
        <path d="M12 7.2 L15.2 9.5 L14 13.3 L10 13.3 L8.8 9.5 Z" fill="currentColor"/>
      </symbol>
      <symbol id="ic-baseball" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9.3" fill="none" stroke="currentColor" stroke-width="1.3"/>
        <path d="M6.5 6.8 C9 9 9 15 6.5 17.2" fill="none" stroke="currentColor" stroke-width="1.1"/>
        <path d="M17.5 6.8 C15 9 15 15 17.5 17.2" fill="none" stroke="currentColor" stroke-width="1.1"/>
      </symbol>
      <symbol id="ic-basketball" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9.3" fill="none" stroke="currentColor" stroke-width="1.3"/>
        <path d="M12 2.7 V21.3 M2.7 12 H21.3 M4.8 5.5 C8 9 8 15 4.8 18.5 M19.2 5.5 C16 9 16 15 19.2 18.5" fill="none" stroke="currentColor" stroke-width="1"/>
      </symbol>
      <symbol id="ic-volleyball" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9.3" fill="none" stroke="currentColor" stroke-width="1.3"/>
        <path d="M12 2.7 C16 6 16 11 12 12 M2.9 10 C8 10.5 10.5 13.5 10 18.8 M21.1 14 C16 13.5 13 10.8 13.5 5.5" fill="none" stroke="currentColor" stroke-width="1"/>
      </symbol>
      <symbol id="ic-hockey" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9.3" stroke="currentColor" stroke-width="1.3" fill="none"/>
        <path d="M16.8 6.3 L9.6 14.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        <path d="M9.6 14.6 L7 17.5 C6.55 18 6.9 18.7 7.55 18.7 L10.9 18.7 C11.35 18.7 11.72 18.42 11.85 18.02 L12.65 15.7 C12.87 15.08 12.42 14.45 11.75 14.45 Z" fill="currentColor"/>
        <ellipse cx="6.1" cy="18.9" rx="1.4" ry="0.75" fill="currentColor"/>
      </symbol>
      <symbol id="ic-lol" viewBox="0 0 24 24">
        <rect x="3" y="8.5" width="18" height="8" rx="4" fill="none" stroke="currentColor" stroke-width="1.3"/>
        <path d="M8 10.8 V13.7 M6.5 12.25 H9.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        <circle cx="16" cy="11" r="1" fill="currentColor"/>
        <circle cx="18" cy="13" r="1" fill="currentColor"/>
      </symbol>
    </defs>
  </svg>

  <div class="sched-date-nav">
    <button type="button" class="sched-date-nav-btn" data-nav="prev" aria-label="이전 날짜">
      <i aria-hidden="true">‹</i>
    </button>
    <span class="sched-date-label"><slot name="date-label">오늘</slot></span>
    <button type="button" class="sched-date-nav-btn" data-nav="next" aria-label="다음 날짜">
      <i aria-hidden="true">›</i>
    </button>
  </div>

  <div class="sched-sport-pills" role="tablist">
    {SPORTS.map((s, i) => (
      <button
        type="button"
        class="sched-pill"
        data-sport={s.key}
        aria-pressed={i === 0 ? "true" : "false"}
      >
        {s.label}
      </button>
    ))}
  </div>

  <div class="sched-section" data-section="upcoming">
    <div class="sched-section-heading">
      <span class="sched-dot sched-dot-upcoming"></span>예정 경기
    </div>
    <div class="sched-match-rows" data-rows="upcoming"></div>
    <p class="sched-empty-msg" data-empty="upcoming" hidden>예정된 경기가 없습니다.</p>
    <div class="sched-sentinel" data-sentinel="upcoming"></div>
  </div>

  <div class="sched-section" data-section="started">
    <div class="sched-section-heading">
      <span class="sched-dot sched-dot-started"></span>진행중 · 종료
    </div>
    <div class="sched-match-rows sched-started" data-rows="started"></div>
    <p class="sched-empty-msg" data-empty="started" hidden>진행중이거나 종료된 경기가 없습니다.</p>
    <div class="sched-sentinel" data-sentinel="started"></div>
  </div>
</div>

<style is:global>
  .sched-root {
    font-family: -apple-system, BlinkMacSystemFont, "Pretendard", "Apple SD Gothic Neo", sans-serif;
    color: #1a1a1a;
  }

  .sched-date-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 14px;
  }
  .sched-date-nav-btn {
    background: none;
    border: none;
    font-size: 18px;
    color: #666;
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
  }
  .sched-date-label {
    font-size: 15px;
    font-weight: 600;
  }

  .sched-sport-pills {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid #ececec;
  }
  .sched-pill {
    flex-shrink: 0;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid #ddd;
    background: #fff;
    font-size: 13px;
    color: #555;
    cursor: pointer;
  }
  .sched-pill[aria-pressed="true"] {
    background: #1a1a1a;
    color: #fff;
    border-color: #1a1a1a;
  }

  .sched-section {
    margin-bottom: 26px;
  }
  .sched-section-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 4px;
    color: #333;
  }
  .sched-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .sched-dot-upcoming { background: #2f6fed; }
  .sched-dot-started { background: #9aa1ab; }

  .sched-match-rows.sched-started { opacity: 0.6; }

  .sched-league-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 4px 2px;
    font-size: 11px;
    color: #9aa1ab;
  }
  .sched-league-header .fi,
  .sched-flag-fallback {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .sched-flag-fallback { background-size: contain; background-repeat: no-repeat; }

  .sched-match-row {
    display: grid;
    grid-template-columns: 22px 40px 1fr 20px 1fr;
    align-items: center;
    gap: 8px;
    padding: 6px 4px;
    border-bottom: 1px solid #ececec;
    font-size: 13px;
  }
  .sched-sport-icon { width: 16px; height: 16px; color: #666; }
  .sched-time { font-size: 12px; color: #666; font-variant-numeric: tabular-nums; }
  .sched-team {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .sched-team.sched-away { justify-content: flex-end; }
  .sched-team img { width: 18px; height: 18px; object-fit: contain; flex-shrink: 0; }
  .sched-team .sched-name {
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sched-vs { text-align: center; font-size: 11px; color: #9aa1ab; font-weight: 600; }

  .sched-empty-msg { color: #9aa1ab; font-size: 13px; padding: 16px 4px; text-align: center; }
  .sched-sentinel { height: 1px; }
</style>

<script>
  interface EnrichedMatch {
    id: string;
    sport: string;
    timestamp: number;
    timeLabel: string;
    countryName: string | null;
    flagCode: string | null;
    league: string;
    home: string;
    away: string;
    homeLogo: string;
    awayLogo: string;
  }

  const BATCH_SIZE = 40;
  const RECLASSIFY_INTERVAL_MS = 60_000;
  const FALLBACK_FLAG = "/assets/fallback/flag.svg";

  const SPORT_ICON: Record<string, string> = {
    soccer: "ic-soccer",
    baseball: "ic-baseball",
    basketball: "ic-basketball",
    volleyball: "ic-volleyball",
    hockey: "ic-hockey",
    lol: "ic-lol",
  };

  function escapeHtml(str: string) {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function flagHtml(m: EnrichedMatch) {
    if (m.flagCode) {
      return `<span class="fi fi-${m.flagCode}"></span>`;
    }
    return `<span class="sched-flag-fallback" style="background-image:url('${FALLBACK_FLAG}')"></span>`;
  }

  function leagueHeaderKey(m: EnrichedMatch) {
    return `${m.countryName ?? ""}::${m.league}`;
  }

  function leagueHeaderHtml(m: EnrichedMatch) {
    const countryPart = m.countryName
      ? `${flagHtml(m)}<span>${escapeHtml(m.countryName)} · ${escapeHtml(m.league)}</span>`
      : `<span>${escapeHtml(m.league)}</span>`;
    return `<div class="sched-league-header">${countryPart}</div>`;
  }

  function rowHtml(m: EnrichedMatch) {
    const iconId = SPORT_ICON[m.sport] ?? "ic-soccer";
    return `
      <div class="sched-match-row">
        <svg class="sched-sport-icon"><use href="#${iconId}"/></svg>
        <span class="sched-time">${m.timeLabel}</span>
        <span class="sched-team sched-home">
          <span class="sched-name">${escapeHtml(m.home)}</span>
          <img src="${m.homeLogo}" alt="" loading="lazy" />
        </span>
        <span class="sched-vs">vs</span>
        <span class="sched-team sched-away">
          <img src="${m.awayLogo}" alt="" loading="lazy" />
          <span class="sched-name">${escapeHtml(m.away)}</span>
        </span>
      </div>`;
  }

  function renderSection(
    root: HTMLElement,
    section: "upcoming" | "started",
    list: EnrichedMatch[],
    visibleCount: number
  ) {
    const rowsEl = root.querySelector<HTMLElement>(`[data-rows="${section}"]`)!;
    const emptyEl = root.querySelector<HTMLElement>(`[data-empty="${section}"]`)!;
    const slice = list.slice(0, visibleCount);

    let lastKey = "";
    const html: string[] = [];
    for (const m of slice) {
      const key = leagueHeaderKey(m);
      if (key !== lastKey) {
        html.push(leagueHeaderHtml(m));
        lastKey = key;
      }
      html.push(rowHtml(m));
    }
    rowsEl.innerHTML = html.join("");
    emptyEl.hidden = list.length > 0;
  }

  function init() {
    const roots = document.querySelectorAll<HTMLElement>(".sched-root");

    roots.forEach((root) => {
      const all: EnrichedMatch[] = JSON.parse(root.dataset.matches ?? "[]");
      let activeSport = "all";
      const visibleCounts: Record<string, number> = { upcoming: BATCH_SIZE, started: BATCH_SIZE };

      function currentLists() {
        const now = Date.now();
        const filtered = activeSport === "all" ? all : all.filter((m) => m.sport === activeSport);
        const upcoming = filtered
          .filter((m) => m.timestamp > now)
          .sort((a, b) => a.timestamp - b.timestamp);
        const started = filtered
          .filter((m) => m.timestamp <= now)
          .sort((a, b) => a.timestamp - b.timestamp);
        return { upcoming, started };
      }

      function renderAll() {
        const { upcoming, started } = currentLists();
        renderSection(root, "upcoming", upcoming, visibleCounts.upcoming);
        renderSection(root, "started", started, visibleCounts.started);
        setupSentinel("upcoming", upcoming);
        setupSentinel("started", started);
      }

      const observers: Partial<Record<string, IntersectionObserver>> = {};

      function setupSentinel(section: "upcoming" | "started", list: EnrichedMatch[]) {
        observers[section]?.disconnect();
        if (visibleCounts[section] >= list.length) return;

        const sentinel = root.querySelector<HTMLElement>(`[data-sentinel="${section}"]`)!;
        const obs = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            visibleCounts[section] += BATCH_SIZE;
            renderAll();
          }
        });
        obs.observe(sentinel);
        observers[section] = obs;
      }

      // 종목 필터 클릭
      root.querySelectorAll<HTMLButtonElement>(".sched-pill").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeSport = btn.dataset.sport ?? "all";
          root.querySelectorAll<HTMLButtonElement>(".sched-pill").forEach((b) => {
            b.setAttribute("aria-pressed", b === btn ? "true" : "false");
          });
          visibleCounts.upcoming = BATCH_SIZE;
          visibleCounts.started = BATCH_SIZE;
          renderAll();
        });
      });

      renderAll();
      // 예정 -> 시작 전환을 반영하기 위한 주기적 재분류 (네트워크 요청 없음)
      setInterval(renderAll, RECLASSIFY_INTERVAL_MS);
    });
  }

  document.addEventListener("astro:page-load", init);
  init();
</script>